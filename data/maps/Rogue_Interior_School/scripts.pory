mapscripts Rogue_Interior_School_MapScripts {}


script Rogue_Interior_School_ShowSetRecommendation
{
    lock
    faceplayer
    
    msgbox(format("¡Anda! Tienes pinta de Entrenador.\pDeja que te aconseje cómo prepararía a tus Pokémon si fueran míos."))

    setvar(VAR_0x8004, 0)

    while(var(VAR_0x8004) != PARTY_SIZE)
    {
        specialvar(VAR_RESULT, ScriptGetPartyMonSpecies)
        showplayerpartypic(VAR_0x8004, 2, 2)
        playmoncry(VAR_RESULT, CRY_MODE_NORMAL)

        callnative(ScriptMenu_DisplayRecommendedMonSet)
        messageinstant("{DPAD_LEFTRIGHT} Cambiar de Pokémon\n{A_BUTTON} {B_BUTTON} Salir")
        waitstate
        hidemonpic
    }

    msgbox(format("Si necesitas más ayuda, ¡no dudes en preguntar!"))

    release
}

script Rogue_Interior_School_TalkRunningKid0
{
    lockall
    faceplayer

    msgbox(format("¡Pulso B dos veces para correr superrápido!\p¡También sirve para huir antes de los Pokémon salvajes!\p¡Qué rapidez!"))

    releaseall
}

script Rogue_Interior_School_TalkRunningKid1
{
    lockall
    faceplayer

    msgbox(format("¡Vuelve aquí!\n¡B B B B B B!"))

    releaseall
}

script Rogue_Interior_School_TalkRunningStatsHint
{
    lockall
    faceplayer

    msgbox(format("¡Arrgghhh!\p¡Ahora cuesta mucho más conseguir el reparto de EV perfecto!\pAntes me bastaba con entrenar contra Pokémon salvajes, pero ahora los Pokémon ganan EV tras los combates contra Entrenadores.\pEl reparto de EV depende de su Naturaleza.\p¡Así que es muy importante tener una buena Naturaleza cuanto antes si quieres un buen reparto de EV!\p¡Al menos puedes consultar tus EV e IV en cualquier momento!\pPuedes verlos pulsando {A_BUTTON} en la pantalla de características del Pokémon."))

    releaseall
}

script Rogue_Interior_School_TalkPokeblock
{
    lockall
    faceplayer

    msgbox(format("¡A mis Pokémon les encantan los {POKEBLOCK}!\p¿Sabías que en cualquier Ruta puedes esparcir {POKEBLOCK} para intentar atraer Pokémon de otros tipos?"))

    releaseall
}

script Rogue_Interior_School_TalkTeacher
{
    lockall
    faceplayer

    msgbox(format("¡Ah! ¡Bienvenid{MASC}o{FEM}a{ENDG}!\p¡Me esfuerzo por enseñar a mis Alumnos todo lo posible sobre las Aventuras!\p¡Seguro que estarán encantados de compartir lo que saben contigo si se lo pides amablemente!"))

    releaseall
}

script Rogue_Interior_School_TalkRouteHint
{
    lockall
    faceplayer


    msgbox(format("¡He estudiado todo lo que he podido sobre los distintos tipos de encuentros!\pTodavía me queda mucho por aprender.\p¡Pero puedo contarte lo que sé hasta ahora!"))

    setvar(VAR_RESULT, 0)

    while(var(VAR_RESULT) != MULTI_B_PRESSED)
    {
        begindynamicmultichoice
        appenddynamicmultichoice("Dificultad de ruta", 0)
        appenddynamicmultichoice("Tipos de ruta", 1)
        appenddynamicmultichoice("Hábitats entrenados", 2)
        appenddynamicmultichoice("Árboles de Miel", 3)

        message(format("¿Hay algo de lo que quieras que te hable?"))
        waitmessage
        enddynamicmultichoice(20, 2, 5, TRUE)
        
        switch(var(VAR_RESULT))
        {
            case 0:
                msgbox(format("¡BIEN!\nLas Rutas siempre se describen con 2 pistas.\pPrimero, una Dificultad.\nSegundo, un Tipo.\pHay 3 Dificultades: Tranquila, Normal y Dura.\pEn las Rutas Tranquilas encontrarás más Pokémon Salvajes, pero menos Objetos y Entrenadores.\pEn las Rutas Duras encontrarás pocos Pokémon Salvajes, pero más Objetos y Entrenadores.\pAdemás, los Objetos de esas rutas suelen ser más valiosos.\p¡Pero, a cambio, los Entrenadores que las recorren también suelen ser mucho más fuertes!\pLa Dificultad Normal es un término medio entre las otras 2.\p¡Suele ser una opción segura si no tienes prisa por capturar Pokémon nuevos!"))

            case 1:
                msgbox(format("¡BIEN!\nLas Rutas siempre se describen con 2 pistas.\pPrimero, una Dificultad.\nSegundo, un Tipo.\pLa pista de Tipo es muy sencilla: cada pista se refiere a un Tipo de Pokémon. Por ejemplo, Cálida se refiere al Tipo Fuego, Confusa al Tipo Psíquico, etc.\pLa pista de Tipo significa que en la Ruta aparecerá al menos 1 Pokémon de ese Tipo.\pEn las Rutas Tranquilas, además, lo normal es que haya más de 1 Pokémon de ese Tipo."))

            case 2:
                msgbox(format("¡BIEN!\n¡Los Pokémon que aparecen en estos encuentros son muy raros!\p¡Es como si ya estuvieran Entrenados para combatir!\pSuelen tener ya una buena naturaleza, habilidad y movimientos. ¡Y a menudo tienen al menos 1 IV perfecto!\pComo son tan fuertes, prefieren vivir solos, Y no hay forma de saber qué Pokémon es antes de entrar.\p¡Podría ser un Charizard!\nO un Magikarp…\pAsí que a veces es un poco una apuesta."))

            case 3:
                msgbox(format("¡BIEN!\nLos Árboles de Miel solo te serán útiles de verdad si tienes {POKEBLOCK}.\pSon lugares a los que los Pokémon Salvajes van a comer y descansar, así que casi siempre habrá algún Pokémon cerca. ¡Pero el Árbol de Miel es realmente útil cuando Esparces {POKEBLOCK} junto a él!\pCasi seguro que la próxima vez que lo visites encontrarás a un Pokémon zampándose los {POKEBLOCK} que esparciste.\pPor ejemplo, si quisiera un Bulbasaur, podría esparcir {POKEBLOCK} de Planta y Veneno junto al Árbol de Miel, ¡y la próxima vez podría haber un Bulbasaur!\pTambién podría haber un Oddish…\nO un Bellsprout…\pLa eficacia depende de lo única que sea la combinación de Tipos del Pokémon, siempre que tengas los {POKEBLOCK} necesarios."))

            case MULTI_B_PRESSED:
                msgbox(format("Ah, vale…\n¡Tengo mucho más que contar, si quieres saberlo!"))
        }
    }

    releaseall
}