script Rogue_Area_Market_TalkBerryBlender
{
    lock
    msgbox(format("Está totalmente concentrado en usar la Licuabayas."))
    release
}

script Rogue_Area_Market_TalkPokeblockHelper
{
    lock
    faceplayer
    msgbox(format("¡Tienes pinta de Entrenador!\pYo soy una especie de experto en {POKEBLOCK}.\pSi quieres, puedo enseñarte qué Bayas producen cada tipo de {POKEBLOCK}."))

    setvar(VAR_RESULT, YES)

    while(var(VAR_RESULT) == YES)
    {
        begindynamicmultichoice(32)
        special(Rogue_AppendMultichoicePokeblockItems)
        message(format("¿Qué tipo de {POKEBLOCK} te interesa?"))
        waitmessage
        enddynamicmultichoice(19, 2, 5, TRUE)

        if(var(VAR_RESULT) != MULTI_B_PRESSED)
        {
            copyvar(VAR_0x8004, VAR_RESULT)
            addvar(VAR_0x8004, FIRST_ITEM_POKEBLOCK)
            bufferitemname(STR_VAR_1, VAR_0x8004)

            begindynamicmultichoice(32)
            special(Rogue_AppendMultichoiceBerriesForPokeblock)
            message(format("Estas son las Bayas que producen {STR_VAR_1}."))
            waitmessage
            enddynamicmultichoice(19, 2, 5, TRUE)
            
            setvar(VAR_RESULT, YES)
        }
        else
        {
            setvar(VAR_RESULT, NO)
        }
    }

    release
}