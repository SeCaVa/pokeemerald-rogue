
const FLAG_HIDE_BANK = FLAG_TEMP_1
const FLAG_HIDE_TREATS = FLAG_TEMP_2
const FLAG_HIDE_POKEBLOCK = FLAG_TEMP_3

mapscripts Rogue_Area_Market_MapScripts 
{
    MAP_SCRIPT_ON_LOAD: Rogue_Area_Market_OnMapLoad
}


script Rogue_Area_Market_OnMapLoad
{
    hubupgradeunlocked(HUB_UPGRADE_MARKET_BANK)
    if(var(VAR_RESULT) == YES)
    {
        clearflag(FLAG_HIDE_BANK)
    }
    else
    {
        setflag(FLAG_HIDE_BANK)
    }

    hubupgradeunlocked(HUB_UPGRADE_MARKET_TREAT_SHOP)
    if(var(VAR_RESULT) == TRUE)
    {
        clearflag(FLAG_HIDE_TREATS)
    }
    else
    {
        setflag(FLAG_HIDE_TREATS)
    }

    hubupgradeunlocked(HUB_UPGRADE_MARKET_POKEBLOCK_BLENDERS)
    if(var(VAR_RESULT) == TRUE)
    {
        clearflag(FLAG_HIDE_POKEBLOCK)
    }
    else
    {
        setflag(FLAG_HIDE_POKEBLOCK)
    }
}



script Rogue_Area_Market_ShopBank
{
    lock
    faceplayer
    message(format("¡Bienvenid{MASC}o{FEM}a{ENDG} al Banco!\pPuedo venderte Monederos que se convertirán al instante en Pokédólares cada vez que partas de Aventura.\p¿Quieres comprar Monederos?"))
    waitmessage

    pokemart(BankMart)

    msgbox("¡Vuelve pronto!")
    release
}

script Rogue_Area_Market_BankSign
{
    hubupgradeunlocked(HUB_UPGRADE_MARKET_BANK)
    if(var(VAR_RESULT) == YES)
    {
        msgbox(format("El Banco"), MSGBOX_SIGN)
    }
}

mart BankMart
{
    ITEM_SMALL_COIN_CASE
    ITEM_LARGE_COIN_CASE
}


script Rogue_Area_Market_BlendPokeblockNovice
{
    setflag(FLAG_HIDE_LILYCOVE_CONTEST_HALL_BLEND_MASTER)
    
    lock

    // NOVICE_BERRY_COUNT
    msgbox(format("¡Hola!\nSoy aprendiz en preparar {POKEBLOCK}.\pPuedo ayudarte a obtener hasta 10 {POKEBLOCK} por cada 20 bayas.\p¿Quieres preparar {POKEBLOCK} conmigo?"), MSGBOX_YESNO)

    if(var(VAR_RESULT) == YES)
    {
        specialvar(VAR_RESULT, PlayerHasBerries)

        if(var(VAR_RESULT) == YES)
        {
            // NOVICE_BERRY_COUNT
            setvar(VAR_0x800A, 20) // num berries

            setvar(VAR_RESULT, YES)
            while(var(VAR_RESULT) == YES)
            {
                call(Rogue_Area_Market_BlendPokeblockNoviceLoop)
            }
        }
        else
        {
            msgbox(format("Vaya.\pParece que no tienes bayas para mezclar."))
        }
    }
    else
    {
        msgbox(format("Entiendo.\nSi cambias de idea, vuelve a hablar conmigo."))
    }

    release
}

script Rogue_Area_Market_BlendPokeblockNoviceLoop
{
    msgbox(format("¿Qué baya quieres mezclar?"))

    fadescreen(FADE_TO_BLACK)
    special(Bag_ChooseBerry)
    waitstate

    if(var(VAR_ITEM_ID) != 0)
    {
        special(Rogue_IsValidPokeblockBerry)
        if(var(VAR_RESULT) == YES)
        {
            // NOVICE_BERRY_COUNT
            checkitem(VAR_ITEM_ID, 20)

            if(var(VAR_RESULT) == YES)
            {
                msgbox(format("De acuerdo.\p¡A mezclar!"))

                waitse
                setvar(VAR_0x8004, 1) // NUM_OPPONENTS
                fadescreen(FADE_TO_BLACK)
                special(DoBerryBlending)
                waitstate

                call(Rogue_Common_DisplayPopups)

                msgbox(format("¿Quieres mezclar más bayas?"), MSGBOX_YESNO)
            }
            else
            {
                // NOVICE_BERRY_COUNT
                msgbox(format("No tienes suficientes bayas.\pNecesitas 20 bayas para mezclar conmigo."))
            }
        }
        else
        {
            msgbox(format("Me temo que esa baya no produce ningún {POKEBLOCK}.\pPuedes usar la opción Ver Etiqueta de tu Mochila para saber qué {POKEBLOCK} produce una baya al mezclarla."))
        }
    }
    else
    {
        setvar(VAR_RESULT, NO)
    }
}

script Rogue_Area_Market_BlendPokeblockMaster
{
    clearflag(FLAG_HIDE_LILYCOVE_CONTEST_HALL_BLEND_MASTER)
    
    lock

    // MASTER_BERRY_COUNT
    msgbox(format("¡Hola!\nSoy maestro en preparar {POKEBLOCK}.\pPuedo ayudarte a obtener hasta 30 {POKEBLOCK} por cada 70 bayas.\p¿Quieres preparar {POKEBLOCK} conmigo?"), MSGBOX_YESNO)

    if(var(VAR_RESULT) == YES)
