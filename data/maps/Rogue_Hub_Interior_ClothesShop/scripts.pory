mapscripts Rogue_Hub_Interior_ClothesShop_MapScripts 
{
    MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE
    [
        VAR_TEMP_1, 0: Rogue_Common_TurnPlayerNorth
    ]
}

script Rogue_Hub_Clothes_TalkAssistant
{
    lockall
    faceplayer
    msgbox(format("¿Te aburre tu aspecto?\n¡Pues estás en el lugar adecuado!\p¡Acércate a una de las estatuas para cambiar tu avatar!"), MSGBOX_DEFAULT)
    releaseall
}

script Rogue_Hub_Clothes_ChangeStyle0
{
    lock

    msgbox(format("¡Hola!\nPuedo ayudarte a cambiar tu aspecto."))
    
    message(format("¿Qué aspecto quieres elegir?"))
    waitmessage
    multichoice(20, 4, MULTI_STYLE_CHOICE, NO)

    switch(var(VAR_RESULT))
    {
        case MULTI_B_PRESSED:
            setvar(VAR_RESULT, NO)

        default:
            copyvar(VAR_0x8006, VAR_RESULT)
            setvar(VAR_RESULT, YES)
    }

    if(var(VAR_RESULT) == YES)
    {
        special(Script_ChangePlayerStyle0)
        
        warp(MAP_ROGUE_HUB_INTERIOR_CLOTHES_SHOP, 19, 20)
        waitstate
    }
    else
    {
        msgbox(format("¡Vuelve cuando quieras!"))
    }

    release
}

script Rogue_Hub_Clothes_ChangeStyle1
{
    lock

    msgbox(format("¡Hola!\nPuedo ayudarte a cambiar tu estilo de ropa."))
    
    message(format("¿Qué estilo de ropa quieres elegir?"))
    waitmessage
    multichoice(20, 2, MULTI_STYLE2_CHOICE, NO)

    switch(var(VAR_RESULT))
    {
        case MULTI_B_PRESSED:
            setvar(VAR_RESULT, NO)

        default:
            copyvar(VAR_0x8006, VAR_RESULT)
            setvar(VAR_RESULT, YES)
    }

    if(var(VAR_RESULT) == YES)
    {
        special(Script_ChangePlayerStyle1)
        
        warp(MAP_ROGUE_HUB_INTERIOR_CLOTHES_SHOP, 21, 20)
        waitstate
    }
    else
    {
        msgbox(format("¡Vuelve cuando quieras!"))
    }

    release
}

script Rogue_Hub_Clothes_ChangeName
{
    lock

    msgbox(format("¿Quieres cambiar tu nombre?"), MSGBOX_YESNO)

    if(var(VAR_RESULT) == YES)
    {
        fadescreen(FADE_TO_BLACK)
        special(ChangePlayerNickname)
        waitstate

        msgbox(format("¡Pues {PLAYER}!"))
    }
    else
    {
        msgbox(format("¡Vuelve cuando quieras!"))
    }

    release
}

