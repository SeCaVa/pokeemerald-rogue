mapscripts Rogue_Area_SafariZone_MapScripts {}

script Rogue_Area_SafariZone_TalkSign
{
    lock

    msgbox(format("¡Es un cartel con todos los Pokémon avistados recientemente en la Zona Safari!"))
    
    begindynamicmultichoice
    appenddynamicmultichoice("Ver Pokémon", 0)
    appenddynamicmultichoice("Ahuyentar Pokémon", 1)
    appenddynamicmultichoice("Salir", MULTI_B_PRESSED)

    message(format("¿Qué quieres hacer?"))
    waitmessage
    enddynamicmultichoice(1, 0, 6, TRUE)

    switch(var(VAR_RESULT))
    {
        case 0:
            special(RogueSafari_CompactEmptyEntries)
            special(Special_SelectSafariMonInPokedex)
            waitstate

        case 1:
            msgbox(format("¿Seguro que quieres ahuyentar a todos los Pokémon que hay ahora en el Safari?"), MSGBOX_YESNO)

            if(var(VAR_RESULT) == YES)
            {
                special(RogueSafari_ResetAllRegularEntries)
                special(ReloadWarpSilent)
            }
    }

    release
}