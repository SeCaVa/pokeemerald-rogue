const VAR_CONTEST_STATE = VAR_ROGUE_SPECIAL_ENCOUNTER_DATA

// Keep in sync with Rogue_SelectCatchingContestMode
const VAR_CURRENT_TYPE = VAR_ROGUE_SPECIAL_ENCOUNTER_DATA1
const VAR_CURRENT_STAT = VAR_ROGUE_SPECIAL_ENCOUNTER_DATA2

const NPC_OBJ_HOST = 1

mapscripts Rogue_Encounter_CatchingContest_MapScripts 
{
    MAP_SCRIPT_ON_LOAD: Rogue_Encounter_CatchingContest_OnLoad
    MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE
    [
        VAR_TEMP_1, 0: Rogue_Common_TurnPlayerNorth
    ]
}

script Rogue_Encounter_CatchingContest_OnLoad
{
}

script Rogue_Encounter_CatchingContest_TalkHost
{
    lock
    faceplayer

    switch(var(VAR_CONTEST_STATE))
    {
        case 0:
            call(Rogue_Encounter_CatchingContest_StartContest)

        case 1:
            call(Rogue_Encounter_CatchingContest_EndContest)

        default:
            msgbox(format("Eso es todo por ahora.\p¡Suerte en tu aventura!"))

    }

    release
}

script Rogue_Encounter_CatchingContest_StartContest 
{
    special(Rogue_BufferContestMode)
    msgbox(format("Hoy celebramos un concurso de captura {STR_VAR_1}."))

    setvar(VAR_RESULT, 2)
    while(var(VAR_RESULT) == 2)
    {
        message(format("¿Quieres participar?"))
        waitmessage
        multichoice(20, 6, MULTI_YESNOINFO, NO)

        switch(var(VAR_RESULT))
        {
            case 0: // Yes
                // Let it fall through
                setvar(VAR_RESULT, YES)

            case 1: // No
            case MULTI_B_PRESSED:
                setvar(VAR_RESULT, NO)

            case 2: // Info
                msgbox(format("Te daremos 3 Safari Balls y tendrás que capturar al Pokémon con la característica base más alta de un tipo concreto.\pSi aciertas, ganarás un premio en metálico.\pGanes o no, podrás quedarte con el Pokémon con el que salgas.\pLos Pokémon solo aparecen durante un tiempo limitado, ¡así que no tardes mucho en capturar algo!"))
        }
    }


    if(var(VAR_RESULT) == YES)
    {
        checkitemspace(ITEM_CATCHING_CONTEST_POKEBALL, 3)
        if(var(VAR_RESULT) == NO)
        {
            msgbox(format("Vaya, parece que tu Mochila está llena.\pMe temo que tendrás que hacer sitio para poder participar."))
        }
        else
        {
            special(Rogue_CatchingContestBegin)

            closemessage
            applymovement(OBJ_EVENT_ID_PLAYER, Movement_Player_Enter)
            applymovement(NPC_OBJ_HOST, Movement_Host_Enter)
            waitmovement(0)

            setobjectxyperm(NPC_OBJ_HOST, 12, 36)
            setobjectmovementtype(NPC_OBJ_HOST, MOVEMENT_TYPE_FACE_UP)
            turnobject(NPC_OBJ_HOST, DIR_NORTH)

            msgbox(format("¡Si capturas al Pokémon con el {STR_VAR_2} base más alto, ganarás un premio especial!\pAquí tienes unas Poké Balls."), MSGBOX_DEFAULT)
            giveitem(ITEM_CATCHING_CONTEST_POKEBALL, 3)

            msgbox(format("¡Buena suerte!"), MSGBOX_DEFAULT)
            playbgm(MUS_HG_BUG_CATCHING_CONTEST, TRUE)

            addvar(VAR_CONTEST_STATE, 1)
        }
    }
}

movement Movement_Host_Enter {
    walk_up * 2
    walk_left
    face_right
    walk_right
    walk_up
}

movement Movement_Player_Enter {
    walk_up * 5
    face_down
}

script Rogue_Encounter_CatchingContest_EndContest 
{
    msgbox(format("¿Quieres terminar tu participación en el Concurso?"), MSGBOX_YESNO)

    if(var(VAR_RESULT) == NO)
    {
        special(Rogue_BufferContestMode)
        msgbox(format("Recuerda: ¡si capturas al Pokémon con el {STR_VAR_2} base más alto, ganarás un premio especial!"))
    }
    else
    {
        call(Rogue_ScriptHideFollower)

        closemessage
        applymovement(OBJ_EVENT_ID_PLAYER, Movement_Player_Exit)
        applymovement(NPC_OBJ_HOST, Movement_Host_Exit)
        waitmovement(0)

        setobjectxyperm(NPC_OBJ_HOST, 12, 29)
        setobjectmovementtype(NPC_OBJ_HOST, MOVEMENT_TYPE_FACE_DOWN)
        turnobject(NPC_OBJ_HOST, DIR_SOUTH)

        special(Rogue_CatchingContestEnd)

        fadeoutbgm(1)
        msgbox(format("Y ahora, el resultado{PAUSE 15}…{PAUSE 15} …{PAUSE 15} …"))
        addvar(VAR_CONTEST_STATE, 1)

        if(var(VAR_RESULT) == TRUE)
        {
            message(format("¡Has ganado!"))
            playfanfare(MUS_HG_BUG_CONTEST_1ST_PLACE)
            waitfanfare
            waitmessage

            quest_trigger(QUEST_TRIGGER_MAP_SPECIFIC_EVENT)

            msgbox(format("En cuanto a tu premio especial…"))

            if(var(VAR_ROGUE_DIFFICULTY) >= ROGUE_ELITE_START_DIFFICULTY)
            {
                addmoney(15000)
                playfanfare(MUS_OBTAIN_TMHM)
                message(format("¡Has recibido ¥15000!"))
            }
            elif(var(VAR_ROGUE_DIFFICULTY) >= ROGUE_GYM_MID_DIFFICULTY)
            {
                addmoney(10000)
                playfanfare(MUS_OBTAIN_TMHM)
                message(format("¡Has recibido ¥10000!"))
            }
            else
            {
                addmoney(5000)
                playfanfare(MUS_OBTAIN_TMHM)
                message(format("¡Has recibido ¥5000!"))
            }

            waitfanfare
            waitmessage
        }
        else
        {
            message(format("Vaya.\nEsta vez no has ganado."))
            playfanfare(MUS_TOO_BAD)
            waitfanfare
            waitmessage

            msgbox(format("Hoy la mejor puntuación ha sido para {STR_VAR_2}."))
        }

        // Check if we actually caught a mon and attempt to add it to team
        if(var(VAR_0x8000) == TRUE)
        {
            specialvar(VAR_TEMP_8, CalculatePlayerPartyCount)
            specialvar(VAR_TEMP_9, Rogue_CalcMaxPartySize)

            if(var(VAR_TEMP_8) >= VAR_TEMP_9)
            {
                msgbox(format("Tendrás que liberar a un Pokémon para poder llevarte a {STR_VAR_1}.\p¿Quieres liberar a un Pokémon?"), MSGBOX_YESNO)
                
                if(var(VAR_RESULT) == YES)
                {
                    //fadescreen(FADE_TO_BLACK)
                    special(ChoosePartyMon)
                    waitstate

                    if(var(VAR_0x8004) != PARTY_NOTHING_CHOSEN)
                    {
                        special(Rogue_ReleaseMonInSlot)
                    }
                }
                else
                {
                    setvar(VAR_0x8004, PARTY_NOTHING_CHOSEN)
                }
            }
            else
            {
                msgbox(format("¡Cuida bien de {STR_VAR_1}!"), MSGBOX_DEFAULT)
                setvar(VAR_0x8004, 6)
            }

            if(var(VAR_0x8004) == PARTY_NOTHING_CHOSEN)
            {
                msgbox(format("En ese caso, lo devolveré al parque."))
            }
            else
            {
                special(Rogue_GiveCatchingContestMon)
            }
        }

        msgbox(format("¡Suerte en tu aventura!"))
        playbgm(MUS_HG_NATIONAL_PARK, TRUE)

        call(Rogue_ScriptShowFollower)
    }
}

movement Movement_Host_Exit {
    walk_down * 2
    walk_left
    face_right
    walk_right
    walk_down
}

movement Movement_Player_Exit {
    walk_down * 5
    face_up
}