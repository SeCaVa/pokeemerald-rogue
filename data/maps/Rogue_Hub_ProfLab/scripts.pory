const VAR_ROGUE_INTRO_STATE = VAR_LITTLEROOT_INTRO_STATE
const VAR_PICKING_STARTER = VAR_TEMP_F

const NPC_BIRCH = 1

mapscripts Rogue_Hub_ProfLab_MapScripts 
{
    MAP_SCRIPT_ON_TRANSITION: Rogue_Hub_ProfLab_OnTransition
}

script Rogue_Hub_ProfLab_OnTransition
{
    switch(var(VAR_STARTER_MON))
    {
        case 1:
            setflag(FLAG_TEMP_1)
        case 2:
            setflag(FLAG_TEMP_2)
        case 3:
            setflag(FLAG_TEMP_3)
    }
}

script Rogue_Hub_ProfLab_SpeakProf
{
    lockall
    faceplayer

    if(flag(FLAG_ROGUE_RUN_ACTIVE))
    {
        msgbox(format("ABEDUL: ¡Hola, {PLAYER}!\n¡Espero que estés disfrutando de la aventura!"))
        call(Rogue_Hub_ProfLab_ProfShowEvos)
    }
    else
    {
        if(var(VAR_ROGUE_INTRO_STATE) <= 3)
        {
            msgbox(format("ABEDUL: ¡Adelante!\n¡Elige a tu Pokémon COMPAÑERO!"), MSGBOX_DEFAULT)
        }
        else
        {
            call(Rogue_Hub_ProfLab_ProfExplain)
            if(var(VAR_RESULT) == NO)
            {
                call(Rogue_Hub_ProfLab_ProfShowEvos)
            }
        }
    }

    if(var(VAR_RESULT) == NO)
    {
        msgbox(format("ABEDUL: ¡De acuerdo!\nSi alguna vez necesitas una explicación, ya sabes dónde encontrarme."), MSGBOX_DEFAULT)
    }

    releaseall
}

script Rogue_Hub_ProfLab_ProfExplain
{
    msgbox(format("ABEDUL: ¿Quieres que te explique cómo funcionan las aventuras?"), MSGBOX_YESNO)

    if(var(VAR_RESULT) == YES)
    {
        msgbox(format("ABEDUL: ¡Nunca sabes lo que te vas a encontrar en una aventura!\pLas rutas cambian de orden, ¡y los Pokémon y ENTRENADORES que encuentres también cambiarán!\pCuando termines tu aventura, te traeremos de vuelta a la BASE y devolveremos tu MOCHILA y tus Pokémon a su estado original.\pPor ejemplo, si tu Pokémon COMPAÑERO evoluciona durante una aventura, volverá a su forma anterior cuando regreses a la BASE."), MSGBOX_DEFAULT)
        msgbox(format("Al volver de una aventura recibirás dinero como recompensa, que podrás gastar en lo que quieras en la BASE.\pTodo lo que compres o uses en la BASE será permanente.\pAsí que, si compras pociones en la BASE y las gastas durante una aventura, al volver las encontrarás de nuevo en tu MOCHILA.\p¡La mejor forma de aprender cómo funcionan las aventuras es vivir muchas!\p¡Así que adelante!\n¡Explora y diviértete!"), MSGBOX_DEFAULT)
    }

    return
}

script Rogue_Hub_ProfLab_ProfCycleEvos
{
    while(var(VAR_0x8005) < VAR_RESULT)
    {
        special(Rogue_GetMonEvoParams)
        addvar(VAR_0x8005, 1) // Increment now so text below doesn't count from 0

        buffernumberstring(STR_VAR_2, VAR_0x8005)

        switch(var(VAR_0x8006))
        {
            case EVO_FRIENDSHIP:
                msgbox(format("{STR_VAR_2}. Tener mucha amistad."))

            case EVO_FRIENDSHIP_DAY:
                msgbox(format("{STR_VAR_2}. Tener mucha amistad de día."))

            case EVO_FRIENDSHIP_NIGHT:
                msgbox(format("{STR_VAR_2}. Tener mucha amistad de noche."))

            case EVO_LEVEL:
            case EVO_LEVEL_NINJASK:
                buffernumberstring(STR_VAR_3, VAR_0x8007)
                msgbox("{STR_VAR_2}. Subir al nv. {STR_VAR_3}.")

            case EVO_TRADE:
                msgbox(format("{STR_VAR_2}. Intercambiarlo."))

            case EVO_TRADE_ITEM:
                bufferitemname(STR_VAR_3, VAR_0x8007)
                msgbox(format("{STR_VAR_2}. Intercambiarlo llevando {STR_VAR_3}."))

            case EVO_ITEM:
                bufferitemname(STR_VAR_3, VAR_0x8007)
                msgbox(format("{STR_VAR_2}. Usar {STR_VAR_3}."))

            case EVO_LEVEL_ATK_GT_DEF:
                buffernumberstring(STR_VAR_3, VAR_0x8007)
                msgbox(format("{STR_VAR_2}. Subir al nv. {STR_VAR_3} con más Ataque que Defensa."))

            case EVO_LEVEL_ATK_EQ_DEF:
                buffernumberstring(STR_VAR_3, VAR_0x8007)
                msgbox(format("{STR_VAR_2}. Subir al nv. {STR_VAR_3} con el mismo Ataque que Defensa."))

            case EVO_LEVEL_ATK_LT_DEF:
                buffernumberstring(STR_VAR_3, VAR_0x8007)
                msgbox(format("{STR_VAR_2}. Subir al nv. {STR_VAR_3} con menos Ataque que Defensa."))

            case EVO_LEVEL_SILCOON:
            case EVO_LEVEL_CASCOON:
                buffernumberstring(STR_VAR_3, VAR_0x8007)
                msgbox(format("{STR_VAR_2}. Subir al nv. {STR_VAR_3} con cierta personalidad."))

            case EVO_LEVEL_SHEDINJA:
                buffernumberstring(STR_VAR_3, VAR_0x8007)
                msgbox(format("{STR_VAR_2}. Subir al nv. {STR_VAR_3} con un hueco libre en el equipo."))

            case EVO_BEAUTY:
                msgbox(format("{STR_VAR_2}. Tener mucha belleza."))

            case EVO_LEVEL_ITEM:
                bufferitemname(STR_VAR_3, VAR_0x8007)
                msgbox(format("{STR_VAR_2}. Subir un nivel llevando {STR_VAR_3}."))


            // EX methods
            //
            case EVO_LEVEL_FEMALE:
                buffernumberstring(STR_VAR_3, VAR_0x8007)
                msgbox(format("{STR_VAR_2}. Subir al nv. {STR_VAR_3} siendo hembra."))

            case EVO_LEVEL_MALE:
                buffernumberstring(STR_VAR_3, VAR_0x8007)
                msgbox(format("{STR_VAR_2}. Subir al nv. {STR_VAR_3} siendo macho."))

            case EVO_LEVEL_NIGHT:
                buffernumberstring(STR_VAR_3, VAR_0x8007)
                msgbox(format("{STR_VAR_2}. Subir al nv. {STR_VAR_3} de noche."))

            case EVO_LEVEL_DAY:
                buffernumberstring(STR_VAR_3, VAR_0x8007)
                msgbox(format("{STR_VAR_2}. Subir al nv. {STR_VAR_3} de día."))

            case EVO_LEVEL_DUSK:
                buffernumberstring(STR_VAR_3, VAR_0x8007)
                msgbox(format("{STR_VAR_2}. Subir al nv. {STR_VAR_3} al atardecer."))

            case EVO_ITEM_HOLD_DAY:
                bufferitemname(STR_VAR_3, VAR_0x8007)
                msgbox(format("{STR_VAR_2}. Subir un nivel de día llevando {STR_VAR_3}."))

            case EVO_ITEM_HOLD_NIGHT:
                bufferitemname(STR_VAR_3, VAR_0x8007)
                msgbox(format("{STR_VAR_2}. Subir un nivel de noche llevando {STR_VAR_3}."))
    

            case EVO_MOVE:
                buffermovename(STR_VAR_3, VAR_0x8007)
                msgbox(format("{STR_VAR_2}. Subir un nivel conociendo {STR_VAR_3}."))
    
            case EVO_MOVE_TYPE:
                msgbox(format("{STR_VAR_2}. Subir un nivel conociendo un movimiento de tipo HADA.")) // Hard coded, as this is only instance

            case EVO_MAPSEC:
            case EVO_SPECIFIC_MAP:
                bufferitemname(STR_VAR_3, VAR_0x8007)
                msgbox(format("{STR_VAR_2}. Subir un nivel llevando {STR_VAR_3} en el lugar ???."))


            case EVO_ITEM_MALE:
                bufferitemname(STR_VAR_3, VAR_0x8007)
                msgbox(format("{STR_VAR_2}. Usar {STR_VAR_3} siendo macho."))

            case EVO_ITEM_FEMALE:
                bufferitemname(STR_VAR_3, VAR_0x8007)
                msgbox(format("{STR_VAR_2}. Usar {STR_VAR_3} siendo hembra."))


            case EVO_LEVEL_RAIN:
                buffernumberstring(STR_VAR_3, VAR_0x8007)
                msgbox(format("{STR_VAR_2}. Subir al nv. {STR_VAR_3} mientras llueve."))

            case EVO_SPECIFIC_MON_IN_PARTY:
                bufferspeciesname(STR_VAR_3, VAR_0x8007)
                msgbox(format("{STR_VAR_2}. Subir un nivel con {STR_VAR_3} en el equipo."))

            case EVO_LEVEL_DARK_TYPE_MON_IN_PARTY:
                buffernumberstring(STR_VAR_3, VAR_0x8007)
                msgbox(format("{STR_VAR_2}. Subir al nv. {STR_VAR_3} con un Pokémon de tipo SINIESTRO en el equipo."))

            case EVO_TRADE_SPECIFIC_MON:
                bufferspeciesname(STR_VAR_3, VAR_0x8007)
                msgbox(format("{STR_VAR_2}. Intercambiarlo por {STR_VAR_3}."))


            case EVO_LEVEL_NATURE_AMPED:
            case EVO_LEVEL_NATURE_LOW_KEY:
                buffernumberstring(STR_VAR_3, VAR_0x8007)
                msgbox(format("{STR_VAR_2}. Subir al nv. {STR_VAR_3} con cierta naturaleza."))

            case EVO_CRITICAL_HITS:
                buffernumberstring(STR_VAR_3, VAR_0x8007)
                msgbox(format("{STR_VAR_2}. Asestar {STR_VAR_3} golpes críticos en un mismo combate."))

            case EVO_SCRIPT_TRIGGER_DMG:
                buffernumberstring(STR_VAR_3, VAR_0x8007)
                msgbox(format("{STR_VAR_2}. Con menos de {STR_VAR_3} PS, interactuar con ???."))
    
            case EVO_DARK_SCROLL:
            case EVO_WATER_SCROLL:
                msgbox(format("{STR_VAR_2}. Interactuar con ???."))

            default:
                buffernumberstring(STR_VAR_3, VAR_0x8007)
                msgbox(format("{STR_VAR_2}. TIPO DE EVO DESCONOCIDO, {STR_VAR_3}."))
        }
    }
}

script Rogue_Hub_ProfLab_ProfShowEvos
{
    msgbox(format("ABEDUL: ¿Quieres saber cómo evoluciona un Pokémon?"), MSGBOX_YESNO)

    if(var(VAR_RESULT) == YES)
    {
        msgbox(format("¿De quién quieres información?"))
        special(ChoosePartyMon)
        waitstate
        
        if(var(VAR_0x8004) == PARTY_NOTHING_CHOSEN)
        {
            msgbox(format("ABEDUL: ¡De acuerdo!\nSi alguna vez necesitas ayuda, ya sabes dónde encontrarme."), MSGBOX_DEFAULT)
        }
        else
        {
            specialvar(VAR_RESULT, Rogue_GetMonEvoCount)
            special(BufferMonNickname)

            if(var(VAR_RESULT) == 0)
            {
                msgbox(format("Parece que {STR_VAR_1} no tiene ninguna evolución disponible ahora mismo."))
            }
            elif(var(VAR_RESULT) == 1)
            {
                buffernumberstring(STR_VAR_2, VAR_RESULT)
                msgbox(format("{STR_VAR_1} tiene {STR_VAR_2} evolución disponible."))

                setvar(VAR_0x8005, 0)
                call(Rogue_Hub_ProfLab_ProfCycleEvos)
                msgbox(format("ABEDUL: Si necesitas más ayuda, ya sabes dónde encontrarme."), MSGBOX_DEFAULT)
            }
            else
            {
                buffernumberstring(STR_VAR_2, VAR_RESULT)
                msgbox(format("{STR_VAR_1} tiene {STR_VAR_2} evoluciones disponibles."))

                setvar(VAR_0x8005, 0)
                call(Rogue_Hub_ProfLab_ProfCycleEvos)
                msgbox(format("ABEDUL: Si necesitas más ayuda, ya sabes dónde encontrarme."), MSGBOX_DEFAULT)
            }
        }

        setvar(VAR_RESULT, YES)
    }
}

script Rogue_Hub_ProfLab_TriggerPC
{
    lockall
    msgbox(format("(Ahora no debería usar esto)"), MSGBOX_DEFAULT)
    applymovement(OBJ_EVENT_ID_PLAYER, Rogue_Hub_ProfLab_WalkBackwards)
    waitmovement(0)
    releaseall
}

movement Rogue_Hub_ProfLab_WalkBackwards 
{
    walk_down
}

script Rogue_Hub_ProfLab_IntroCommon
{
    msgbox(format("ABEDUL: ¡{PLAYER}!\n¡Por fin has llegado!\pSupongo que estás deseando irte de aventuras, pero antes de empezar necesitas un Pokémon propio."), MSGBOX_DEFAULT)
    turnobject(NPC_BIRCH, DIR_EAST)
    msgbox(format("ABEDUL: Esta mañana salí a capturar unos cuantos para que eligieras.\p¡Escoge el que más te guste!"), MSGBOX_DEFAULT)
    return
}

script Rogue_Hub_ProfLab_IntroRunAwayCommon
{
    bufferspeciesname(STR_VAR_1, SPECIES_SUNKERN)
    givemon(SPECIES_SUNKERN, 7, ITEM_ORAN_BERRY)

    playfanfare(MUS_OBTAIN_ITEM)
    message(format("¡{PLAYER} ha obtenido a {STR_VAR_1}!"))
    waitmessage
    waitfanfare

    msgbox(format("ABEDUL: ¿Quieres ponerle un mote a {STR_VAR_1}?"), MSGBOX_YESNO)
    if(var(VAR_RESULT) == YES)
    {
        call(Common_EventScript_NameReceivedPartyMon)
    }
    
    setvar(VAR_STARTER_MON, 4)

    call(Rogue_Hub_ProfLab_PostStarterSelect)
    return
}

script Rogue_Hub_ProfLab_IntroTriggerL
{
    lockall
    if(var(VAR_PICKING_STARTER) != YES)
    {
        setvar(VAR_PICKING_STARTER, YES)

        applymovement(OBJ_EVENT_ID_PLAYER, Rogue_Hub_ProfLab_WalkToProfL)
        waitmovement(0)

        call(Rogue_Hub_ProfLab_IntroCommon)
    }
    else
    {
        turnobject(NPC_BIRCH, DIR_SOUTH)
        turnobject(OBJ_EVENT_ID_PLAYER, DIR_NORTH)

        msgbox(format("ABEDUL: Vaya...\p¿Prefieres elegir entre otros Pokémon?"), MSGBOX_YESNO)

        if(var(VAR_RESULT) == YES)
        {
            msgbox(format("ABEDUL: ¡Muy bien, aquí tienes!"), MSGBOX_DEFAULT)

            applymovement(NPC_BIRCH, Rogue_Hub_ProfLab_WalkFromProfL)
            waitmovement(0)

            call(Rogue_Hub_ProfLab_IntroRunAwayCommon)
        }
        else
        {
            applymovement(OBJ_EVENT_ID_PLAYER, Rogue_Hub_ProfLab_WalkUpOne)
            waitmovement(0)
        }
    }
    releaseall
}

script Rogue_Hub_ProfLab_IntroTriggerR
{
    lockall
    if(var(VAR_PICKING_STARTER) != YES)
    {
        setvar(VAR_PICKING_STARTER, YES)

        applymovement(OBJ_EVENT_ID_PLAYER, Rogue_Hub_ProfLab_WalkToProfR)
        waitmovement(0)

        call(Rogue_Hub_ProfLab_IntroCommon)
    }
    else
    {
        turnobject(NPC_BIRCH, DIR_SOUTH)
        turnobject(OBJ_EVENT_ID_PLAYER, DIR_NORTH)

        msgbox(format("ABEDUL: Vaya...\p¿Prefieres otro Pokémon?"), MSGBOX_YESNO)

        if(var(VAR_RESULT) == YES)
        {
            msgbox(format("ABEDUL: ¡Muy bien, aquí tienes!"), MSGBOX_DEFAULT)

            applymovement(NPC_BIRCH, Rogue_Hub_ProfLab_WalkFromProfR)
            waitmovement(0)

            call(Rogue_Hub_ProfLab_IntroRunAwayCommon)
        }
        else
        {
            applymovement(OBJ_EVENT_ID_PLAYER, Rogue_Hub_ProfLab_WalkUpOne)
            waitmovement(0)
        }
    }
    releaseall
}

movement Rogue_Hub_ProfLab_WalkUpOne
{
    walk_up
}

movement Rogue_Hub_ProfLab_WalkToProfL
{
    walk_up * 3
}

movement Rogue_Hub_ProfLab_WalkToProfR
{
    walk_left
    walk_up * 3
}

movement Rogue_Hub_ProfLab_WalkFromProfL
{
    walk_down * 3
}

movement Rogue_Hub_ProfLab_WalkFromProfR
{
    walk_right
    walk_down * 3
}

script Rogue_Hub_ProfLab_PokeballCommon
{
    if(var(VAR_ROGUE_INTRO_STATE) <= 3)
    {
        turnobject(NPC_BIRCH, DIR_EAST)

        showmonpic(VAR_0x8001, 10, 3)
        playmoncry(VAR_0x8001, CRY_MODE_NORMAL)
        waitmoncry

        bufferspeciesname(STR_VAR_1, VAR_0x8001)
        msgbox(format("ABEDUL: ¿Quieres llevarte a {STR_VAR_1}?"), MSGBOX_YESNO)
        hidemonpic

        if(var(VAR_RESULT) == YES)
        {
            removeobject(VAR_LAST_TALKED)
            givemon(VAR_0x8001, 7, ITEM_ORAN_BERRY)

            playfanfare(MUS_OBTAIN_ITEM)
            message(format("¡{PLAYER} ha obtenido a {STR_VAR_1}!"))
            waitmessage
            waitfanfare

            msgbox(format("ABEDUL: ¿Quieres ponerle un mote a {STR_VAR_1}?"), MSGBOX_YESNO)
            if(var(VAR_RESULT) == YES)
            {
                call(Common_EventScript_GetGiftMonPartySlot)
                call(Common_EventScript_NameReceivedPartyMon)
            }
            
            turnobject(OBJ_EVENT_ID_PLAYER, DIR_WEST)
            call(Rogue_Hub_ProfLab_PostStarterSelect)

            setvar(VAR_RESULT, YES)
            return
        }
    }
    else
    {
        bufferspeciesname(STR_VAR_1, VAR_0x8001)
        msgbox(format("(Pobre {STR_VAR_1}...)\p(Debe de sentirse solo...)"))
    }

    setvar(VAR_RESULT, NO)
    return
}

script Rogue_Hub_ProfLab_PostStarterSelect
{
    msgbox(format("ABEDUL: ¡También he incluido algunos objetos y una POKéDEX!"), MSGBOX_DEFAULT)
    
    giveitem(ITEM_POKE_BALL, 5)
    giveitem(ITEM_POTION, 1)
    
    setflag(FLAG_SYS_POKEDEX_GET)
    setflag(FLAG_SYS_POKEMON_GET)
    setvar(VAR_ROGUE_INTRO_STATE, 4)

    msgbox(format("¡Ya estás list{MASC}o{FEM}a{ENDG} para irte de aventuras!"), MSGBOX_DEFAULT)

    call(Rogue_Hub_ProfLab_ProfExplain)

    special(Rogue_SetupFollowParterMonObjectEvent)
    return
}

script Rogue_Hub_ProfLab_Pokeball0
{
    lock
    copyvar(VAR_0x8001, VAR_ROGUE_STARTER0)
    call(Rogue_Hub_ProfLab_PokeballCommon)

    if(var(VAR_RESULT) == YES)
    {
        setvar(VAR_STARTER_MON, 1)
        setflag(FLAG_TEMP_1)
    }

    release
}

script Rogue_Hub_ProfLab_Pokeball1
{
    lock
    copyvar(VAR_0x8001, VAR_ROGUE_STARTER1)
    call(Rogue_Hub_ProfLab_PokeballCommon)

    if(var(VAR_RESULT) == YES)
    {
        setvar(VAR_STARTER_MON, 2)
        setflag(FLAG_TEMP_2)
    }

    release
}

script Rogue_Hub_ProfLab_Pokeball2
{
    lock
    copyvar(VAR_0x8001, VAR_ROGUE_STARTER2)
    call(Rogue_Hub_ProfLab_PokeballCommon)

    if(var(VAR_RESULT) == YES)
    {
        setvar(VAR_STARTER_MON, 3)
        setflag(FLAG_TEMP_3)
    }

    release
}