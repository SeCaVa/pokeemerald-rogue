const FLAG_HIDE_WILD_MON = FLAG_TEMP_1

mapscripts Rogue_Encounter_HoneyTree_MapScripts 
{
    MAP_SCRIPT_ON_LOAD: Rogue_Encounter_HoneyTree_OnLoad
}

script Rogue_Encounter_HoneyTree_OnLoad
{
    if(var(VAR_FOLLOW_MON_0) == SPECIES_NONE)
    {
        setflag(FLAG_HIDE_WILD_MON)
    }
}

script Rogue_Encounter_HoneyTree_ScatterPokeblock
{
    lock
    msgbox(format("¡Es un Árbol de Miel!\pHay migas de {POKEBLOCK} y huellas de todo tipo de Pokémon.\p¿Quieres esparcir {POKEBLOCK} aquí?"), MSGBOX_YESNO)

    if(var(VAR_RESULT) == YES)
    {
        fadescreen(FADE_TO_BLACK)
        special(Bag_ChoosePokeblock)
        waitstate

        if(var(VAR_ITEM_ID) !=  ITEM_NONE)
        {
            call(Rogue_EventScript_UsePokeblockItem)
        }
    }
    release
}

script Rogue_Encounter_HoneyTree_TrainerTips
{
    lock
    msgbox(format("Consejos para Entrenadores.\nLos Pokémon visitan a menudo los Árboles de Miel, así que son el lugar ideal para esparcir {POKEBLOCK}.\p¡Es muy sencillo!\nEsparce uno o más {POKEBLOCK} cerca del Árbol.\pLa próxima vez que lo visites, seguramente encontrarás a un Pokémon al que le gusten los sabores de los {POKEBLOCK} que esparciste."), MSGBOX_SIGN)
    release
}