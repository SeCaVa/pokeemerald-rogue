script RogueHub_ChangeMonBall
{
    lock
    faceplayer

    setvar(VAR_0x8004, 0)
    special(BufferMonNickname)

    msgbox(format("¡Hola, qué tal!\p¿Quieres que cambie la POKé BALL de {STR_VAR_1}?"), MSGBOX_YESNO)

    if(var(VAR_RESULT) == YES)
    {
        msgbox(format("¿Por qué tipo de BALL la cambio?"))

        fadescreen(FADE_TO_BLACK)
        special(Bag_ChooseBall)
        waitstate

        
        if(var(VAR_ITEM_ID) == 0)
        {
            setvar(VAR_RESULT, NO)
        }
        else
        {
            removeitem(VAR_ITEM_ID, 1)
            special(Rogue_ChangeMonBall)

            msgbox(format("¡Y listo!"), MSGBOX_DEFAULT)
            setvar(VAR_RESULT, YES)
        }

    }

    if(var(VAR_RESULT) == NO)
    {
        msgbox(format("Vaya... Vale..."), MSGBOX_DEFAULT)
    }

    release
}

script RogueHub_CombineMons
{
    lock

    msgbox(format("Encontré un artefacto poderoso enterrado aquí...\pCuanto más cavo...\nmás encuentro...\p¡Los artefactos que he encontrado pueden fusionar ciertos Pokémon!"), MSGBOX_DEFAULT)

    specialvar(VAR_RESULT, CalculatePlayerPartyCount)
    faceplayer
    if(var(VAR_RESULT) > 1)
    {
        msgbox(format("¿Quieres que examine a 2 de tus Pokémon?"), MSGBOX_YESNO)
    
        if(var(VAR_RESULT) == YES)
        {
            msgbox(format("¿Qué Pokémon quieres que examine?"), MSGBOX_DEFAULT)

            // 1st mon
            special(ChoosePartyMon)
            waitstate
            copyvar(VAR_0x8003, VAR_0x8004)

            if(var(VAR_0x8003) == PARTY_NOTHING_CHOSEN)
            {
                setvar(VAR_RESULT, NO)
            }

            // 2nd mon
            if(var(VAR_RESULT) == YES)
            {
                special(ChoosePartyMon)
                waitstate

                if(var(VAR_0x8004) == PARTY_NOTHING_CHOSEN)
                {
                    setvar(VAR_RESULT, NO)
                }
            }

            if(var(VAR_RESULT) == YES)
            {
                if(var(VAR_0x8003) == VAR_0x8004)
                {
                    msgbox(format("No puedo fusionar un Pokémon consigo mismo..."), MSGBOX_DEFAULT)
                }
                else
                {
                    special(Rogue_CheckMonCombo)

                    if(var(VAR_0x8005) != 0)
                    {
                        bufferitemname(STR_VAR_1, VAR_0x8005)
                        bufferspeciesname(STR_VAR_2, VAR_0x8006)
        
                        msgbox(format("¡Oh, sí!\n¡Mis artefactos!\p¡{STR_VAR_1} está respondiendo!\p¿Qué dices, {STR_VAR_1}...?\pAjá..."), MSGBOX_DEFAULT)
                        msgbox(format("¡Puedo fusionar a esos Pokémon!\pPero una vez hecho...\nNUNCA se podrá deshacer...\p¿Quieres fusionarlos?"), MSGBOX_YESNO)

                        if(var(VAR_RESULT) == YES)
                        {
                            fadescreen(FADE_TO_BLACK)
                            playfanfare(MUS_AWAKEN_LEGEND)
                            special(Rogue_ApplyMonCombo)
                            waitfanfare

                            playmoncry(VAR_0x8006, CRY_MODE_ENCOUNTER)
                            waitmoncry

                            fadescreen(FADE_FROM_BLACK)
    
                            msgbox(format("¡{STR_VAR_2} ha despertado!"), MSGBOX_DEFAULT)
                        }
                    }
                    else
                    {
                        msgbox(format("Mmm...\nMis artefactos no parecen responder..."), MSGBOX_DEFAULT)
                        setvar(VAR_RESULT, YES)
                    }
                }
            }
        }

        if(var(VAR_RESULT) == NO)
        {
            msgbox(format("Qué pena...\nLos artefactos se van a poner tristes..."), MSGBOX_DEFAULT)
        }
    }
    else
    {
        msgbox(format("Si vuelves con 2 Pokémon, podría examinarlos... si quieres..."), MSGBOX_DEFAULT)
    }

    release
}

