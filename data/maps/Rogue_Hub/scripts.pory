script RogueHub_HintRouteAdjectives
{
    lock
    faceplayer

    msgbox(format("¡Me ha costado, pero por fin he descubierto qué significan los nombres de las rutas!"), MSGBOX_DEFAULT)
    msgbox(format("¿Quieres que te lo cuente?"), MSGBOX_YESNO)

    if(var(VAR_RESULT) == YES)
    {
        msgbox(format("Los nombres de las rutas tienen 2 adjetivos.\pLa Dificultad y la Pista de Tipo."), MSGBOX_DEFAULT)
        msgbox(format("Hay 3 dificultades.\nTranquila, Normal y Dura.\pLas rutas Tranquilas tienen más Pokémon salvajes, menos objetos y Entrenadores menos hábiles.\pLas rutas Duras tienen pocos Pokémon salvajes, pero más objetos y Entrenadores más hábiles.\pLas rutas Normales son un término medio."), MSGBOX_DEFAULT)
        msgbox(format("El 2.º adjetivo es la Pista de Tipo, que te da una idea de qué tipos de Pokémon salvajes pueden aparecer en la ruta.\pPor ejemplo, en una ruta CÁLIDA pueden aparecer Pokémon salvajes de tipo FUEGO.\pEso no significa que siempre vaya a haber de ese tipo.\pSolo que es más probable que en otras rutas."), MSGBOX_DEFAULT)
    }

    release
}


