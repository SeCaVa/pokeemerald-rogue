script Rogue_Area_RideTraining_GiveGoldWhistle
{
    showmoneybox(0, 0)

    msgbox(format("¿Te doy un Silbato Dorado por ¥15000?"), MSGBOX_YESNO)

    if(var(VAR_RESULT) == YES)
    {
        checkconstantmoney(15000)
        if(var(VAR_RESULT) == YES)
        {
            removeconstantmoney(15000)
            updatemoneybox

            playse(SE_SHOP)
            waitse

            msgbox(format("¡Muchas gracias, {PLAYER}!"))
            msgbox(format("¡Aquí tienes!"))

            hidemoneybox
            giveitem(ITEM_GOLD_RIDING_WHISTLE)

            msgbox(format("En vez de servir para montar a los Pokémon de tu equipo, ese Silbato Dorado está vinculado a mi amigo.\p¡Sal!"))

            poryswitch(ROGUE_VERSION)
            {
                ROGUE_VERSION_VANILLA
                {
                    clearflag(FLAG_HIDE_DITTO)
                    addobject(NPC_OBJ_DITTO)
                    playmoncry(SPECIES_DITTO, CRY_MODE_NORMAL)
                    waitmoncry

                    msgbox(format("Puedes hablar con Ditto cuando quieras para que se transforme en uno de tus Pokémon.\pA partir de entonces, aunque no tengas ese Pokémon en tu equipo, podrás llamarlo con el Silbato Dorado."))

                    message(format("{COLOR GREEN}{SHADOW LIGHT_GREEN}¡{PLAYER} ha aprendido a llamar a Ditto!"))
                    waitmessage
                    playfanfare(MUS_EVOLVED)
                    waitfanfare
                }
                ROGUE_VERSION_EXPANSION
                {
                    clearflag(FLAG_HIDE_DITTO)
                    addobject(NPC_OBJ_DITTO)
                    playmoncry(SPECIES_ZORUA_HISUIAN, CRY_MODE_NORMAL)
                    waitmoncry

                    msgbox(format("Puedes hablar con Zorua cuando quieras para que se transforme en uno de tus Pokémon.\pA partir de entonces, aunque no tengas ese Pokémon en tu equipo, podrás llamarlo con el Silbato Dorado."))

                    message(format("{COLOR GREEN}{SHADOW LIGHT_GREEN}¡{PLAYER} ha aprendido a llamar a Zorua!"))
                    waitmessage
                    playfanfare(MUS_EVOLVED)
                    waitfanfare
                }
            }
        }
        else
        {
            msgbox(format("Vaya… parece que ahora mismo no tienes suficiente dinero."))
            hidemoneybox
        }
    }
    else
    {
        hidemoneybox
    }
}

