script Rogue_Interior_ChallengeFrontier_HealingFlask
{
    lock

    checkitem(ITEM_HEALING_FLASK)
    if(var(VAR_RESULT) == YES)
    {
        msgbox(format("¿Quieres devolver el Frasco Curativo?"), MSGBOX_YESNO)
        if(var(VAR_RESULT) == YES)
        {
            removeitem(ITEM_HEALING_FLASK)
        }
    }
    else
    {
        message("¿Quieres coger el Frasco Curativo?")
        waitmessage

        multichoice(20, 6, MULTI_YESNOINFO, NO)

        switch(var(VAR_RESULT))
        {
            case 0: // Yes
                giveitem(ITEM_HEALING_FLASK)
                call(Rogue_Interior_ChallengeFrontier_GiveGimickItemTutorial)

            case 1: // No
                setvar(VAR_RESULT, NO)

            case 2: // Info
                msgbox(format("Si vas de Aventura con el Frasco Curativo, tu equipo no se curará automáticamente tras los combates clave, como Entrenadores Fuertes o Rivales.\pEn su lugar, tendrás varios usos de curación que podrás gastar con el Frasco Curativo.\pEl Frasco Curativo solo se rellena cuando una Enfermera cura a tu equipo.\pEs un recurso más que gestionar, y en general hará las Aventuras más exigentes, ya que tendrás que ser más cuidadoso con los objetos curativos."), MSGBOX_DEFAULT)

            case MULTI_B_PRESSED:
                setvar(VAR_RESULT, NO)
        }
    }
    call(Rogue_Interior_ChallengeFrontier_UpdateItemVisibility)

    release
}

script Rogue_Interior_ChallengeFrontier_GiveGimickItemTutorial
{
    if(!flag(FLAG_ROGUE_GIMICK_TUTORIAL))
    {
        setflag(FLAG_ROGUE_GIMICK_TUTORIAL)
        msgbox(format("Si más adelante quieres jugar sin esto, solo tienes que devolverlo a este pedestal."))
    }
}

script Rogue_Interior_ChallengeFrontier_TalkScott
{
    lock
    faceplayer

    if(var(VAR_ROGUE_POST_GAME_TUTORIAL) == 1)
    {
        msgbox(format("¡Todavía te quedan muchas cosas por descubrir por aquí!\p¡No te preocupes!"))
    }
    else
    {
        msgbox(format("¡Vaya, si es {PLAYER}!\p¡Espero que tus Misiones vayan bien!"))
    }

    //msgbox(format("todo - unlock challenges"))
//
    //special(Rogue_UnlockChallengeQuests)
    //special(Rogue_ShowNewQuests)
    //waitstate

    release
}

script Rogue_Interior_ChallengeFrontier_ScottIntroLeft
{
    lock

    applymovement(NPC_OBJ_SCOTT, PostGameTutorial_Scott0)
    waitmovement(0)

    msgbox(format("¡Ah!\n¡Tú debes de ser {PLAYER}!"))

    closemessage
    applymovement(OBJ_EVENT_ID_PLAYER, PostGameTutorial_Player0_Left)
    waitmovement(0)

    call(Rogue_Interior_ChallengeFrontier_ScottIntroCommon)
    release
}

script Rogue_Interior_ChallengeFrontier_ScottIntroRight
{
    lock

    applymovement(NPC_OBJ_SCOTT, PostGameTutorial_Scott0)
    waitmovement(0)

    msgbox(format("¡Ah!\n¡Tú debes de ser {PLAYER}!"))

    closemessage
    applymovement(OBJ_EVENT_ID_PLAYER, PostGameTutorial_Player0_Right)
    waitmovement(0)

    call(Rogue_Interior_ChallengeFrontier_ScottIntroCommon)
    release
}

