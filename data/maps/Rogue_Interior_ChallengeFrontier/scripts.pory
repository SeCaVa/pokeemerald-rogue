script Rogue_Interior_ChallengeFrontier_ScottIntroCommon
{
    addvar(VAR_ROGUE_POST_GAME_TUTORIAL, 1)

    msgbox(format("TRETO: ¡Me llamo Treto!\pPokabbie me pidió que estuviera atento a un futuro Campeón.\pSupongo que eres tú, ¿verdad?"))

    if(flag(FLAG_IS_CHAMPION))
    {
        msgbox(format("Y mira por dónde…\p¡Ya has puesto tu nombre en el Hall de la Fama!\p¡Vas a encajar muy bien por aquí!"))
    }
    else
    {
        msgbox(format("Todavía te veo un poco verde, ¡pero tienes potencial!\p¡Apuesto a que podrías entrar en el Hall de la Fama si te lo propones!"))
    }

    msgbox(format("Verás, este Edificio es para quienes quieren superarse completando los Desafíos más duros que te puedas imaginar.\pDe hecho…\n¿Por qué no echas un vistazo?\p¡Seguro que muchas cosas de aquí te parecen interesantes!"))
    
    quest_trigger(QUEST_TRIGGER_MAP_SPECIFIC_EVENT)
}

movement PostGameTutorial_Scott0
{
    emote_exclamation_mark
}

movement PostGameTutorial_Player0_Centre
{
    walk_up * 2
}

movement PostGameTutorial_Player0_Left
{
    walk_up
    walk_right
    walk_up * 2
}

movement PostGameTutorial_Player0_Right
{
    walk_up
    walk_left
    walk_up * 2
}


script Rogue_Interior_ChallengeFrontier_ScottBlockExit
{
    lock

    if(flag(FLAG_SYS_MASTERIES_UNLOCKED) && flag(FLAG_SYS_CHALLENGES_UNLOCKED) && flag(FLAG_ROGUE_FOUND_GIMIC_ROOM))
    {
        addvar(VAR_ROGUE_POST_GAME_TUTORIAL, 1)
    }
    else
    {
        turnobject(OBJ_EVENT_ID_PLAYER, DIR_NORTH)
        msgbox(format("TRETO: {PLAYER}, todavía no puedes irte.\p¡Aún te queda mucho por ver!"))

        closemessage
        applymovement(OBJ_EVENT_ID_PLAYER, PostGameTutorial_Player1)
        waitmovement(0)
    }

    release
}

script Rogue_Interior_ChallengeFrontier_VisitedGimicRoom
{
    lock
    setflag(FLAG_ROGUE_FOUND_GIMIC_ROOM)
    release
}

movement PostGameTutorial_Player1
{
    walk_up
}

script Rogue_Interior_ChallengeFrontier_TalkMasteries
{
    lock
    faceplayer

    if(!flag(FLAG_SYS_MASTERIES_UNLOCKED))
    {
        msgbox(format("Hola, {PLAYER}.\p¡Me ha gustado mucho ver tus progresos!\pMe gustaría encargarte algunas Misiones adicionales.\pEstas Misiones demostrarán tu habilidad con muy diversos Pokémon.\pPor eso se llaman, como es lógico, Maestrías Pokémon.\p¡Echa un vistazo!"))
        
        special(Rogue_UnlockMasteryQuests)
        special(Rogue_ShowNewMonMasteries)
        waitstate

        msgbox(format("Quizá también te hayas fijado en que tienes acceso al Registro {PKMN} junto a esas Misiones.\pEl Registro {PKMN} anota cada línea evolutiva de Pokémon que has llevado al Hall de la Fama.\pNo te preocupes.\nNo hace falta completar el Registro {PKMN} para llegar al 100% de las Misiones.\pSolo las Misiones de Maestría Pokémon de la lista."))
        
    
        poryswitch(ROGUE_VERSION)
        {
            ROGUE_VERSION_VANILLA
            {
                msgbox(format("¡Te deseo mucha suerte con tus Maestrías Pokémon, {PLAYER}!"))
            }
            ROGUE_VERSION_EXPANSION
            {
                msgbox(format("Cuando completes alguna de esas Misiones, sus Objetos Especiales podrán estar a la venta.\pPuedes hablar conmigo en cualquier momento para comprar los Objetos Especiales que desbloquees completando Misiones.\p¡Te deseo mucha suerte con tus Maestrías Pokémon, {PLAYER}!"))
            }
        }
    }
    else
    {
        msgbox(format("Hola, {PLAYER}."))

        poryswitch(ROGUE_VERSION)
        {
            ROGUE_VERSION_VANILLA
            {
                msgbox(format("¡Espero que tus Maestrías Pokémon vayan bien!"))
            }
            ROGUE_VERSION_EXPANSION
            {
                message(format("¿Quieres comprar algún Objeto Especial de recompensa?"))
                waitmessage

                rogue_dynamicpokemart(ROGUE_SHOP_RARE_HELD_ITEMS)

                msgbox(format("Mucha suerte con tus Maestrías Pokémon, {PLAYER}."))
            }
        }
    }

    release
}

script Rogue_Interior_ChallengeFrontier_TalkChallenges
{
    lock
    faceplayer

    if(!flag(FLAG_SYS_CHALLENGES_UNLOCKED))
    {
        msgbox(format("¿Qué es eso?\p¿Ese librito de Misiones que llevas?\pAsí que intentas completar Misiones, ¿eh?\p¡Pues tengo justo lo que necesitas!\p¡Desafíos!\p¡Los Desafíos son un tipo especial de Misión mucho más complejo!\pMira."))
        
        special(Rogue_UnlockChallengeQuests)
        special(Rogue_ShowNewQuests)
        waitstate
        
        msgbox(format("Los Desafíos se diferencian de las Misiones normales en que registran en qué Dificultad los completaste por última vez.\p¡Incluso hay Recompensas exclusivas por completarlos en dificultades más altas!\pSi quieres repetir un Desafío en una dificultad mayor, ve al Lab. Config. y fíjate en la Dificultad de Recompensa.\pSuena emocionante, ¿verdad?\p¡Demuéstrame de lo que eres capaz, {PLAYER}!"))
    }
    else
    {
        msgbox(format("Hola, {PLAYER}.\p¿Qué tal van tus Desafíos?\n¡Bien, espero!"))
    }

    release
}