    lock

    applymovement(NPC_OBJ_SCOTT, PostGameTutorial_Scott0)
    waitmovement(0)

    msgbox(format("¡Ah!\n¡Tú debes de ser {PLAYER}!"))

    closemessage
    applymovement(OBJ_EVENT_ID_PLAYER, PostGameTutorial_Player0_Centre)
