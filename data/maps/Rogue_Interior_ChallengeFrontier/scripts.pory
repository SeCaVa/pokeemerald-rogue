script Rogue_Interior_ChallengeFrontier_TryWarnAboutDynamaxAndTera
{
    poryswitch(ROGUE_VERSION)
    {
        ROGUE_VERSION_VANILLA
        {
            // do nothing
        }
        ROGUE_VERSION_EXPANSION
        {
            checkitem(ITEM_DYNAMAX_BAND)
            if(var(VAR_RESULT) == YES)
            {
                checkitem(ITEM_TERA_ORB)
                if(var(VAR_RESULT) == YES)
                {
                    msgbox(format("Atención…\pLlevas la Maximuñequera y el Orbe Teracristal a la vez.\pNo se pueden activar los dos al mismo tiempo.\pAsí que, al empezar los combates en los que estarían activos, se elegirá uno al azar y el otro se desactivará temporalmente."))
                }
            }
        }
    }
}

script Rogue_Interior_ChallengeFrontier_Dynamax
{
    lock

    poryswitch(ROGUE_VERSION)
    {
        ROGUE_VERSION_VANILLA
        {
            msgbox(format("¡Es una Maximuñequera!\pEste objeto solo está disponible en la versión EX de Emerald Rogue."))
