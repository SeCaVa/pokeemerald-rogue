const FLAG_ACCEPTED_GIFT = FLAG_TEMP_1

mapscripts Rogue_Encounter_Shrine_MapScripts {}


script Rogue_Encounter_Shrine_Talk 
{
    lock
    faceplayer
    bufferitemname(STR_VAR_1, ITEM_SACRED_ASH)

    if(flag(FLAG_ACCEPTED_GIFT))
    {
        msgbox(format("¡Espero que {STR_VAR_1} te sea útil!"))
    }
    else
    {
        msgbox(format("¡Vaya, hola!\n¡Qué alegría recibir visitas!"))

        message(format("Veo que estás de Aventura.\nSi quieres, tengo {STR_VAR_1} que puedes llevarte."))
        setvar(VAR_TEMP_0, TRUE)

        while(var(VAR_TEMP_0) == TRUE)
        {
            setvar(VAR_TEMP_0, FALSE)
            waitmessage

            bufferitemname(STR_VAR_1, ITEM_SACRED_ASH)
            bufferitemname(STR_VAR_2, ITEM_PARTY_CURSE)

            multichoice(20, 6, MULTI_YESNOINFO, NO)

            switch(var(VAR_RESULT))
            {
                case 0: // Yes
                    call(Rogue_Encounter_Shrine_TalkAccept)

                case 1: // No
                case MULTI_B_PRESSED:
                    msgbox(format("Entiendo…\nSi cambias de idea, avísame."), MSGBOX_DEFAULT)

                case 2: // Info
                    msgbox(format("{STR_VAR_1} es un Amuleto especial que te protege si todo tu equipo se debilita.\pEn ese caso, {STR_VAR_1} brillará, reanimará a todos tus Pokémon y te teletransportará a un lugar seguro para darte una segunda oportunidad.\pSin embargo, {STR_VAR_1} es un objeto muy poderoso.\pTanto que, me temo, para llevarlo deberás aceptar también {STR_VAR_2}, que reduce en uno el número máximo de Pokémon de tu equipo."), MSGBOX_DEFAULT)
                    setvar(VAR_TEMP_0, TRUE)
                    message(format("¿Quieres coger {STR_VAR_1}?"))
            }
        }
    }


    release
}

script Rogue_Encounter_Shrine_TalkAccept
{
    specialvar(VAR_0x8000, CalculatePlayerPartyCount)

    checkitemspace(ITEM_SACRED_ASH)

    if(var(VAR_RESULT) == NO)
    {
        msgbox(format("Vaya…\nParece que tu mochila está demasiado llena…\p¡Te lo daré cuando hagas sitio!"))
    }
    else
    {
        specialvar(VAR_TEMP_1, CalculatePlayerPartyCount)
        specialvar(VAR_TEMP_2, Rogue_CalcMaxPartySize)

        if(var(VAR_TEMP_1) >= VAR_TEMP_2)
        {
            msgbox(format("Tendrás que liberar a un Pokémon para poder aceptar {STR_VAR_2}…"))
            //fadescreen(FADE_TO_BLACK)
            special(ChoosePartyMon)
            waitstate

            if(var(VAR_0x8004) != PARTY_NOTHING_CHOSEN)
            {
                special(Rogue_ReleaseMonInSlot)
            }
        }
        else
        {
            setvar(VAR_0x8004, 6)
        }

        if(var(VAR_0x8004) == PARTY_NOTHING_CHOSEN)
        {
            msgbox(format("Entiendo…\nSi cambias de idea, avísame."))
        }
        else
        {
            giveitem(ITEM_SACRED_ASH)
            giveitem(ITEM_PARTY_CURSE)
            call(Rogue_Common_DisplayPopups)

            quest_trigger(QUEST_TRIGGER_MAP_SPECIFIC_EVENT)

            msgbox(format("¡Aquí tienes!\n¡Espero que te sea útil!"))
            setflag(FLAG_ACCEPTED_GIFT)
        }
    }
}