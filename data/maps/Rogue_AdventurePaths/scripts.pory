const VAR_NODE_ID = VAR_0x8004
const VAR_NODE_PARAM0 = VAR_0x8005
const VAR_NODE_PARAM1 = VAR_0x8006

const VAR_LOAD_STATE = VAR_TEMP_0

mapscripts Rogue_AdventurePaths_MapScripts 
{
    MAP_SCRIPT_ON_RESUME: Rogue_AdventurePaths_OnLoad
    MAP_SCRIPT_ON_FRAME_TABLE 
    [
        VAR_LOAD_STATE, 0: Rogue_AdventurePaths_PreviewCutscene
    ]
}

script Rogue_AdventurePaths_OnLoad
{
    // If we want to do it, don't do it On load/Resume
    //special(SpawnCameraObject)
    //applymovement(OBJ_EVENT_ID_CAMERA, AdventurePaths_OffsetCamera)

    //special(RogueAdv_ApplyAdventureMetatiles)
}

script Rogue_AdventurePaths_PreviewCutscene
{
    setvar(VAR_LOAD_STATE, 1)
}

movement AdventurePaths_OffsetCamera {
    walk_right * 4
}

script Rogue_AdventurePaths_InteractRoom
{
    lock
    special(RogueAdv_GetLastInteractedRoomParams)

    switch(var(VAR_NODE_PARAM0))
    {
        case ADVPATH_ROOM_BOSS:
            msgbox(format("¡Es un Entrenador Poderoso!"), MSGBOX_DEFAULT)
            setvar(VAR_RESULT, YES)

        case ADVPATH_ROOM_MINIBOSS:
            msgbox(format("¡Es un Entrenador Fuerte!\n¿Entrar en este encuentro?"), MSGBOX_YESNO)

        case ADVPATH_ROOM_WILD_DEN:
            msgbox(format("¡Es un Hábitat {STR_VAR_1} de un Pokémon entrenado!\n¿Entrar en este encuentro?"), MSGBOX_YESNO)

        case ADVPATH_ROOM_HONEY_TREE:
            msgbox(format("¡Es un Hábitat de Árbol de Miel!\n¿Entrar en este encuentro?"), MSGBOX_YESNO)

        case ADVPATH_ROOM_GAMESHOW:
            msgbox(format("¿Es un… concurso?\n¿Entrar en este encuentro?"), MSGBOX_YESNO)

        case ADVPATH_ROOM_DARK_DEAL:
            msgbox(format("¿Es un Trato Oscuro…?\n¿Entrar en este encuentro?"), MSGBOX_YESNO)

        case ADVPATH_ROOM_LAB:
            msgbox(format("Es un Laboratorio Pokémon.\n¿Entrar en este encuentro?"), MSGBOX_YESNO)

        case ADVPATH_ROOM_SHRINE:
            msgbox(format("Es un Santuario Misterioso.\n¿Entrar en este encuentro?"), MSGBOX_YESNO)

        case ADVPATH_ROOM_CATCHING_CONTEST:
            msgbox(format("Es un Concurso de Captura.\n¿Entrar en este encuentro?"), MSGBOX_YESNO)

        case ADVPATH_ROOM_SIGN:
            msgbox(format("Es un Cartel Misterioso.\n¿Entrar en este encuentro?"), MSGBOX_YESNO)

        case ADVPATH_ROOM_BATTLE_SIM:
            msgbox(format("Es un Simulador de Combate.\n¿Entrar en este encuentro?"), MSGBOX_YESNO)

        case ADVPATH_ROOM_BATTLE_TOWER:
            msgbox(format("Es una Torre Batalla.\n¿Entrar en este encuentro?"), MSGBOX_YESNO)

        case ADVPATH_ROOM_RESTSTOP:
            switch(var(VAR_NODE_PARAM1))
            {
                case ADVPATH_SUBROOM_RESTSTOP_FULL:
                    msgbox(format("Es un Área de Descanso Completa.\n¿Entrar en este encuentro?"), MSGBOX_YESNO)

                case ADVPATH_SUBROOM_RESTSTOP_SHOP:
                    msgbox(format("Es un Área de Descanso con Tienda.\n¿Entrar en este encuentro?"), MSGBOX_YESNO)

                case ADVPATH_SUBROOM_RESTSTOP_BATTLE:
                    msgbox(format("Es un Área de Descanso de Preparación.\n¿Entrar en este encuentro?"), MSGBOX_YESNO)
                
                case ADVPATH_SUBROOM_RESTSTOP_DAYCARE:
                    msgbox(format("Es un Área de Descanso con Guardería.\n¿Entrar en este encuentro?"), MSGBOX_YESNO)

                default:
                    msgbox(format("??\n¿Entrar en este encuentro?"), MSGBOX_YESNO)
            }
            
        case ADVPATH_ROOM_ROUTE:
            switch(var(VAR_NODE_PARAM1))
            {
                case 0:
                    msgbox(format("Es una ruta {STR_VAR_1} Tranquila.\n¿Entrar en este encuentro?"), MSGBOX_YESNO)

                case 1:
                    msgbox(format("Es una ruta {STR_VAR_1} Normal.\n¿Entrar en este encuentro?"), MSGBOX_YESNO)

                case 2:
                    msgbox(format("Es una ruta {STR_VAR_1} Dura.\n¿Entrar en este encuentro?"), MSGBOX_YESNO)

                default:
                    msgbox(format("??\n¿Entrar en este encuentro?"), MSGBOX_YESNO)
            }

        case ADVPATH_ROOM_LEGENDARY:
            msgbox(format("¡Es un Pokémon de Leyenda!\n¿Entrar en este encuentro?"), MSGBOX_YESNO)

        case ADVPATH_ROOM_TEAM_HIDEOUT:
            msgbox(format("¡Es una Guarida del Team!\n¿Entrar en este encuentro?"), MSGBOX_YESNO)

        default:
            msgbox(format("??\n¿Entrar en este encuentro?"), MSGBOX_YESNO)
    }

    if(var(VAR_RESULT) == YES)
    {
        special(RogueAdv_WarpLastInteractedRoom)
    }

    release
}