{
    face_left
}

movement FaceRight
{
    face_right
}


script Rogue_Area_AdventureEntrance_SpeakNurse
{
    lockall
    faceplayer

    if(var(VAR_ROGUE_INTRO_STATE) == ROGUE_INTRO_STATE_CATCH_MON)
    {
        msgbox(format("¡{PLAYER}!\p¡Se oyen ruidos extraños en el claro!\p¡Tienes que ir a ayudar al Profesor!"))
    }
    elif (var(VAR_ROGUE_INTRO_STATE) < ROGUE_INTRO_STATE_COLLECT_QUEST_LOG)
    {
        msgbox(format("¡Hola, {PLAYER}!\pMe temo que no puedo dejarte pasar sin un Pokémon propio.\p¿Quizá el Profesor Elm pueda ayudarte con eso?"))
    }
    elif (var(VAR_ROGUE_INTRO_STATE) == ROGUE_INTRO_STATE_COLLECT_QUEST_LOG)
    {
        msgbox(format("¡Hola, {PLAYER}!\p¡Parece que ya casi estás list{MASC}o{FEM}a{ENDG} para partir de Aventura!\pAntes de irte, toma esto."))

        giveitem(ITEM_QUEST_LOG)
        msgbox(format("Con ese Libro de Misiones puedes aceptar Misiones y Desafíos para completar durante las Aventuras.\p¡Acércate al Tablón de Misiones de tu izquierda; debería haber unas Misiones iniciales para empezar!"))

        closemessage
        playbgm(MUS_RG_FOLLOW_ME, FALSE)

        applymovement(OBJ_EVENT_ID_PLAYER, Rogue_Adventure_QuestTutorial_Player1)
        waitmovement(0)

        msgbox(format("¡Hay algunas Misiones publicadas en el tablón!"))
        fadedefaultbgm()

        special(Rogue_ShowNewQuests)
        waitstate

        addvar(VAR_ROGUE_INTRO_STATE, 1)
    }
    elif(var(VAR_ROGUE_INTRO_STATE) == ROGUE_INTRO_STATE_LEARN_TO_BUILD)
    {
        msgbox(format("¡Hola, {PLAYER}!\pEl constructor te estaba buscando.\pCreo que dijo que te esperaría en la Plaza del Pueblo."))
    }
    else
    {
        if(var(VAR_ROGUE_INTRO_STATE) == ROGUE_INTRO_STATE_GO_ON_ADVENTURE)
        {
            msgbox(format("¡Ahora sí que pareces list{MASC}o{FEM}a{ENDG} para partir!"))
            msgbox(format("¿Quieres partir de Aventura?"), MSGBOX_YESNO)
        }
        else
        {
            // Give player the daycare phone if they didn't pick it up before exiting
            hubupgradeunlocked(HUB_UPGRADE_DAY_CARE_PHONE0)
            if(var(VAR_RESULT) == TRUE)
            {
                checkitem(ITEM_DAYCARE_PHONE)

                if(var(VAR_RESULT) == NO)
                {
                    msgbox(format("¡{PLAYER}!\pMe pidieron que te entregara un paquete."))
                    call(Rogue_Area_DayCare_GiveDayCarePhone)
                }
            }

            special(Rogue_HasPendingQuestRewards)
            if(var(VAR_RESULT) == YES)
            {
                msgbox(format("¡Hola, {PLAYER}!\pVaya.\pParece que aún tienes recompensas de Misiones por recoger.\p¿Quieres partir de Aventura de todos modos?"), MSGBOX_YESNO)
            }
            else
            {
                msgbox(format("¡Hola, {PLAYER}!\p¿Quieres partir de Aventura?"), MSGBOX_YESNO)
            }
        }

        if(var(VAR_RESULT) == YES)
        {
            call(Rogue_ResetAdventureVars)
            call(Rogue_StartAdventureInternal)
        }
        else
        {
            special(Rogue_HasPendingQuestRewards)
            if(var(VAR_RESULT) == YES)
            {
                msgbox(format("¡No pasa nada!"), MSGBOX_DEFAULT)
                turnobject(OBJ_EVENT_ADVENTURE_NURSE, DIR_WEST)

                msgbox(format("Puedes recoger las recompensas de Misiones en el Tablón de Misiones de allí."), MSGBOX_DEFAULT)
                turnobject(OBJ_EVENT_ADVENTURE_NURSE, DIR_SOUTH)

                msgbox(format("Ven a hablar conmigo cuando estés list{MASC}o{FEM}a{ENDG}."), MSGBOX_DEFAULT)
            }
            else
            {
                msgbox(format("¡No pasa nada!\pVen a hablar conmigo cuando estés list{MASC}o{FEM}a{ENDG}."), MSGBOX_DEFAULT)
            }
        }
    }

    releaseall
}

movement Rogue_Adventure_QuestTutorial_Player1
{
    walk_left * 5
    face_up
}

script Rogue_ResetAdventureVars
{
    clearflag(FLAG_ROGUE_GAUNTLET_MODE)
    
    setvar(VAR_ROGUE_SKIP_TO_DIFFICULTY, 0)
}

script Rogue_StartAdventureInternal
{
    special(Rogue_IsMultiplayerClient)
    if(var(VAR_RESULT) == YES)
    {
        special(Rogue_IsMultiplayerAdventureJoinable)
        if(var(VAR_RESULT) == NO)
        {
            msgbox(format("Me temo que ahora mismo no puedes partir de Aventura.\pEspera a que {RIVAL} empiece para poder unirte."))
            return
        }
    }

    special(Rogue_EnterPartnerMonCapacity)
    copyvar(VAR_0x8004, VAR_RESULT)

    getpartysize

    if(var(VAR_RESULT) > VAR_0x8004)
    {
        buffernumberstring(STR_VAR_1, VAR_0x8004)
        msgbox(format("Parece que llevas demasiados Pokémon.\pEn este tipo de Aventura solo puedes llevar {STR_VAR_1} Pokémon.\pTendrás que dejar algunos en un PC antes de que pueda dejarte partir."), MSGBOX_DEFAULT)
        setvar(VAR_RESULT, NO)
    }
    else
    {
        setvar(VAR_RESULT, YES)
    }

    if(var(VAR_RESULT) == NO)
    {
        // Invalid team size
        return
    }

    call(Common_EventScript_SaveGame)
    if(var(VAR_RESULT) == YES)
    {
        if(var(VAR_ROGUE_INTRO_STATE) == ROGUE_INTRO_STATE_GO_ON_ADVENTURE)
        {
            addvar(VAR_ROGUE_INTRO_STATE, 1)
        }

        special(Rogue_SeedRandomGenerators)
        msgbox(format("¡Buena suerte, {PLAYER}!"))
        closemessage

        setvar(VAR_STARTER_SWAP_SPECIES, SPECIES_NONE)

        if(!flag(FLAG_HIDE_STARTER_BAG))
        {
            applymovement(OBJ_EVENT_ADVENTURE_NURSE, Rogue_Adventure_WalkNurse)
            applymovement(OBJ_EVENT_ID_PLAYER, Rogue_Adventure_WalkPlayerStarter)
            waitmovement(0)

            msgbox(format("¿Llevar un Pokémon Compañero aleatorio?"), MSGBOX_YESNO)
            closemessage

            if(var(VAR_RESULT) == YES)
            {
                special(ChooseStarter)
                setflag(FLAG_SCRIPT_HIDE_FOLLOWER) 
                waitstate
                clearflag(FLAG_SCRIPT_HIDE_FOLLOWER) 
            }

            applymovement(OBJ_EVENT_ID_PLAYER, Rogue_Adventure_WalkPlayerStarter1)
            waitmovement(0)
        }
        else
        {
            applymovement(OBJ_EVENT_ADVENTURE_NURSE, Rogue_Adventure_WalkNurse)
            applymovement(OBJ_EVENT_ID_PLAYER, Rogue_Adventure_WalkPlayer)
            waitmovement(0)
        }

        
        special(RogueDebug_PrintTimers)
        delay(0)

        setflag(FLAG_ROGUE_LEFT_ON_RUN)
        setrespawn(HEAL_LOCATION_ROGUE_HUB)
        warp(MAP_ROGUE_ADVENTURE_PATHS, 0)
        waitstate
    }
    else
    {
        msgbox(format("De acuerdo. Ven a hablar conmigo cuando estés list{MASC}o{FEM}a{ENDG}."), MSGBOX_DEFAULT)
    }
}

movement Rogue_Adventure_WalkNurse
{
    walk_up
    walk_right
    face_up
}

movement Rogue_Adventure_WalkPlayer
{
    walk_up * 3
}

movement Rogue_Adventure_WalkPlayerStarter
{
    walk_up * 2
    face_left
}

movement Rogue_Adventure_WalkPlayerStarter1
{
    walk_up
}

script Rogue_ReturnAdventureInternal
{
    lockall
    turnobject(OBJ_EVENT_ID_PLAYER, DIR_NORTH)

    msgbox(format("¡Bienvenid{MASC}o{FEM}a{ENDG} de vuelta, {PLAYER}!"), MSGBOX_DEFAULT)

    special(Rogue_RunRewardMoney)
    copyvar(VAR_0x8000, VAR_RESULT)

    special(Rogue_RunRewardLvls)
    copyvar(VAR_0x8001, VAR_RESULT)

    if(var(VAR_0x8000) != 0 || var(VAR_0x8001) != 0)
    {
        msgbox(format("Vamos a ver qué has conseguido reunir."), MSGBOX_DEFAULT)

        // Just returned from first successful adventure
        //if(var(VAR_ROGUE_INTRO_STATE) == 6)
        //{
        //    buffernumberstring(STR_VAR_1, VAR_ROGUE_CURRENT_ROOM_IDX)
        //    //buffernumberstring(STR_VAR_2, VAR_ROGUE_DIFFICULTY)
        //
        //    msgbox(format("Hmm…\pYou managed to complete{PAUSE 15}.{PAUSE 15}.{PAUSE 15}.\n{STR_VAR_1} routes…{PAUSE 15}"), MSGBOX_DEFAULT)
        //    
        //    //turnobject(NPC_INTRO_SCOTT, DIR_EAST)
        //    msgbox(format("So…\nYour rewards should be{PAUSE 15}.{PAUSE 15}.{PAUSE 15}."), MSGBOX_DEFAULT)
        //    //turnobject(NPC_INTRO_SCOTT, DIR_SOUTH)
        //}

        if(var(VAR_0x8000) != 0)
        {
            buffernumberstring(STR_VAR_1, VAR_0x8000)

            message(format("Has recibido ¥{STR_VAR_1}"))
            playfanfare(MUS_OBTAIN_ITEM)
            waitmessage
            waitfanfare
        }

        if(var(VAR_0x8001) != 0)
        {
            if(var(VAR_0x8001) == 1)
            {
                message(format("El equipo ha subido 1 NV."))
            }
            else
            {
                buffernumberstring(STR_VAR_1, VAR_0x8001)
                message(format("El equipo ha subido {STR_VAR_1} NV."))
            }

            playfanfare(FANFARE_LEVEL_UP)
            waitmessage
            waitfanfare
            
            //if(!flag(FLAG_ROGUE_LVL_TUTORIAL))
            //{
            //    msgbox(format("¡Ah!\n¿Es la primera vez que tu equipo sube de nivel en {POKEMON_HUB}?\pEstos NV. no funcionan igual que durante las Aventuras.\pEn la BASE, los POKéMON no aprenden movimientos ni evolucionan por sí solos.\pTendrás que buscar a personas especializadas que te ayuden cuando tu Pokémon alcance el nivel adecuado.\pLos niveles que ganes en la BASE se restablecerán temporalmente al partir de Aventura.\pEl nivel de la BASE volverá cuando regreses."))
            //    setflag(FLAG_ROGUE_LVL_TUTORIAL)
            //}
        }
    }
    else
    {
        msgbox(format("Parece que esta Aventura no tiene recompensas."))
    }

    clearflag(FLAG_ROGUE_LEFT_ON_RUN)
    //setvar(VAR_ROGUE_INTRO_STATE, 7)

    //if(flag(FLAG_SET_SEED_ENABLED))
    //{
    //    msgbox(format("¿Quieres mantener la misma SEMILLA para tu próxima Aventura?"), MSGBOX_YESNO)
    //    if(var(VAR_RESULT) == YES)
    //    {
    //        msgbox(format("De acuerdo.\nRecordaré la misma SEMILLA."), MSGBOX_DEFAULT)
    //    }
    //    else
    //    {
    //        msgbox(format("De acuerdo.\nSe quitará la SEMILLA en la próxima Aventura."), MSGBOX_DEFAULT)
    //        clearflag(FLAG_SET_SEED_ENABLED)
    //    }
    //}
    
    msgbox(format("¿Quieres guardar tu progreso?"), MSGBOX_YESNO)
    if(var(VAR_RESULT) == YES)
    {
        call(Common_EventScript_SaveGame)
    }

    special(Rogue_ShouldNursePromptConfigLabSettingsChange)
    if(var(VAR_RESULT) == YES)
    {
        msgbox(format("{PLAYER}, antes de que te vayas..."), MSGBOX_DEFAULT)

        if(var(VAR_0x8004) == 1)
        {
            msgbox(format("Solo quería recordarte que puedes ajustar la Dificultad en el Lab. Config. si quieres que sea más Desafiante.\pTambién puedes cambiar ajustes individuales, si prefieres subir la Dificultad poco a poco en vez de dar un gran salto."), MSGBOX_DEFAULT)
        }
        else
        {
            msgbox(format("Solo quería recordarte que puedes ajustar la Dificultad en el Lab. Config. si quieres que sea más llevadera.\pTambién puedes cambiar ajustes individuales, si prefieres cambiar la Dificultad poco a poco en vez de dar un gran salto."), MSGBOX_DEFAULT)
        }
    }

    msgbox(format("Ven a hablar conmigo cuando estés list{MASC}o{FEM}a{ENDG} para tu próxima aventura."), MSGBOX_DEFAULT)

    releaseall
}

script Rogue_Area_AdventureEntrance_TalkPeonia
{
    lock
    faceplayer

    if(!flag(FLAG_ROGUE_MET_PEONIA))
    {
        setflag(FLAG_ROGUE_MET_PEONIA)
        msgbox(format("¡Hola!\n¡Me llamo Peonia!\pPEONIA: Te vi en tu última Aventura.\pFue…\nAlgo digno de ver.\pSe me da muy bien recordar caminos.\pAsí que, si quieres, puedo recordar una Aventura pasada para que puedas volver a jugarla.\p¡Cuando me pidas que recuerde una Aventura, me quedaré con la más reciente!\pLuego, para volver a jugarla, iza esta bandera que tengo al lado.\pCuando termines y quieras volver a las Aventuras normales, puedes arriar la bandera.\p¡Puedes izarla y arriarla todas las veces que quieras!\pEso sí, las Misiones estarán desactivadas mientras repites, ¡así que solo será por orgullo!\pAsí que…"))
        msgbox(format("¡Deja que recuerde tu última Aventura!"))
        setvar(VAR_RESULT, YES)
    }
    else
    {
        msgbox(format("PEONIA: Hola, {PLAYER}.\p¿Quieres que recuerde tu Aventura más reciente?"), MSGBOX_YESNO)
    }

    if(var(VAR_RESULT) == YES)
    {
        special(Rogue_IsValidAdventureToRemember)
        if(var(VAR_RESULT) == NO)
        {
            msgbox(format("Vaya, parece que no has ido de Aventura hace poco.\pVen a hablar conmigo después de tu próxima Aventura y la recordaré por ti."))
        }
        else
        {
            special(Rogue_RememberAdventure)
            msgbox(format("¡De acuerdo!\n¡He memorizado el camino de esa Aventura!"))

            if(!flag(FLAG_ROGUE_ADVENTURE_REPLAY_ACTIVE))
            {
                msgbox(format("¿Quieres que ice la bandera para repetir la Aventura ahora mismo?"), MSGBOX_YESNO)
                if(var(VAR_RESULT) == YES)
                {
                    setflag(FLAG_ROGUE_ADVENTURE_REPLAY_ACTIVE)
                    call(Rogue_Area_AdventureEntrance_UpdateFlagState)
                    special(ReloadWarpSilent)
                }
            }
        }
    }

    release
}

script Rogue_Area_AdventureEntrance_TalkFlag
{
    lock
    msgbox(format("¡Es la bandera de Repetir Aventura!"))

    special(Rogue_IsMultiplayerClient)
    if(var(VAR_RESULT) == NO)
    {
        special(Rogue_IsValidAdventureToReplay)
    
        if(var(VAR_RESULT) == YES)
        {
            if(flag(FLAG_ROGUE_ADVENTURE_REPLAY_ACTIVE))
            {
                msgbox(format("¿Quieres arriar la bandera para volver a jugar con normalidad?"), MSGBOX_YESNO)
                if(var(VAR_RESULT) == YES)
                {
                    clearflag(FLAG_ROGUE_ADVENTURE_REPLAY_ACTIVE)
                    call(Rogue_Area_AdventureEntrance_UpdateFlagState)
                    special(ReloadWarpSilent)
                }
            }
            else
            {
                msgbox(format("¿Quieres izar la bandera para jugar la Aventura que recuerda Peonia?"), MSGBOX_YESNO)
                if(var(VAR_RESULT) == YES)
                {
                    setflag(FLAG_ROGUE_ADVENTURE_REPLAY_ACTIVE)
                    call(Rogue_Area_AdventureEntrance_UpdateFlagState)
                    special(ReloadWarpSilent)
                }
            }
        }
        else
        {
            if(flag(FLAG_ROGUE_MET_PEONIA))
            {
                msgbox(format("Ahora mismo no hay ninguna Aventura memorizada.\pHabla con Peonia antes de izar esta bandera.\p(Las Aventuras memorizadas pueden borrarse entre actualizaciones)"))
            }
            else
            {
                msgbox(format("Mejor no toco esto ahora mismo…"))
            }
        }
    }

    release
}

script Rogue_Area_AdventureEntrance_UpdateFlagState
{
    if(flag(FLAG_ROGUE_ADVENTURE_REPLAY_ACTIVE))
    {
        setobjectmovementtype(OBJ_EVENT_FLAG, MOVEMENT_TYPE_FLAG_ENABLED)
    }
    else
    {
        setobjectmovementtype(OBJ_EVENT_FLAG, MOVEMENT_TYPE_FLAG_DISABLED)
    }
}

script Rogue_Area_AdventureEntrance_MeetPokabbie
{
    setflag(FLAG_ROGUE_MET_POKABBIE)
    setflag(FLAG_ROGUE_UNCOVERRED_POKABBIE)

    closemessage
    delay(30)

    msgbox(format("{PLAYER}!"))
    closemessage

    turnobject(OBJ_EVENT_ID_PLAYER, DIR_SOUTH)
    playbgm(MUS_PL_MYSTERY_GIFT, TRUE)

    call(Rogue_Area_AdventureEntrance_PokabbieEnterMovement)
    waitmovement(0)

    msgbox(format("¡{PLAYER}, ha sido increíble!\p¡Ese último combate ha sido... GUAU!\pAy… perdona, me estoy adelantando.\pMe llamo Pokabbie.\n¡Soy quien desarrolla Emerald Rogue!"))

    applymovement(OBJ_EVENT_POKABBIE, Pokabbie_Spin_FaceUp)
    waitmovement(0)

    msgbox(format("POKABBIE: ¡Tachán!\pAhora que eres Campeón, ¡tienes muchíiiisimas más cosas divertidas por hacer!\pHablando de eso…\n¿Me prestas tu Pokédex un segundo, por favor?"))
    closemessage

    call(Rogue_Area_AdventureEntrance_PokabbieExitMovement)
    waitmovement(0)

    delay(30)
    playse(SE_M_COMET_PUNCH)
    waitse
    playse(SE_M_COMET_PUNCH)
    waitse
    playse(SE_M_COMET_PUNCH)
    waitse
    delay(30)

    playse(SE_M_EXPLOSION)
    setvar(VAR_SHAKE_VERTICAL_PAN, -5)
    setvar(VAR_SHAKE_HORIZONTAL_PAN, 5)
    setvar(VAR_SHAKE_NUM_SHAKES, 8)
    setvar(VAR_SHAKE_SHAKE_DELAY, 4)
    special(ShakeCameraNoSE)
    waitstate
    waitse

    delay(30)

    call(Rogue_Area_AdventureEntrance_PokabbieEnterMovement)
    waitmovement(0)

    msgbox(format("POKABBIE: Uf…\n¡Listo!\p¡Tengo unas cuantas mejoras para ti!\pPrimero, ahora tu Pokédex puede cambiar de modo a distintas Regiones.\pMira."))

    waitse
    special(Special_ViewRoguePokedex)
    waitstate

    msgbox(format("Si cambias el modo de tu Pokédex, en tu próxima Aventura ¡solo encontrarás Pokémon de ese modo de Pokédex!\p¡Lo siguiente que he hecho ha sido mejorarte el Lab. Config.!"))

    checkitem(ITEM_C_GEAR)
    if(var(VAR_RESULT) == NO)
    {
        bufferitemname(STR_VAR_1, ITEM_C_GEAR)

        msgbox(format("¡¿Qué?!\n¿Ni siquiera tienes {STR_VAR_1} propio?\p¡Eso no puede ser!\n¡Toma!"))
        giveitem(ITEM_C_GEAR)

        msgbox(format("¡Con {STR_VAR_1} puedes acceder al Lab. Config. estés donde estés!\pPuedes cambiar los ajustes desde cualquier lugar de {POKEMON_HUB}, o incluso revisarlos en mitad de una Aventura.\pEn fin, ¡que me distraigo!\pEn realidad, eso no es lo que te he mejorado…"))
    }

    msgbox(format("He mejorado el Lab. Config. para que tenga ajustes nuevos.\pMira."))

    waitse
    special(Special_ViewDifficultyConfigMenu)
    waitstate

    msgbox(format("¡Yyyyyyy!\p¡Por último, he añadido una nueva mejora que puedes construir en {POKEMON_HUB}: la Zona de Desafíos!"))

    if(var(VAR_ROGUE_INTRO_STATE) <= ROGUE_INTRO_STATE_LEARN_TO_BUILD)
    {
        msgbox(format("¡Vaya!\n¿Todavía no sabes lo que son las mejoras?\p¡Sí que has llegado rápido al Hall de la Fama!\pNo importa. Seguro que lo aprendes muy pronto."))
    }

    msgbox(format("No te voy a hacer spoiler, ¡pero en la Zona de Desafíos hay un montón de cosas que seguro que te parecen superdivertidas!\pBueno, tengo que irme.\pLo cierto es que tengo una zona secreta en el Lab. Config. desde donde lo gestiono todo.\pTe dejaré la puerta abierta por si alguna vez quieres hacerme una visita."))
    closemessage

    applymovement(OBJ_EVENT_POKABBIE, Pokabbie_Spin_FaceUp)
    waitmovement(0)

    call(Rogue_Area_AdventureEntrance_PokabbieExitMovement)
    waitmovement(0)

    setobjectxy(OBJ_EVENT_POKABBIE, 0, 0)
    setobjectxyperm(OBJ_EVENT_POKABBIE, 0, 0)
    hideobjectat(OBJ_EVENT_POKABBIE, MAP_ROGUE_AREA_ADVENTURE_ENTRANCE)
    setflag(FLAG_HIDE_POKABBIE)

    fadedefaultbgm
}

script Rogue_Area_AdventureEntrance_PokabbieEnterMovement
{
    setvar(VAR_0x8004, HUB_AREA_LABS)
    special(Rogue_CheckHubConnectionDir)

    switch(var(VAR_RESULT))
    {
        case HUB_AREA_CONN_EAST:
            applymovement(OBJ_EVENT_POKABBIE, Rogue_Adventure_PokabbieEnter_East)
            break

        case HUB_AREA_CONN_SOUTH:
            applymovement(OBJ_EVENT_POKABBIE, Rogue_Adventure_PokabbieEnter_South)
            break

        case HUB_AREA_CONN_WEST:
            applymovement(OBJ_EVENT_POKABBIE, Rogue_Adventure_PokabbieEnter_West)
            break
    }
}

script Rogue_Area_AdventureEntrance_PokabbieExitMovement
{
    setvar(VAR_0x8004, HUB_AREA_LABS)
    special(Rogue_CheckHubConnectionDir)

    switch(var(VAR_RESULT))
    {
        case HUB_AREA_CONN_EAST:
            applymovement(OBJ_EVENT_POKABBIE, Rogue_Adventure_PokabbieExit_East)
            break

        case HUB_AREA_CONN_SOUTH:
            applymovement(OBJ_EVENT_POKABBIE, Rogue_Adventure_PokabbieExit_South)
            break

        case HUB_AREA_CONN_WEST:
            applymovement(OBJ_EVENT_POKABBIE, Rogue_Adventure_PokabbieExit_West)
            break
    }
}

movement Rogue_Adventure_PokabbieEnter_East
{
    walk_fast_left * 9
    walk_fast_up * 2
}
movement Rogue_Adventure_PokabbieExit_East
{
    walk_fast_down * 2
    walk_fast_right * 9
}

movement Rogue_Adventure_PokabbieEnter_South
{
    walk_fast_up * 5
}
movement Rogue_Adventure_PokabbieExit_South
{
    walk_fast_down * 5
}

movement Rogue_Adventure_PokabbieEnter_West
{
    walk_fast_right * 9
    walk_fast_up * 2
}
movement Rogue_Adventure_PokabbieExit_West
{
    walk_fast_down * 2
    walk_fast_left * 9
}

movement Pokabbie_Spin_FaceUp
{
    face_left
    delay_1

    face_down
    delay_1
    
    face_right
    delay_1

    face_up
    delay_1

    face_left
    delay_1

    face_down
    delay_1

    face_right
    delay_1

    face_up
    delay_1
}