
const NPC_HOST = 1

const FAIL_ROUND_COUNTER = 100
const STOP_ROUND_COUNTER = 99

const GAME_CATEGORY_SKILL = 0
const GAME_CATEGORY_LUCK = 1

const FLAG_HIDE_HOST = FLAG_TEMP_1

const VAR_CURRENT_ROUND = VAR_TEMP_0
const VAR_GAMESHOW_TRIGGERED = VAR_TEMP_1
const VAR_CURRENT_REWARD_COUNTER = VAR_TEMP_2
const VAR_CURRENT_REWARD_ITEM = VAR_TEMP_3
const VAR_CURRENT_REWARD_COUNT = VAR_TEMP_4
const VAR_GAME_CATEGORY = VAR_TEMP_5

// WTP Vars
const VAR_CURRENT_SPECIES = VAR_TEMP_A

// Triva Var
const VAR_TRIVIA_ANSWER = VAR_TEMP_A

// Voltorb flip vars
const VAR_VOLTORB_FLIP_LVL = VAR_0x8004

// Coin flip vars
const VAR_COIN_FLIP_RESULT = VAR_TEMP_A

// Higher Lower vars
const VAR_HIGHER_LOWER_CURR_NUM = VAR_TEMP_A
const VAR_HIGHER_LOWER_NEXT_NUM = VAR_TEMP_B


mapscripts Rogue_Encounter_GameShow_MapScripts 
{
    MAP_SCRIPT_ON_LOAD: Rogue_Encounter_GameShow_OnLoad
}

script Rogue_Encounter_GameShow_OnLoad
{
    special(GameShow_RestartGameShow)

    setvar(VAR_CURRENT_REWARD_COUNTER, 0)
    special(GameShow_SelectRewardItem)

    clearflag(FLAG_HIDE_HOST)
}

script Rogue_Encounter_GameShow_TriggerIntro
{
    lockall

    setvar(VAR_GAMESHOW_TRIGGERED, 1)
    msgbox(format("¡YUJUUU!"), MSGBOX_DEFAULT)

    applymovement(NPC_HOST, GameShow_Host_Spin)
    waitmovement(0)

    setweather(WEATHER_NONE)
    doweather
    playse(SE_TRUCK_DOOR)
    delay(30)

    playbgm(MUS_HG_GAME_CORNER, TRUE)

    msgbox(format("¡Bienvenid{MASC}o{FEM}a{ENDG} a mi concurso, preparado con muchísimo cariño!\p¡Hoy podrías ganar algunos de estos maravillosos premios!"), MSGBOX_DEFAULT)

    closemessage
    playse(SE_APPLAUSE)
    //waitse
    
    special(GameShow_UpdateRewardVisibility)

    msgbox(format("¡Y ahora, concursante!\n¿Sabes cómo funciona este concurso?"), MSGBOX_YESNO)
    if(var(VAR_RESULT) == YES)
    {
        msgbox(format("¡Maravilloso!\n¡Vamos directos a la acción!"), MSGBOX_DEFAULT)
    }
    else
    {
        msgbox(format("En cada concurso jugaremos a un juego concreto.\pCada juego tiene varias rondas.\pAl completar una ronda ganarás un premio, y podrás elegir entre terminar el concurso o seguir para conseguir premios aún mejores.\p¡Es todo o nada!"), MSGBOX_DEFAULT)
    }

    begindynamicmultichoice
    appenddynamicmultichoice("Juego de habilidad", GAME_CATEGORY_SKILL)
    appenddynamicmultichoice("Juego de suerte", GAME_CATEGORY_LUCK)

    message(format("Y ahora, ¿a qué categoría de juego quieres jugar?"))
    waitmessage
    enddynamicmultichoice(19, 7, 2, FALSE)
    copyvar(VAR_GAME_CATEGORY, VAR_RESULT)


    msgbox(format("En el programa de hoy, el juego será… … …"), MSGBOX_DEFAULT)

    if(var(VAR_GAME_CATEGORY) == GAME_CATEGORY_SKILL)
    {
        special(GameShow_IsTeamTriviaRoundValid)
        if(var(VAR_RESULT) == YES)
        {
            random(5)
        }
        else
        {
            random(4)
        }

        switch(var(VAR_RESULT))
        {
            // Weight this higher as it's more accessible
            case 0:
                call(Rogue_Encounter_GameShow_WhosThatPokemonFlow)

            case 1:
            case 2:
                call(Rogue_Encounter_GameShow_WhosThatCryFlow)

            case 3:
                call(Rogue_Encounter_GameShow_VoltorbFlip)

            case 4:
                call(Rogue_Encounter_GameShow_TeamTrivia)
        }
    }
    else // GAME_CATEGORY_LUCK
    {
        random(2)

        switch(var(VAR_RESULT))
        {
            case 0:
                call(Rogue_Encounter_GameShow_CoinFlip)

            case 1:
                call(Rogue_Encounter_GameShow_HigherLower)
        }
    }

    applymovement(NPC_HOST, GameShow_Host_Spin)
    waitmovement(0)

    msgbox(format("¡Eso es todo por hoy, amigos!\nJe je je"), MSGBOX_DEFAULT)
    special(GameShow_UpdateRewardVisibility)

    applymovement(NPC_HOST, GameShow_Host_Exit)
    waitmovement(0)

    setobjectxy(NPC_HOST, 0, 0)
    setobjectxyperm(NPC_HOST, 0, 0)
    hideobjectat(NPC_HOST, MAP_ROGUE_ENCOUNTER_GAME_SHOW)
    setflag(FLAG_HIDE_HOST)

    releaseall
}

script Rogue_Interact_GiveReward
{
    lock

    if(var(VAR_CURRENT_REWARD_ITEM) == ITEM_NONE)
    {
        msgbox(format("Vaya.\pHay una nota:\p'Quien hace trampas nunca prospera, je je je. - Randoman'"))

        playmoncry(SPECIES_ELECTRODE, CRY_MODE_ENCOUNTER)
        waitmoncry

        removeobject(VAR_LAST_TALKED)

        seteventmon(SPECIES_ELECTRODE, 1)

        special(BattleSetup_StartLegendaryBattle)
        waitstate
    }
    else
    {
        checkitemspace(VAR_CURRENT_REWARD_ITEM, VAR_CURRENT_REWARD_COUNT)
        if(var(VAR_RESULT) == YES)
        {
            finditem(VAR_CURRENT_REWARD_ITEM, VAR_CURRENT_REWARD_COUNT)
            removeobject(VAR_LAST_TALKED)
        }
        else
        {
            // Call this just so it displays the "can't pick up message"
            finditem(VAR_CURRENT_REWARD_ITEM, VAR_CURRENT_REWARD_COUNT)
        }
    }

    release
}

script Rogue_Encounter_GameShow_WhosThatPokemonFlow
{
    msgbox(format("¡¿Quién es ese Pokémon?!\pHabrá 6 rondas y tendrás que adivinar el Pokémon según la pista que te demos.\pY ahora…"), MSGBOX_DEFAULT)

    while(var(VAR_CURRENT_ROUND) <= 50)
    {
        buffernumberstring(STR_VAR_1, VAR_CURRENT_ROUND)
        msgbox(format("¡Ronda {STR_VAR_1}!"))

        special(GameShow_SelectRandomSpecies)
        specialvar(VAR_CURRENT_SPECIES, GameShow_BufferSpecies)

        //  rounds of sillouettes
        message(format("¿De qué Pokémon es esta silueta?"))
        showmonpic(VAR_CURRENT_SPECIES, 10, 3, TRUE)
        delay(20)
        waitmessage
        waitbuttonpress
        hidemonpic


        message(format("¿Qué Pokémon era?"))
        waitmessage

        begindynamicmultichoice
        special(GameShow_AppendSpeciesMultichoiceOptions)
        enddynamicmultichoice(19, 4, 4, FALSE)

        msgbox(format("La respuesta es…"))

        if(var(VAR_RESULT) == YES)
        {
            playse(SE_DING_DONG)
            waitse

            msgbox(format("¡Correcto!"))
            addvar(VAR_CURRENT_ROUND, 1)
            addvar(VAR_CURRENT_REWARD_COUNTER, 1)

            call(Rogue_Encounter_GameShow_DisplayReward)
        }
        else
        {
            playse(SE_BOO)
            waitse

            bufferspeciesname(STR_VAR_1, VAR_CURRENT_SPECIES)

            msgbox(format("¡Incorrecto!\nLa respuesta era {STR_VAR_1}."))
            setvar(VAR_CURRENT_ROUND, FAIL_ROUND_COUNTER)
        }
    }
}

script Rogue_Encounter_GameShow_WhosThatCryFlow
{
    msgbox(format("¡¿De quién es ese grito?!\pHabrá 6 rondas y tendrás que adivinar el Pokémon por su grito.\pY ahora…"), MSGBOX_DEFAULT)

    while(var(VAR_CURRENT_ROUND) <= 50)
    {
        buffernumberstring(STR_VAR_1, VAR_CURRENT_ROUND)
        msgbox(format("¡Ronda {STR_VAR_1}!"))

        special(GameShow_SelectRandomSpecies)
        specialvar(VAR_CURRENT_SPECIES, GameShow_BufferSpecies)

        // rounds of guess the cry
        message(format("¿De qué Pokémon es este grito?"))
        waitmessage
        delay(30)

        playmoncry(VAR_CURRENT_SPECIES, CRY_MODE_NORMAL)
        waitmoncry
        delay(90)

        playmoncry(VAR_CURRENT_SPECIES, CRY_MODE_NORMAL)
        waitmoncry
        delay(90)

        playmoncry(VAR_CURRENT_SPECIES, CRY_MODE_NORMAL)
        waitmoncry
        delay(90)


        message(format("¿De qué Pokémon era ese grito?"))
        waitmessage

        begindynamicmultichoice
        special(GameShow_AppendSpeciesMultichoiceOptions)
        enddynamicmultichoice(20, 7, 4, FALSE)

        msgbox(format("La respuesta es…"))

        if(var(VAR_RESULT) == YES)
        {
            playse(SE_DING_DONG)
            waitse

            msgbox(format("¡Correcto!"))
            addvar(VAR_CURRENT_ROUND, 1)
            addvar(VAR_CURRENT_REWARD_COUNTER, 1)

            call(Rogue_Encounter_GameShow_DisplayReward)
        }
        else
        {
            playse(SE_BOO)
            waitse

            bufferspeciesname(STR_VAR_1, VAR_CURRENT_SPECIES)

            msgbox(format("¡Incorrecto!\nLa respuesta era {STR_VAR_1}."))
            setvar(VAR_CURRENT_ROUND, FAIL_ROUND_COUNTER)
        }
    }
}

script Rogue_Encounter_GameShow_VoltorbFlip
{
    msgbox(format("¡Voltorb Flip!\pHabrá 3 rondas y tendrás que conseguir todas las cartas de 2 y 3 del tablero sin levantar ningún Voltorb.\pY ahora…"), MSGBOX_DEFAULT)

    setvar(VAR_VOLTORB_FLIP_LVL, 0)

    while(var(VAR_CURRENT_ROUND) <= 50)
    {
        buffernumberstring(STR_VAR_1, VAR_CURRENT_ROUND)
        msgbox(format("¡Ronda {STR_VAR_1}!"))

        special(Special_ViewVoltorbFlip)
        waitstate

        if(var(VAR_RESULT) == YES)
        {
            playse(SE_DING_DONG)
            waitse

            msgbox(format("¡Enhorabuena!"))
            addvar(VAR_CURRENT_ROUND, 1)
            addvar(VAR_CURRENT_REWARD_COUNTER, 2)
            addvar(VAR_VOLTORB_FLIP_LVL, 2)

            call(Rogue_Encounter_GameShow_DisplayReward)
        }
        else
        {
            playse(SE_BOO)
            waitse

            msgbox(format("¡Oh, no!"))
            setvar(VAR_CURRENT_ROUND, FAIL_ROUND_COUNTER)
        }
    }
}

script Rogue_Encounter_GameShow_TeamTrivia 
{
    msgbox(format("¡Preguntas del Equipo!\pHabrá 6 rondas; te haremos una pregunta sobre tu equipo Pokémon y solo tienes que dar la respuesta correcta.\p¡Así de fácil!\pY ahora…"), MSGBOX_DEFAULT)

    while(var(VAR_CURRENT_ROUND) <= 50)
    {
        buffernumberstring(STR_VAR_1, VAR_CURRENT_ROUND)
        msgbox(format("¡Ronda {STR_VAR_1}!"))

        bufferstring(STR_VAR_1, format("1"))
        bufferstring(STR_VAR_2, format("2"))
        bufferstring(STR_VAR_3, format("3"))
        setvar(VAR_TRIVIA_ANSWER, 0)
        

        special(GameShow_NextTriviaQuestion)

        switch(var(VAR_RESULT))
        {
            case 0:
                message(format("Y bien, ¿qué quieres apostar?"))

            default:
                message(format("???"))
        }
        call(Rogue_Encounter_GameShow_TeamTrivia_GetResult)

        if(var(VAR_RESULT) == YES)
        {
            playse(SE_DING_DONG)
            waitse

            msgbox(format("¡Correcto!"))
            addvar(VAR_CURRENT_ROUND, 1)
            addvar(VAR_CURRENT_REWARD_COUNTER, 1)

            call(Rogue_Encounter_GameShow_DisplayReward)
        }
        else
        {
            playse(SE_BOO)
            waitse

            switch(var(VAR_TRIVIA_ANSWER))
            {
                case 0:
                    msgbox(format("¡Incorrecto!\nLa respuesta era {STR_VAR_1}."))
                case 1:
                    msgbox(format("¡Incorrecto!\nLa respuesta era {STR_VAR_2}."))
                case 2:
                    msgbox(format("¡Incorrecto!\nLa respuesta era {STR_VAR_3}."))
            }

            setvar(VAR_CURRENT_ROUND, FAIL_ROUND_COUNTER)
        }
    }
}

script Rogue_Encounter_GameShow_TeamTrivia_GetResult
{
    waitmessage
    multichoice(20, 6, MULTI_EXPAND3, NO)

    switch(var(VAR_RESULT))
    {
        case 0:
        case 1:
        case 2:
            if(var(VAR_RESULT) == VAR_TRIVIA_ANSWER)
            {
                setvar(VAR_RESULT, YES)
            }
            else
            {
                setvar(VAR_RESULT, NO)
            }
        case MULTI_B_PRESSED:
            setvar(VAR_RESULT, NO)
    }

    msgbox(format("La respuesta es…"))
}

script Rogue_Encounter_GameShow_DisplayReward
{
    special(GameShow_UpdateRewardVisibility)

    copyvar(VAR_0x8004, VAR_CURRENT_REWARD_ITEM)
    copyvar(VAR_0x8005, VAR_CURRENT_REWARD_COUNT)
    special(GameShow_SelectRewardItem)
    bufferitemnameplural(STR_VAR_1, VAR_0x8004, VAR_0x8005) // current reward if stop now
    bufferitemnameplural(STR_VAR_2, VAR_CURRENT_REWARD_ITEM, VAR_CURRENT_REWARD_COUNT) // next reward

    if(var(VAR_CURRENT_REWARD_ITEM) == ITEM_NONE)
    {
        msgbox(format("Si te plantas ahora, puedes llevarte…\p¡{STR_VAR_1}!\pO puedes arriesgarte para ganar además…\p¡{STR_VAR_2}!\n¡O algo aún mejor!\n¡Todo o nada!\pY bien, ¿te arriesgas a jugar otra ronda?"), MSGBOX_YESNO)
    
        if(var(VAR_RESULT) == NO)
        {
            copyvar(VAR_CURRENT_REWARD_ITEM, VAR_0x8004)
            copyvar(VAR_CURRENT_REWARD_COUNT, VAR_0x8005)
            setvar(VAR_CURRENT_ROUND, STOP_ROUND_COUNTER)
        }
    }
    else
    {
        if(var(VAR_CURRENT_REWARD_COUNTER) >= 6)
        {
            msgbox(format("¡Acabas de ganar…\p{STR_VAR_1}!"))
            setvar(VAR_RESULT, NO)
            copyvar(VAR_CURRENT_REWARD_ITEM, VAR_0x8004)
            copyvar(VAR_CURRENT_REWARD_COUNT, VAR_0x8005)
            setvar(VAR_CURRENT_ROUND, STOP_ROUND_COUNTER)

            quest_trigger(QUEST_TRIGGER_MAP_SPECIFIC_EVENT)
        }
        else
        {
            msgbox(format("¡Acabas de ganar…\p{STR_VAR_1}!\pEn la siguiente ronda podrías ganar además…\p¡{STR_VAR_2}!\p¿Te arriesgas a jugar otra ronda?"), MSGBOX_YESNO)
        
            if(var(VAR_RESULT) == NO)
            {
                copyvar(VAR_CURRENT_REWARD_ITEM, VAR_0x8004)
                copyvar(VAR_CURRENT_REWARD_COUNT, VAR_0x8005)
                setvar(VAR_CURRENT_ROUND, STOP_ROUND_COUNTER)
            }
        }
    }
}

script Rogue_Encounter_GameShow_CoinFlip
{
    msgbox(format("¡Cara o Cruz!\pHabrá 6 rondas; solo tienes que adivinar si la moneda saldrá cara o cruz.\pY ahora…"), MSGBOX_DEFAULT)

    while(var(VAR_CURRENT_ROUND) <= 50)
    {
        buffernumberstring(STR_VAR_1, VAR_CURRENT_ROUND)
        msgbox(format("¡Ronda {STR_VAR_1}!"))

        begindynamicmultichoice
        appenddynamicmultichoice("Cara", 0)
        appenddynamicmultichoice("Cruz", 1)

        message(format("¿Qué crees que saldrá en la moneda?"))
        waitmessage
        enddynamicmultichoice(19, 7, 2, FALSE)
        copyvar(VAR_COIN_FLIP_RESULT, VAR_RESULT)

        random(2)
        if(var(VAR_COIN_FLIP_RESULT) == 1) // invert for tails
        {
            if(var(VAR_RESULT) == 1)
            {
                setvar(VAR_RESULT, 0)
            }
            else
            {
                setvar(VAR_RESULT, 1)
            }
        }

        if(var(VAR_RESULT) == TRUE)
        {
            playse(SE_DING_DONG)
            waitse

            msgbox(format("¡Correcto!"))
            addvar(VAR_CURRENT_ROUND, 1)
            addvar(VAR_CURRENT_REWARD_COUNTER, 1)

            call(Rogue_Encounter_GameShow_DisplayReward)
        }
        else
        {
            playse(SE_BOO)
            waitse

            msgbox(format("¡Oh, no!"))
            setvar(VAR_CURRENT_ROUND, FAIL_ROUND_COUNTER)
        }
    }
}

script Rogue_Encounter_GameShow_HigherLower
{
    msgbox(format("¡Mayor o Menor!\pHabrá 6 rondas; te enseñaré un número entre 1 y 100 y tendrás que decirme si crees que el siguiente será mayor o menor.\pY ahora…"), MSGBOX_DEFAULT)  

    // rng initial num
    random(100)
    addvar(VAR_RESULT, 1)
    copyvar(VAR_HIGHER_LOWER_CURR_NUM, VAR_RESULT)

    while(var(VAR_CURRENT_ROUND) <= 50)
    {
        buffernumberstring(STR_VAR_1, VAR_CURRENT_ROUND)
        msgbox(format("¡Ronda {STR_VAR_1}!"))

        // rng next num
        random(100)
        addvar(VAR_RESULT, 1)
        copyvar(VAR_HIGHER_LOWER_NEXT_NUM, VAR_RESULT)

        begindynamicmultichoice
        appenddynamicmultichoice("Mayor", 0)
        appenddynamicmultichoice("Menor", 1)

        buffernumberstring(STR_VAR_1, VAR_HIGHER_LOWER_CURR_NUM)
        buffernumberstring(STR_VAR_2, VAR_HIGHER_LOWER_NEXT_NUM)
        message(format("El número actual es {STR_VAR_1}.\n¿Cómo crees que será el siguiente?"))
        waitmessage
        enddynamicmultichoice(19, 7, 2, FALSE)

        if(var(VAR_RESULT) == 0) // higher
        {
            if(var(VAR_HIGHER_LOWER_NEXT_NUM) > VAR_HIGHER_LOWER_CURR_NUM)
            {
                setvar(VAR_RESULT, TRUE)
            }
            else
            {
                setvar(VAR_RESULT, FALSE)
            }
        }
        else // lower
        {
            if(var(VAR_HIGHER_LOWER_NEXT_NUM) < VAR_HIGHER_LOWER_CURR_NUM)
            {
                setvar(VAR_RESULT, TRUE)
            }
            else
            {
                setvar(VAR_RESULT, FALSE)
            }
        }

        buffernumberstring(STR_VAR_1, VAR_HIGHER_LOWER_NEXT_NUM)

        if(var(VAR_RESULT) == TRUE)
        {
            playse(SE_DING_DONG)
            waitse

            msgbox(format("¡Correcto!\n¡El nuevo número era {STR_VAR_1}!"))
            addvar(VAR_CURRENT_ROUND, 1)
            addvar(VAR_CURRENT_REWARD_COUNTER, 1)

            call(Rogue_Encounter_GameShow_DisplayReward)
        }
        else
        {
            playse(SE_BOO)
            waitse

            msgbox(format("¡Oh, no!\n¡El nuevo número era {STR_VAR_1}!"))
            setvar(VAR_CURRENT_ROUND, FAIL_ROUND_COUNTER)
        }

        copyvar(VAR_HIGHER_LOWER_CURR_NUM, VAR_HIGHER_LOWER_NEXT_NUM)
    }
}

movement GameShow_Host_Spin
{
    face_right
    delay_1

    face_up
    delay_1

    face_left
    delay_1

    face_down
    delay_1
    
    face_right
    delay_1

    face_up
    delay_1

    face_left
    delay_1

    face_down
    delay_1

    jump_in_place_down
}

movement GameShow_Host_Exit {
    jump_2_up * 2
}