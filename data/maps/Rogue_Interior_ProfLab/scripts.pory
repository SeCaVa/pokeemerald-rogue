const FLAG_HIDE_BIRCH = FLAG_TEMP_1
const FLAG_HIDE_RUIN_MANIAC = FLAG_TEMP_2

const VAR_FRAME_STATE = VAR_TEMP_0

const OBJ_EVENT_BIRCH = 1
const OBJ_EVENT_ASSISTANT = 2
const OBJ_EVENT_RUIN_MANIAC = 3

mapscripts Rogue_Interior_ProfLab_MapScripts
{
    MAP_SCRIPT_ON_LOAD: Rogue_Interior_ProfLab_OnMapLoad
    MAP_SCRIPT_ON_FRAME_TABLE 
    [
        VAR_FRAME_STATE, 0: Rogue_Interior_ProfLab_FrameState0
    ]
}

script Rogue_Interior_ProfLab_OnMapLoad
{
    if(var(VAR_ROGUE_INTRO_STATE) == ROGUE_INTRO_STATE_EXPLORE)
    {
        clearflag(FLAG_HIDE_RUIN_MANIAC)
    }
    else
    {
        setflag(FLAG_HIDE_RUIN_MANIAC)
    }

    if(var(VAR_ROGUE_INTRO_STATE) == ROGUE_INTRO_STATE_CATCH_MON)
    {
        setflag(FLAG_HIDE_BIRCH)
    }
    else
    {
        clearflag(FLAG_HIDE_BIRCH)
    }

    if(var(VAR_ROGUE_INTRO_STATE) == ROGUE_INTRO_STATE_REPORT_TO_PROF)
    {
        setvar(VAR_FRAME_STATE, 0)
    }
    else
    {
        setvar(VAR_FRAME_STATE, 1)
    }
}

script Rogue_Interior_ProfLab_FrameState0
{
    lock

    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceUp)
    waitmovement(0)

    msgbox(format("ELM: ¡Ya está!\p¡He de decir que tu técnica de captura me ha impresionado!\p¡No se me ocurre mejor Entrenador para ir de Aventuras en nombre de {POKEMON_HUB}!"))
    msgbox(format("Bien, {PLAYER}.\n¿Quieres que te explique cómo funcionan las Aventuras?"), MSGBOX_YESNO)

    if(var(VAR_RESULT) == YES)
    {
        call(Rogue_Interior_ProfLab_TalkBirch_AdventureExplain)
    }
    else
    {
        msgbox(format("¡Tienes mejor memoria de lo que esperaba!\n¡Fuhahaha!"))
    }

    msgbox(format("¡Antes de irte, llévate esto!"))
    giveitem(ITEM_POKE_BALL, 10)
    giveitem(ITEM_POTION, 5)

    msgbox(format("¡Y por último, tu propia Pokédex!"))
    
    if(flag(FLAG_SYS_POKEDEX_GET))
    {
        msgbox(format("¡Vaya, parece que Pokabbie ya te ha dado una Pokédex!\p¡Entonces supongo que esta no la necesitas!\n¡Fuhahaha!"))
    }
    else
    {
        callnative(Rogue_PushPopup_UnlockPokedex)
        call(Rogue_Common_DisplayPopups)
        setflag(FLAG_SYS_POKEDEX_GET)
    }
    setflag(FLAG_SYS_POKEMON_GET)

    msgbox(format("¡Además, esa Pokédex se ha actualizado hace poco!\p¡Puede mostrarte las características, movimientos, evoluciones y más de los Pokémon!"))
    msgbox(format("¡Ya deberías estar list{MASC}o{FEM}a{ENDG} para partir!\p¡Buena suerte, {PLAYER}!"))
    closemessage

    addvar(VAR_ROGUE_INTRO_STATE, 1)
    addvar(VAR_FRAME_STATE, 1)

    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceDown)
    applymovement(OBJ_EVENT_ASSISTANT, IntroAssistant0)
    waitmovement(0)

    setvar(VAR_0x8004, 0)
    special(BufferMonNickname)
    msgbox(format("¡Hola, {PLAYER}!\pA tu {STR_VAR_1} parece que le encanta pasear fuera de su Poké Ball.\p¿Quieres que {STR_VAR_1} te siga?"), MSGBOX_YESNO)

    if(var(VAR_RESULT) == YES)
    {
        setflag(FLAG_SYS_SHOW_POKE_FOLLOWER)
        special(Rogue_SetupFollowParterMonObjectEvent)

        msgbox(format("¡{STR_VAR_1} parece muy feliz!"))
    }
    else
    {
        clearflag(FLAG_SYS_SHOW_POKE_FOLLOWER)
        special(Rogue_SetupFollowParterMonObjectEvent)

        msgbox(format("Vaya…\nSi cambias de idea, dímelo."))
    }
    closemessage

    applymovement(OBJ_EVENT_ASSISTANT, IntroAssistant1)
    waitmovement(0)


    release
}

movement IntroAssistant0
{
    walk_left * 4
    walk_up * 4
}

movement IntroAssistant1
{
    walk_right
    face_left
}

script Rogue_Interior_ProfLab_TalkBirch
{
    lock
    faceplayer
    msgbox(format("ELM: ¡Hola, {PLAYER}!\p¿Quieres que te explique cómo funcionan las Aventuras?"), MSGBOX_YESNO)

    if(var(VAR_RESULT) == YES)
    {
        call(Rogue_Interior_ProfLab_TalkBirch_AdventureExplain)
    }


    release
}

script Rogue_Interior_ProfLab_TalkAssistant
{
    lock
    faceplayer

    if(var(VAR_ROGUE_INTRO_STATE) < ROGUE_INTRO_STATE_REPORT_TO_PROF)
    {
        msgbox(format("¡Hola, {PLAYER}!\p¡Espero que estés bien!\nMe han dicho que te diste un golpe en la cabeza."))
    }
    else
    {
        setvar(VAR_0x8004, 0)
        special(BufferMonNickname)
        if(flag(FLAG_SYS_SHOW_POKE_FOLLOWER))
        {
            msgbox(format("¡Hola, {PLAYER}!\p¿Quieres que {STR_VAR_1} vuelva a su Poké Ball?"), MSGBOX_YESNO)
            if(var(VAR_RESULT) == YES)
            {
                clearflag(FLAG_SYS_SHOW_POKE_FOLLOWER)
            }
        }
        else
        {
            msgbox(format("¡Hola, {PLAYER}!\p¿Quieres que {STR_VAR_1} te siga?"), MSGBOX_YESNO)
            if(var(VAR_RESULT) == YES)
            {
                setflag(FLAG_SYS_SHOW_POKE_FOLLOWER)
            }
        }
        special(Rogue_SetupFollowParterMonObjectEvent)
    }

    release
}

script Rogue_Interior_ProfLab_TalkBirch_AdventureExplain
{
    msgbox(format("Como quizá recuerdes, el mundo fuera de {POKEMON_HUB} se ha vuelto un poco extraño.\pLas rutas se mezclan y pueden aparecer en un orden aleatorio distinto cada vez que partes de Aventura."))
    msgbox(format("Cuando partas de Aventura, verás que el nivel de tus Pokémon se reinicia.\pAun así, seguirán conociendo los mismos movimientos."))
    msgbox(format("Los objetos de tu mochila también tienen algo extraño.\p¡Cada vez que partes de Aventura, parece que el estado de tu Mochila queda guardado!\pCuando vuelvas a {POKEMON_HUB}, tu mochila estará exactamente igual que cuando te fuiste.\pPor ejemplo, imagina que encuentras una Superpoción durante la Aventura.\p¡Al volver, esa Superpoción habrá desaparecido de tu Mochila como por arte de magia!\pY al revés también. Si llevas una Poké Ball en la Mochila al salir y la usas en tu Aventura, ¡al volver verás que ha reaparecido en tu Mochila!"))
    msgbox(format("Como era de esperar, ¡los Entrenadores siguen con muchas ganas de combatir!\pAsí que ten cuidado y entrena bien a tus Pokémon."))
    msgbox(format("¡Es todo muy extraño!\p¡Seguimos investigando para averiguar qué está pasando!"))
}

script Rogue_Interior_ProfLab_TriggerIntro0
{
    lock
    applymovement(OBJ_EVENT_ID_PLAYER, PlayerIntro0)
    waitmovement(0)
    call(Rogue_Interior_ProfLab_TriggerIntroInternal)
    release
}

script Rogue_Interior_ProfLab_TriggerIntro1
{
    lock
    applymovement(OBJ_EVENT_ID_PLAYER, PlayerIntro1)
    waitmovement(0)
    call(Rogue_Interior_ProfLab_TriggerIntroInternal)
    release
}

script Rogue_Interior_ProfLab_TriggerIntro2
{
    lock
    applymovement(OBJ_EVENT_ID_PLAYER, PlayerIntro2)
    waitmovement(0)
    call(Rogue_Interior_ProfLab_TriggerIntroInternal)
    release
}

script Rogue_Interior_ProfLab_TriggerIntroInternal
{
    msgbox(format("ELM: ¡Hola, {PLAYER}!\p¡Parece que ya has refrescado un poco la memoria!\pAhora que {POKEMON_HUB} está bien asentado, necesitamos a alguien que salga de Aventura a explorar y reunir recursos.\pSi lo conseguimos, podremos construir y ampliar el pueblo.\p¡Y ahí es donde entras tú, {PLAYER}!\pPara ello, necesitarás un Pokémon Compañero…"))

    playbgm(MUS_NONE, FALSE)
    msgbox(format("¡PROFEEEEESOR!"))
    closemessage

    setobjectxy(OBJ_EVENT_RUIN_MANIAC, 4, 11)
    //showobjectat(OBJ_EVENT_RUIN_MANIAC, MAP_ROGUE_INTERIOR_PROF_LAB)
    playbgm(MUS_HELP, FALSE)
    
    applymovement(OBJ_EVENT_RUIN_MANIAC, RuinManiacIntro0)
    waitmovement(0)

    msgbox(format("¡L- L- Los Pokémon nos invaden!"))

    applymovement(OBJ_EVENT_BIRCH, BirchIntro0)
    waitmovement(0)

    msgbox(format("ELM: ¡¿Qué quieres decir?!\pEsto no pinta bien, {PLAYER}.\p¡Será mejor que vayamos a ayudar!"))
    closemessage

    applymovement(OBJ_EVENT_RUIN_MANIAC, RuinManiacIntro1)
    applymovement(OBJ_EVENT_BIRCH, BirchIntro1)
    waitmovement(0)

    hideobjectat(OBJ_EVENT_RUIN_MANIAC, MAP_ROGUE_INTERIOR_PROF_LAB)
    hideobjectat(OBJ_EVENT_BIRCH, MAP_ROGUE_INTERIOR_PROF_LAB)
    setflag(FLAG_HIDE_RUIN_MANIAC)
    setflag(FLAG_HIDE_BIRCH)

    addvar(VAR_ROGUE_INTRO_STATE, 1)
}

movement PlayerIntro0
{
    walk_right
    walk_up * 2
}

movement PlayerIntro1
{
    walk_up * 2
}

movement PlayerIntro2
{
    walk_left
    walk_up * 2
}

movement RuinManiacIntro0
{
    walk_fast_up * 6
}

movement RuinManiacIntro1
{
    walk_fast_down * 10
}

movement BirchIntro0
{
    emote_exclamation_mark
}

movement BirchIntro1
{
    walk_fast_right
    walk_fast_down * 10
}