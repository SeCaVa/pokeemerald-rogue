const FLAG_HAS_BATTLED = FLAG_TEMP_1

const VAR_CHOSEN_WAGER = VAR_TEMP_0
const VAR_WAGER_PARAM0 = VAR_TEMP_1
const VAR_WAGER_PARAM1 = VAR_TEMP_2

const NPC_OBJ_JOEY = 1

mapscripts Rogue_Encounter_BattleSim_MapScripts {}

script Rogue_Encounter_BattleSim_TalkJoey
{
    lock
    faceplayer

    if(flag(FLAG_HAS_BATTLED))
    {
        msgbox(format("¡Qué combate tan divertido!\n¡Tenemos que repetirlo algún día!"))
    }
    else
    {
        msgbox(format("¡Hola!\p¡Todavía estoy aprendiendo a Combatir, así que me gusta practicar con este Simulador de Combate!\pAunque me gusta darle un poco de emoción…"))
        turnobject(NPC_OBJ_JOEY, DIR_WEST)
        msgbox(format("Si quieres combatir conmigo, conéctate a ese PC de allí."))
    }

    release
}

script Rogue_Encounter_BattleSim_InteractMachine
{
    lock

    if(flag(FLAG_HAS_BATTLED))
    {
        msgbox(format("El Simulador de Combate está apagado."))
    }
    else
    {
        setvar(VAR_LAST_TALKED, NPC_OBJ_JOEY)
        turnobject(NPC_OBJ_JOEY, DIR_WEST)

        setvar(VAR_RESULT, 2)

        while(var(VAR_RESULT) == 2)
        {
            message(format("¿Quieres probar el Simulador de Combate?"))
            waitmessage
            multichoice(20, 6, MULTI_YESNOINFO, NO)

            switch(var(VAR_RESULT))
            {
                case 0: // Yes
                    // Let it fall through
                    setvar(VAR_RESULT, 0)

                case 1: // No
                case MULTI_B_PRESSED:
                    msgbox(format("Ah, vale…\nSi cambias de idea, avísame."), MSGBOX_DEFAULT)

                case 2: // Info
                    msgbox(format("En el Simulador de Combate, cada uno recibirá 3 Pokémon aleatorios de {LV}50.\pDespués es muy sencillo.\n¡Solo tienes que ganar!\p¡Me gusta apostar algo en el Combate para que sea más divertido!\pPero no te preocupes, ¡te dejaré elegir qué apostar!"))
            }
        }

        if(var(VAR_RESULT) == 0)
        {
            call(Rogue_Encounter_BattleSim_ChooseWager)
            if(var(VAR_RESULT) == YES)
            {
                call(Rogue_Encounter_BattleSim_BeginBattle)
            }
        }
    }

    release
}

script Rogue_Encounter_BattleSim_ChooseWager
{
    setvar(VAR_RESULT, 2)

    while(var(VAR_RESULT) == 2)
    {
        message(format("Y bien, ¿qué quieres apostar?"))
        waitmessage
        multichoice(20, 6, MULTI_BATTLE_WAGER, NO)

        switch(var(VAR_RESULT))
        {
            case 0: // money
                copyvar(VAR_CHOSEN_WAGER, VAR_RESULT)
                call(Rogue_Encounter_BattleSim_ChooseWager_Money)
                if(var(VAR_RESULT) == NO)
                {
                    // loop again
                    setvar(VAR_RESULT, 2)
                }

            case 1: // IVs
                copyvar(VAR_CHOSEN_WAGER, VAR_RESULT)
                call(Rogue_Encounter_BattleSim_ChooseWager_IVs)
                if(var(VAR_RESULT) == NO)
                {
                    // loop again
                    setvar(VAR_RESULT, 2)
                }

            case 2: // Items
                copyvar(VAR_CHOSEN_WAGER, VAR_RESULT)
                call(Rogue_Encounter_BattleSim_ChooseWager_Items)
                if(var(VAR_RESULT) == NO)
                {
                    // loop again
                    setvar(VAR_RESULT, 2)
                }
                
            case MULTI_B_PRESSED:
                msgbox(format("Ah, vale…\nSi cambias de idea, avísame."), MSGBOX_DEFAULT)
                setvar(VAR_RESULT, NO)
        }
    }
}

script Rogue_Encounter_BattleSim_ChooseWager_Money
{
    showmoneybox(0,0)

    if(var(VAR_ROGUE_DIFFICULTY) >= ROGUE_ELITE_START_DIFFICULTY)
    {
        msgbox(format("¿Dinero?\n¡Claro!\pSi pierdes, me quedo con la mitad de tu dinero.\pSi ganas, te doy ¥15000. ¿Qué te parece?"), MSGBOX_YESNO)
    }
    elif(var(VAR_ROGUE_DIFFICULTY) >= ROGUE_GYM_MID_DIFFICULTY)
    {
        msgbox(format("¿Dinero?\n¡Claro!\pSi pierdes, me quedo con la mitad de tu dinero.\pSi ganas, te doy ¥10000. ¿Qué te parece?"), MSGBOX_YESNO)
    }
    else
    {
        msgbox(format("¿Dinero?\n¡Claro!\pSi pierdes, me quedo con la mitad de tu dinero.\pSi ganas, te doy ¥5000. ¿Qué te parece?"), MSGBOX_YESNO)
    }

    hidemoneybox
}

script Rogue_Encounter_BattleSim_ChooseWager_IVs
{
    bufferspeciesname(STR_VAR_1, SPECIES_RATTATA)
    msgbox(format("¿IV?\n¡Claro!\pElige a uno de tus Pokémon.\pSi pierdes, me quedo con parte de sus IV para mi {STR_VAR_1}.\pSi ganas, le daré unas Tartas a tu Pokémon para subir sus IV. ¿Qué te parece?"), MSGBOX_YESNO)

    if(var(VAR_RESULT) == YES)
    {
        msgbox(format("¿Qué Pokémon quieres apostar?"))
        special(ChoosePartyMon)
        waitstate

        if(var(VAR_0x8004) == PARTY_NOTHING_CHOSEN)
        {
            setvar(VAR_RESULT, NO)
        }
        else
        {
            setvar(VAR_RESULT, YES)
            copyvar(VAR_WAGER_PARAM0, VAR_0x8004)
        }
    }
}

script Rogue_Encounter_BattleSim_ChooseWager_Items
{
    special(Rogue_BattleSim_WagerItem)


    bufferitemnameplural(STR_VAR_1, VAR_WAGER_PARAM0, VAR_WAGER_PARAM1)
    msgbox(format("¿Objetos?\n¡Claro!\pSi pierdes, me quedo con unos cuantos objetos de tu mochila.\pSi ganas, te doy {STR_VAR_1}. ¿Qué te parece?"), MSGBOX_YESNO)

    if(var(VAR_RESULT) == YES)
    {
        // Check we can add a stack of a new item (use yellow shard as we won't normally encounter this item)
        checkitemspace(ITEM_YELLOW_SHARD, 1)
        if(var(VAR_RESULT) == NO)
        {
            msgbox(format("Vaya, parece que tu mochila está llena.\pSi ganas, no podría darte ningún objeto.\p¿Seguro que quieres continuar?"), MSGBOX_YESNO)
        }
    }
}

script Rogue_Encounter_BattleSim_BeginBattle
{
    msgbox(format("¡Vale!\n¡Vamos allá!"))

    trainerbattle(TRAINER_BATTLE_SINGLE_NO_INTRO_TEXT, TRAINER_ROGUE_DYNAMIC, 0, gPlaceholder_Trainer_PostBattleTaunt)

    if(var(VAR_RESULT) == YES)
    {
        msgbox(format("¡Hala!\n¡Combates de maravilla!\p¡Aquí tienes!"))
        quest_trigger(QUEST_TRIGGER_MAP_SPECIFIC_EVENT)
    }
    else
    {
        msgbox(format("¡Bieeen!\n¡He ganado!"))
    }

    setflag(FLAG_HAS_BATTLED)

    switch(var(VAR_CHOSEN_WAGER))
    {
        case 0: // money
            special(Rogue_BattleSim_HandleItemMoney)

        case 1: // IVs
            special(Rogue_BattleSim_HandleItemIVs)

        case 2: // Items
            special(Rogue_BattleSim_HandleItemWager)
    }
}