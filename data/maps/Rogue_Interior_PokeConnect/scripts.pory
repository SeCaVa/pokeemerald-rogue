const VAR_STOP_TUTORIAL = VAR_TEMP_0

mapscripts Rogue_Interior_PokeConnect_MapScripts 
{
    MAP_SCRIPT_ON_LOAD: Rogue_Interior_PokeConnect_OnMapLoad
}

script Rogue_Interior_PokeConnect_OnMapLoad
{
    if(flag(FLAG_ROGUE_ASSISTANT_TUTORIAL))
    {
        setvar(VAR_STOP_TUTORIAL, 1)
    }
    else
    {
        setvar(VAR_STOP_TUTORIAL, 0)
    }
}

script Rogue_Interior_PokeConnect_TalkMultiplayer
{
    lock

    special(Rogue_IsMultiplayerActive)
    if(var(VAR_RESULT) == TRUE)
    {
        msgbox(format("¡Hola, {PLAYER}!\p¡Espero que estés disfrutando de tu Aventura Multijugador!"), MSGBOX_DEFAULT)
    
        special(Rogue_IsMultiplayerHost)
        if(var(VAR_RESULT) == TRUE)
        {
            msgbox(format("¿Quieres dejar de ser Anfitrión?"), MSGBOX_YESNO)
        }
        else
        {
            msgbox(format("¿Quieres desconectarte y volver a casa?"), MSGBOX_YESNO)
        }

        if(var(VAR_RESULT) == TRUE)
        {
            special(Rogue_CloseMultiplayer)
            msgbox(format("¡Aquí estás!\p¡Espero que hayas disfrutado de tus Aventuras Multijugador!"), MSGBOX_DEFAULT)
        }
    }
    else
    {
        msgbox(format("¡Hola, {PLAYER}!\p¡Puedo ayudarte a preparar Aventuras Multijugador para ti y un amigo!"), MSGBOX_DEFAULT)

        msgbox(format("{COLOR RED}¡ATENCIÓN!\n{COLOR DARK_GRAY}Esta función aún está en fase Alfa.\pSigue en desarrollo, así que algunas partes pueden no funcionar bien o faltar.\pGuarda a menudo y haz copias de seguridad de tu partida mientras la uses."))

        call(Rogue_Common_WaitForRogueAssistant)

        if(var(VAR_RESULT) == TRUE)
        {
            call(Common_EventScript_SaveGame)
            if(var(VAR_RESULT) == YES)
            {
                message(format("Decidid quién de vosotros será el Anfitrión del Grupo.\pLos demás jugadores deben elegir Unirse al Grupo."))
                waitmessage

                multichoice(16, 6, MULTI_LINK_HOST_JOIN, FALSE)

                switch(var(VAR_RESULT))
                {
                    case 0: // Join
                        message(format("Configúralo ahora en Rogue Assistant\n… … Botón B: Cancelar"))
                        waitmessage

                        special(Rogue_JoinMultiplayer)
                        waitstate

                        if(var(VAR_RESULT) == TRUE)
                        {
                            msgbox(format("¡Todo listo!\n¡Diviértete en tus Aventuras!"))
                        }

                    case 1: // Host
                        message(format("Configúralo ahora en Rogue Assistant\n… … Botón B: Cancelar"))
                        waitmessage

                        special(Rogue_HostMultiplayer)
                        waitstate

                        if(var(VAR_RESULT) == TRUE)
                        {
                            msgbox(format("¡Todo listo!\n¡Ya puede unirse un amigo a tus Aventuras!"))
                        }

                    case 2: // Exit
                        setvar(VAR_RESULT, FALSE)

                }
            }
        }

        if(var(VAR_RESULT) == FALSE)
        {
            special(Rogue_GetLastMultiplayerConnectError)
            
            switch(var(VAR_RESULT))
            {
                case 1: // CONN_ERR_WRONG_GAME_FLAVOUR
                    poryswitch(ROGUE_VERSION)
                    {
                        ROGUE_VERSION_VANILLA
                        {
                            msgbox(format("Lo siento.\nNo puedo conectarte con ese Jugador porque no usa la versión Vanilla."))
                        }
                        ROGUE_VERSION_EXPANSION
                        {
                            msgbox(format("Lo siento.\nNo puedo conectarte con ese Jugador porque no usa la versión EX."))
                        }
                    }

                case 2: // CONN_ERR_WRONG_SAVE_VERSION
                    msgbox(format("Lo siento.\nNo puedo conectarte con ese Jugador porque no tiene la misma versión."))

                case 3: // CONN_ERR_WRONG_REVISED_MODE
                    msgbox(format("Lo siento.\nNo puedo conectarte con ese Jugador porque tenéis ajustes incompatibles del Modo Revisión en el Lab. Config."))

                default: // CONN_ERR_NONE
                    msgbox(format("Si cambias de idea, vuelve a hablar conmigo."))

            }
        }
    }

    release
}

script Rogue_Interior_PokeConnect_TalkNurseBox
{
    lock

    msgbox(format("¡Hola, {PLAYER}!"))

    setvar(VAR_RESULT, 1)

    while(var(VAR_RESULT) == 1)
    {
        message(format("¿Quieres acceder al Almacenamiento Pokémon Ampliado?"))
        waitmessage

        multichoice(20, 6, MULTI_YESNOINFO, NO)

        switch(var(VAR_RESULT))
        {
            case 0: // Yes
                call(Rogue_Interior_PokeConnect_ConnectHomeBox)
                setvar(VAR_RESULT, 0)

            case 1: // No
            case MULTI_B_PRESSED:
                setvar(VAR_RESULT, 0)

            case 2: // Info
                msgbox(format("Si te conectas a RogueAssistant, podrás acceder a un Almacenamiento Pokémon Ampliado parecido a Pokémon HOME, ¡donde guardar muchos más Pokémon!"), MSGBOX_DEFAULT)
                setvar(VAR_RESULT, 1)
        }
    }

    msgbox(format("¡Cuídate!"))
    release
}

script Rogue_Interior_PokeConnect_ConnectHomeBox
{
    call(Rogue_Common_WaitForRogueAssistant)
    
    if(var(VAR_RESULT) == TRUE)
    {
        call(Common_EventScript_SaveGame)
        if(var(VAR_RESULT) == YES)
        {
            special(Special_ViewAssistantBox)
            waitstate

            call(Common_EventScript_ForceSaveGame)
        }
    }
}

script Rogue_Interior_PokeConnect_Tutorial
{
    setflag(FLAG_ROGUE_ASSISTANT_TUTORIAL)
    setvar(VAR_STOP_TUTORIAL, 1)

    lock
    msgbox(format("Este edificio da acceso a funciones externas, como el Almacenamiento Ampliado y el Multijugador.\pDe momento, solo funcionan jugando con mGBA en un PC con Windows.\pPara usarlas, tendrás que descargar un programa auxiliar llamado Rogue Assistant y conectarlo a tu emulador.\pDescárgalo de:\n{COLOR BLUE}https://rogue.assist.pokabbie.com\p{COLOR RED}¡No lo descargues nunca de otros enlaces, o podrías instalar virus!"))
    release
}