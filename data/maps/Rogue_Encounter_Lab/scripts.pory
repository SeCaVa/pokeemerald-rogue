    lock
    copyvar(VAR_0x8001, VAR_ROGUE_SPECIAL_ENCOUNTER_DATA2)
    setvar(VAR_0x8002, 2)
    call(Rogue_Encounter_Lab_PokeballCommon)

    if(var(VAR_RESULT) == YES)
