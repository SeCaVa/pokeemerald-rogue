    if(var(VAR_RESULT) == YES)
    {
        copyvar(VAR_0x8001, VAR_ROGUE_SPECIAL_ENCOUNTER_DATA1)
        setvar(VAR_0x8002, 1)
        call(Rogue_Encounter_Lab_Pokeball_GiveMon)

        setflag(FLAG_SELECTED_MON)
        setflag(FLAG_TEMP_2)
