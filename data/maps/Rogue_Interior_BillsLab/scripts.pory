const VAR_RUN_TUTORIAL = VAR_TEMP_0

const NPC_OBJ_NIDORINO = 6
const NPC_OBJ_BILL = 5
const NPC_OBJ_LEFT_STATUE = 4
const NPC_OBJ_RIGHT_STATUE = 3

mapscripts Rogue_Interior_BillsLab_MapScripts 
{
    MAP_SCRIPT_ON_LOAD: Rogue_Interior_BillsLab_OnLoad
}

script Rogue_Interior_BillsLab_OnLoad
{
    setvar(VAR_FOLLOW_MON_0, SPECIES_NIDORINO)

    if(!flag(FLAG_ROGUE_MET_BILL))
    {
        setobjectxyperm(NPC_OBJ_NIDORINO, 8, 7)
        setobjectmovementtype(NPC_OBJ_NIDORINO, MOVEMENT_TYPE_FACE_UP)

        setobjectxyperm(NPC_OBJ_BILL, 8, 6)
        setobjectmovementtype(NPC_OBJ_BILL, MOVEMENT_TYPE_FACE_DOWN)

        setvar(VAR_RUN_TUTORIAL, YES)
    }
    else
    {
        setvar(VAR_RUN_TUTORIAL, NO)
    }
}

script Rogue_Interior_BillsLab_TalkBill
{
    lock
    faceplayer

    if(var(VAR_RUN_TUTORIAL) == 2)
    {
        msgbox(format("¡Acércate al PC y podrás ver qué Pokémon Únicos está rastreando ahora mismo!"))
    }
    else
    {
        msgbox(format("Hola, {PLAYER}.\pSigo rastreando un montón de Pokémon Únicos, ¡así que no hay motivo para frenar ahora!"))
    }

    release
}

script Rogue_Interior_BillsLab_TalkPC
{
    lock

    message("Iniciando…")
    special(RogueGift_EnsureDynamicCustomMonsAreValid)

    playse(SE_PC_ON)
    waitse

    msgbox(format("Bienvenid{MASC}o{FEM}a{ENDG} al Sistema de\nRastreo de Pokémon Únicos.\pMostrando los Pokémon Únicos rastreados…"))

    setvar(VAR_0x8004, 0)

    while(var(VAR_0x8004) < DYNAMIC_UNIQUE_MON_COUNT)
    {
        special(Rogue_GetDynamicUniqueMonSpecies)

        if(var(VAR_RESULT) != SPECIES_NONE)
        {
            showenemypartypic(0, 2, 2)
            playmoncry(VAR_RESULT, CRY_MODE_NORMAL)

            callnative(ScriptMenu_DisplayUniqueMonInfo)
            special(Rogue_BufferDynamicUniqueMonCountDown)
            if(var(VAR_RESULT) == TRUE)
            {
                messageinstant(format("Los datos de rastreo caducan en {STR_VAR_3}…"))
            }
            else
            {
                messageinstant(format("Los datos de rastreo caducan pronto…"))
            }
            waitstate
            hidemonpic
        }
        
        addvar(VAR_0x8004, 1)
    }

    msgbox(format("Estos son todos los Pokémon Únicos rastreados ahora mismo."))
    waitmoncry

    playse(SE_PC_OFF)
    waitse

    release
}

script Rogue_Interior_BillsLab_MeetBillLeft
{
    lock

    applymovement(OBJ_EVENT_ID_PLAYER, MeetBill_Enter_Left)
    waitmovement(0)
    call(Rogue_Interior_BillsLab_MeetBillCommon)

    release
}

script Rogue_Interior_BillsLab_MeetBillCentre
{
    lock

    applymovement(OBJ_EVENT_ID_PLAYER, MeetBill_Enter_Centre)
    waitmovement(0)
    call(Rogue_Interior_BillsLab_MeetBillCommon)

    release
}

script Rogue_Interior_BillsLab_MeetBillRight
{
    lock

    applymovement(OBJ_EVENT_ID_PLAYER, MeetBill_Enter_Right)
    waitmovement(0)
    call(Rogue_Interior_BillsLab_MeetBillCommon)

    release
}

movement MeetBill_Enter_Left
{
    walk_up
    walk_right
    walk_up
}

movement MeetBill_Enter_Centre
{
    walk_up * 2
}

movement MeetBill_Enter_Right
{
    walk_up
    walk_left
    walk_up
}

script Rogue_Interior_BillsLab_MeetBillCommon
{
    setvar(VAR_RUN_TUTORIAL, 2)
    setflag(FLAG_ROGUE_MET_BILL)

    msgbox(format("Espera un segundo.\pEnseguida estoy contigo.\p{PAUSE 30}… {PAUSE 30}… {PAUSE 30}…\p¿Cómo dices?\p¿Que si soy un Pokémon?"))
    closemessage

    applymovement(NPC_OBJ_RIGHT_STATUE, MeetBill_BillAppear_Statue0)
    applymovement(NPC_OBJ_BILL, MeetBill_BillAppear_Bill0)
    waitmovement(0)

    msgbox(format("¡No digas tonterías!\pSolo estaba arreglando los cables de atrás."))
    closemessage

    applymovement(NPC_OBJ_BILL, MeetBill_BillAppear_Bill1)
    waitmovement(0)
    applymovement(NPC_OBJ_RIGHT_STATUE, MeetBill_BillAppear_Statue1)
    waitmovement(0)
    applymovement(OBJ_EVENT_ID_PLAYER, MeetBill_BillAppear_Player0)
    applymovement(NPC_OBJ_BILL, MeetBill_BillAppear_Bill2)
    waitmovement(0)

    applymovement(NPC_OBJ_NIDORINO, MeetBill_BillAppear_Nidorino0)

    msgbox(format("Me llamo Bill, ¡encantado!\n¡Y ese de ahí es Nidorino!\pComo ves, soy un poco coleccionista de Pokémon.\pÚltimamente han aparecido muchos Pokémon muy Únicos, así que me interesa mucho encontrar alguno.\p¿Sabes qué son los Pokémon Únicos?"), MSGBOX_YESNO)

    if(var(VAR_RESULT) == NO)
    {
        msgbox(format("¡Los Pokémon Únicos son Pokémon que pueden aprender movimientos que normalmente no pueden!\p¡A veces incluso tienen Habilidades distintas!\p¡Estoy casi seguro de que la última vez que salí a buscarlos vi a un Rattata usar Transformación!"))
    }

    msgbox(format("¿Cómo dices?\p¿Que ya tienes un Pokémon Único que conseguiste completando una Misión?\p¡Increíble!\pOye, se me ocurre una idea, {PLAYER}.\p¡Yo te ayudo a rastrear Pokémon Únicos mientras estás de Aventura!\p¡Y a cambio, tú me ayudas a Mejorar mis sistemas!\p¡Pareces muy habilidos{MASC}o{FEM}a{ENDG}, así que seguro que te los encuentras mucho más a menudo que yo!"))

    applymovement(OBJ_EVENT_ID_PLAYER, MeetBill_BillAppear_FaceUp)
    applymovement(NPC_OBJ_BILL, MeetBill_BillAppear_FaceUp)
    waitmovement(0)

    msgbox(format("Verás, he modificado este PC para rastrear Pokémon Únicos.\p¡Cuando aparezca un Pokémon en esa pantalla, significa que podrías encontrarte con ese Pokémon Único en las rutas mientras exploras!\p¿Por qué no le echas un vistazo?"))

    setobjectxyperm(NPC_OBJ_NIDORINO, 10, 8)
    setobjectxyperm(NPC_OBJ_BILL, 9, 8)

}

movement MeetBill_BillAppear_Statue0
{
    walk_slow_right
}

movement MeetBill_BillAppear_Statue1
{
    walk_slow_left
}

movement MeetBill_BillAppear_Player0
{
    face_right
}

movement MeetBill_BillAppear_Bill0
{
    delay_16
    walk_right
    face_down
}

movement MeetBill_BillAppear_Bill1
{
    walk_down
    face_up
}

movement MeetBill_BillAppear_Bill2
{
    walk_down
    face_left
}

movement MeetBill_BillAppear_Nidorino0
{
    walk_slow_right * 2
    walk_slow_down
}

movement MeetBill_BillAppear_FaceUp
{
    face_up
}