const FLAG_CAN_GIVE_C_GEAR = FLAG_TEMP_10

const VAR_TRIGGER_POKABBIE_MEET = VAR_TEMP_0

// Reused vars
const VAR_SHAKE_VERTICAL_PAN = VAR_0x8004
const VAR_SHAKE_HORIZONTAL_PAN = VAR_0x8005
const VAR_SHAKE_NUM_SHAKES = VAR_0x8006
const VAR_SHAKE_SHAKE_DELAY = VAR_0x8007

const OBJ_EVENT_POKABBIE = 2

mapscripts Rogue_Interior_ConfigLab_MapScripts 
{
    MAP_SCRIPT_ON_LOAD: Rogue_Interior_ConfigLab_OnLoad
}

script Rogue_Interior_ConfigLab_OnLoad
{
    setvar(VAR_FOLLOW_MON_0, SPECIES_MAREEP)
    if(flag(FLAG_ROGUE_UNCOVERRED_POKABBIE))
    {
        call(Rogue_Interior_ConfigLab_DrawBasementDoor)
    }

    if(var(VAR_ROGUE_INTRO_STATE) >= ROGUE_INTRO_STATE_REPORT_TO_PROF && flag(FLAG_ROGUE_MET_FENNEL))
    {
        setflag(FLAG_CAN_GIVE_C_GEAR)
    }
    else
    {
        clearflag(FLAG_CAN_GIVE_C_GEAR)
    }

    if(!flag(FLAG_ROGUE_MET_POKABBIE))
    {
        setvar(VAR_TRIGGER_POKABBIE_MEET, YES)
    }
    else
    {
        setvar(VAR_TRIGGER_POKABBIE_MEET, NO)
    }
}

script Rogue_Interior_ConfigLab_DrawBasementDoor
{
    setmetatile(2, 13, 0x27C, TRUE)
    setmetatile(3, 13, 0x27D, TRUE)
    setmetatile(4, 13, 0x27E, TRUE)

    setmetatile(2, 14, 0x284, TRUE)
    setmetatile(3, 14, 0x283, FALSE)
    setmetatile(4, 14, 0x286, TRUE)

    setmetatile(2, 15, 0x28C, TRUE)
    setmetatile(4, 15, 0x28E, FALSE)
    special(DrawWholeMapView)
}

script Rogue_Interior_ConfigLab_TalkHiddenDoor
{
    special(Rogue_IsMultiplayerClient)
    if(flag(FLAG_ROGUE_UNCOVERRED_POKABBIE) == FALSE && var(VAR_RESULT) == NO)
    {
        lock

        msgbox(format("¿Qué es esto?\p¡Un interruptor oculto!\p¿Pulsar el interruptor?"), MSGBOX_YESNO)

        if(var(VAR_RESULT) == YES)
        {
            msgbox(format("¡ATENCIÓN!\nSi pulsas este interruptor, te saltarás parte del juego y activarás el contenido posterior.\pSe recomienda completar una partida normal antes de pulsarlo.\p¿Pulsar el interruptor?"), MSGBOX_YESNO)

            if(var(VAR_RESULT) == YES)
            {
                setflag(FLAG_ROGUE_UNCOVERRED_POKABBIE)

                waitse
                playse(SE_TRUCK_DOOR)
                call(Rogue_Interior_ConfigLab_DrawBasementDoor)
            }
        }

        release
    }
}

script Rogue_Interior_ConfigLab_TalkFennel
{
    lock
    faceplayer
    msgbox(format("FENNEL: ¡Ah, hola, {PLAYER}!"), MSGBOX_DEFAULT)
    
    if(!flag(FLAG_ROGUE_MET_FENNEL))
    {
        msgbox(format("Ahora que todo se ha calmado un poco, por fin puedo seguir con mi investigación.\pHe cambiado un poco el enfoque.\nAhora intento averiguar qué pasa ahí fuera mientras la gente está de Aventura."))
        msgbox(format("Hablando de Aventuras…\p¡He descubierto cómo ajustar el funcionamiento de tus Aventuras!\p¡Mira!"))
    }
    else
    {
        checkitem(ITEM_C_GEAR)

        if(var(VAR_RESULT) == FALSE && flag(FLAG_CAN_GIVE_C_GEAR))
        {
            msgbox(format("¡Justo {MASC}el{FEM}la{ENDG} Entrenador{MASC}{FEM}a{ENDG} que quería ver!\p¡Tengo algo para ti!"), MSGBOX_DEFAULT)

            giveitem(ITEM_C_GEAR)

            bufferitemname(STR_VAR_1, ITEM_C_GEAR)
            msgbox(format("¡He adaptado {STR_VAR_1} para que puedas ver y cambiar los ajustes del Lab. Config. a distancia!\p¡Incluso puedes usarlo durante una Aventura para revisar tus ajustes!\pBueno…\n¿Quieres cambiar los ajustes de tus Aventuras?"), MSGBOX_DEFAULT)
        }
        else
        {
            msgbox(format("¿Quieres cambiar los ajustes de tus Aventuras?"), MSGBOX_DEFAULT)
        }
    }

    waitse
    special(Special_ViewDifficultyConfigMenu)
    waitstate

    if(!flag(FLAG_ROGUE_MET_FENNEL))
    {
        setflag(FLAG_ROGUE_MET_FENNEL)
        msgbox(format("Todavía no lo entiendo todo.\p¡Pero estoy segura de que, si sigues explorando, acabaré reuniendo datos suficientes para desvelar los secretos de las Aventuras y compartirlos contigo!"))
    }

    msgbox(format("Si alguna vez quieres volver a cambiar los ajustes de tus Aventuras, ven a hablar conmigo.")) 

    release
}

script Rogue_Interior_ConfigLab_TriggerMeetPokabbie
{
    lock
    setflag(FLAG_ROGUE_MET_POKABBIE)
    setvar(VAR_TRIGGER_POKABBIE_MEET, NO)

    applymovement(OBJ_EVENT_POKABBIE, Rogue_Interior_ConfigLab_Pokabbie0)
    waitmovement(0)

    playbgm(MUS_PL_MYSTERY_GIFT, TRUE)

    msgbox(format("¡¿{PLAYER}?!\p¿Qué haces aquí? ¡No esperaba que vinieras tan pronto!\p¿Que quién soy?\pMe llamo Pokabbie.\n¡Soy quien desarrolla Emerald Rogue!"))
    closemessage

    applymovement(OBJ_EVENT_POKABBIE, Pokabbie_Spin_FaceLeft)
    waitmovement(0)

    msgbox(format("POKABBIE: ¡Tachán!\pHe de admitir que no esperaba hablar contigo hasta que fueras Campeón y entraras en el Hall de la Fama.\pPero supongo que podemos saltarnos un poco el orden…\nA ver si recuerdo mi discurso.\pEjem.\pAhora que eres, {FONT_NARROW}o pronto serás, con suerte,{FONT_NORMAL} Campeón, ¡tienes muchíiiisimas más cosas divertidas por hacer!\pHablando de eso…\n¿Me prestas tu Pokédex un segundo, por favor?"))

    if(!flag(FLAG_SYS_POKEDEX_GET))
    {
        msgbox(format("¿Qué?\p¡¿Ni siquiera tienes Pokédex todavía?!\pVaya… sí que tienes ganas, ¿eh?\pBueno, toma, puedes quedarte con esta."))
        
        callnative(Rogue_PushPopup_UnlockPokedex)
        call(Rogue_Common_DisplayPopups)
        setflag(FLAG_SYS_POKEDEX_GET)

        msgbox(format("{FONT_NARROW}Ahora que eso está resuelto, puedo seguir con mi guion…{FONT_NORMAL}\p¿Me prestas tu Pokédex un segundo, por favor?"))
    }

    closemessage
    applymovement(OBJ_EVENT_POKABBIE, Rogue_Interior_ConfigLab_Pokabbie1)
    waitmovement(0)

    delay(30)
    playse(SE_M_COMET_PUNCH)
    waitse
    playse(SE_M_COMET_PUNCH)
    waitse
    playse(SE_M_COMET_PUNCH)
    waitse
    delay(30)

    playse(SE_M_EXPLOSION)
    setvar(VAR_SHAKE_VERTICAL_PAN, -5)
    setvar(VAR_SHAKE_HORIZONTAL_PAN, 5)
    setvar(VAR_SHAKE_NUM_SHAKES, 8)
    setvar(VAR_SHAKE_SHAKE_DELAY, 4)
    special(ShakeCameraNoSE)
    waitstate
    waitse

    delay(30)

    applymovement(OBJ_EVENT_POKABBIE, Rogue_Interior_ConfigLab_Pokabbie2)
    waitmovement(0)

    msgbox(format("POKABBIE: Uf…\n¡Listo!\p¡Tengo unas cuantas mejoras para ti!\pPrimero, ahora tu Pokédex puede cambiar de modo a distintas Regiones.\pMira."))

    waitse
    special(Special_ViewRoguePokedex)
    waitstate

    msgbox(format("Si cambias el modo de tu Pokédex, en tu próxima Aventura ¡solo encontrarás Pokémon de ese modo de Pokédex!\p¡Lo siguiente que he hecho ha sido mejorarte el Lab. Config.!"))

    checkitem(ITEM_C_GEAR)
    if(var(VAR_RESULT) == NO)
    {
        bufferitemname(STR_VAR_1, ITEM_C_GEAR)

        msgbox(format("¡¿Qué?!\n¿Ni siquiera tienes {STR_VAR_1} propio?\p¡Eso no puede ser!\n¡Toma!"))
        giveitem(ITEM_C_GEAR)

        msgbox(format("¡Con {STR_VAR_1} puedes acceder al Lab. Config. estés donde estés!\pPuedes cambiar los ajustes desde cualquier lugar de {POKEMON_HUB}, o incluso revisarlos en mitad de una Aventura.\pEn fin, ¡que me distraigo!\pEn realidad, eso no es lo que te he mejorado…"))
    }

    msgbox(format("He mejorado el Lab. Config. para que tenga ajustes nuevos.\pMira."))

    waitse
    special(Special_ViewDifficultyConfigMenu)
    waitstate

    msgbox(format("¡Yyyyyyy!\p¡Por último, he añadido una nueva mejora que puedes construir en {POKEMON_HUB}: la Zona de Desafíos!"))

    if(var(VAR_ROGUE_INTRO_STATE) <= ROGUE_INTRO_STATE_LEARN_TO_BUILD)
    {
        msgbox(format("¡Vaya, hombre!\n¿Todavía no sabes lo que son las mejoras?\p¡Has hablado conmigo tan pronto que ni siquiera has terminado el Tutorial!\pNo importa.\nLo aprenderás en cuanto vuelvas de tu primera Aventura."))
    }

    msgbox(format("No te voy a hacer spoiler, ¡pero en la Zona de Desafíos hay un montón de cosas que seguro que te parecen superdivertidas!\p¡Ahora ponte en marcha y completa unas cuantas Aventuras!"))

    fadedefaultbgm
    release
}

script Rogue_Interior_ConfigLab_TalkPokabbie
{
    lock

    applymovement(OBJ_EVENT_POKABBIE, Pokabbie_Spin_FaceDown)
    waitmovement(0)

    faceplayer

    special(Rogue_CanActivatePikinEasterEgg)

    if(var(VAR_RESULT) == YES)
    {
        setflag(FLAG_ROGUE_UNLOCKED_PIKIN_EASTER_EGG)
        msgbox(format("POKABBIE: ¡Hola, {PLAYER}!\p¿Ese es...?\p¡Sí que lo es!\n¡Es uno de mis Mareep!\pAsí que ha acabado contigo, ¿eh?\p¡Al menos podrás llevarlo a Aventuras emocionantes!"))

        poryswitch(ROGUE_VERSION)
        {
            ROGUE_VERSION_VANILLA
            {
                msgbox(format("¿Sabías que Pikin también puede aprender Ventisca?\p¡Ya deberías poder enseñárselo desde el menú Aprender Movimientos!\p¡Espero que lleves a Pikin a Aventuras emocionantes!"))
            }
            ROGUE_VERSION_EXPANSION
            {
                msgbox(format("¿Sabes que una vez hice un hack de desafío para un amigo en el que le di a Pikin su propia Megaevolución?\p¡Un Mega-Mareep!\pAunque en aquel ROM hack estaba un poco roto…\p¡Ay, se me olvidaba!\p¡En Emerald Rogue también puedes megaevolucionar a Pikin!\pTienes que enseñarle Vendaval y así podrá megaevolucionar.\p… … …\pSí… como Mega-Rayquaza…\pMira… ¡es que me encantan los Mareep!\p¡Listo!\pYa deberías poder enseñarle Vendaval a Pikin desde el menú Aprender Movimientos.\p¡Prueba tú mismo a Mega-Mareep!\pEso sí, ten cuidado de no hacerlo evolucionar, o tendrás que buscar otro Pikin…\pAunque, la verdad…\nHay muchos Pikin…\p¡Espero que lleves a Pikin a Aventuras emocionantes!"))
            }
        }
    }
    else
    {
        msgbox(format("POKABBIE: ¡Hola, {PLAYER}!\p¡Espero que estés disfrutando de Emerald Rogue!\pSi no…\n¿Qué sé yo?\l¿Lo siento, supongo?"))
    }

    release
}

movement Rogue_Interior_ConfigLab_Pokabbie0
{
    face_left
    emote_exclamation_mark
    delay_16 * 4
    walk_left
}

movement Rogue_Interior_ConfigLab_Pokabbie1
{
    walk_fast_right
    face_up
}

movement Rogue_Interior_ConfigLab_Pokabbie2
{
    walk_fast_left
}

movement Pokabbie_Spin_FaceDown
{
    face_right
    delay_1

    face_up
    delay_1

    face_left
    delay_1

    face_down
    delay_1
    
    face_right
    delay_1

    face_up
    delay_1

    face_left
    delay_1

    face_down
    delay_1
}

movement Pokabbie_Spin_FaceLeft
{
    face_down
    delay_1
    
    face_right
    delay_1

    face_up
    delay_1

    face_left
    delay_1

    face_down
    delay_1

    face_right
    delay_1

    face_up
    delay_1

    face_left
    delay_1
}