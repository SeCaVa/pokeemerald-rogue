const METATILE_Background = 0x001

const VAR_ROGUE_INTRO_STATE = VAR_LITTLEROOT_INTRO_STATE
const VAR_RETURN_STATE = VAR_TEMP_0

const NPC_INTRO_SCOTT = 1

mapscripts Rogue_Hub_AdventureEnterance_MapScripts 
{
    MAP_SCRIPT_ON_LOAD: Rogue_Adventure_RedrawMap
    MAP_SCRIPT_ON_FRAME_TABLE 
    [
        VAR_RETURN_STATE, 0: Rogue_Adventure_WarpState0
    ]
}

script Rogue_Adventure_WarpState0
{
    if(flag(FLAG_ROGUE_LEFT_ON_RUN))
    {
        call(Rogue_ReturnAdventureCommon)
    }
    elif(flag(FLAG_ROGUE_MET_POKABBIE) && !flag(FLAG_ROGUE_SCOTT_GIFTED_EXTRAS))
    {
        call(Rogue_Adventure_ScottGift)

        // Skip intro if we did this first
        if(var(VAR_ROGUE_INTRO_STATE) == 4)
        {
            setvar(VAR_ROGUE_INTRO_STATE, 5)
        }
    }
    elif(var(VAR_ROGUE_INTRO_STATE) == 4)
    {
        call(Rogue_Adventure_ScottIntro)
        setvar(VAR_ROGUE_INTRO_STATE, 5)
    }
    else
    {
        checkitem(ITEM_QUEST_LOG)
        
        if(var(VAR_RESULT) == NO)
        {
            call(Rogue_Adventure_ScottOldSaveQuestLog)
        }
    }

    setvar(VAR_RETURN_STATE, 1)
}

script Rogue_Adventure_RedrawMap
{
    // Hide hidden rooms
    if(flag(FLAG_ROGUE_SCOTT_GIFTED_EXTRAS) || flag(FLAG_ROGUE_MET_POKABBIE) && !flag(FLAG_ROGUE_SCOTT_GIFTED_EXTRAS))
    {
        // About to expand...
        clearflag(FLAG_ROGUE_TRAINER0)
    }
    else
    {
        setflag(FLAG_ROGUE_TRAINER0)
        fillmetatile(10, 0, 17, 8, METATILE_Background, TRUE)
    }
}

script Rogue_Adventure_ScottGiveQuestLog
{
    giveitem(ITEM_QUEST_LOG, 1)
    msgbox(format("Ese diario tiene muchas Misiones opcionales para completar mientras estás de Aventura.\pCompletar Misiones también puede darte buenas recompensas.\pCuando completes alguna, ven a hablar conmigo y te daré las recompensas."))
}

script Rogue_Adventure_ScottIntro
{
    lockall

    applymovement(NPC_INTRO_SCOTT, Rogue_Adventure_ScottIntroMovement0)
    waitmovement(0)

    msgbox(format("TRETO: ¡Hola, {PLAYER}!\p¡Veo que ya tienes un Pokémon compañero, así que estás list{MASC}o{FEM}a{ENDG} para irte de Aventura!\pAntes de irte, deberías llevarte esto."))

    call(Rogue_Adventure_ScottGiveQuestLog)

    msgbox(format("¡Parece que ya estás list{MASC}o{FEM}a{ENDG}!\p¡Habla con la enfermera de allí y podrás empezar a explorar!"))

    releaseall
}

script Rogue_Adventure_ScottOldSaveQuestLog
{
    lockall

    applymovement(NPC_INTRO_SCOTT, Rogue_Adventure_ScottIntroMovement0)
    waitmovement(0)

    msgbox(format("TRETO: ¡Hola, {PLAYER}!\pAntes de tu próxima Aventura, deberías llevarte esto."))

    call(Rogue_Adventure_ScottGiveQuestLog)

    msgbox(format("¡Parece que ya estás list{MASC}o{FEM}a{ENDG}!"))

    releaseall
}

script Rogue_Adventure_ScottGift
{
    lockall
    setflag(FLAG_ROGUE_SCOTT_GIFTED_EXTRAS)

    applymovement(NPC_INTRO_SCOTT, Rogue_Adventure_ScottIntroMovement0)
    waitmovement(0)

    // Give extra key items
    msgbox(format("TRETO: ¡Anda, hola, {PLAYER}!\n¡POKABBIE ha añadido aquí algunos modos extra para que los pruebes!"), MSGBOX_DEFAULT)

    checkitem(ITEM_QUEST_LOG)
    if(var(VAR_RESULT) == NO)
    {
        msgbox(format("Antes de tu próxima Aventura, deberías llevarte también esto."))
        call(Rogue_Adventure_ScottGiveQuestLog)

        msgbox(format("¡Parece que ya estás list{MASC}o{FEM}a{ENDG}!"))
    }

    releaseall
}

const VAR_QUEST_REWARD_TYPE = VAR_0x8004
const VAR_QUEST_REWARD_PARAM0 = VAR_0x8005
const VAR_QUEST_REWARD_PARAM1 = VAR_0x8006

script Rogue_Adventure_SpeakScott
{
    lock
    faceplayer

    checkitem(ITEM_QUEST_LOG)
    if(var(VAR_RESULT) == NO)
    {
        msgbox(format("TRETO: ¡Hola, {PLAYER}!\pAntes de tu próxima Aventura, deberías llevarte también esto."))
        call(Rogue_Adventure_ScottGiveQuestLog)

        msgbox(format("¡Parece que ya estás list{MASC}o{FEM}a{ENDG}!"))
    }
    else
    {
        // Check for quest rewards
        nextquestreward
        if(var(VAR_RESULT) == TRUE)
        {
            msgbox(format("TRETO: ¡Hola, {PLAYER}!\p¡Tengo recompensas de Misiones para ti!"))
            while(var(VAR_RESULT) == TRUE)
            {
                //if(var(VAR_0x8000) == QUEST_REWARD_CUSTOM_TEXT)
                //{
                //    playfanfare(MUS_OBTAIN_ITEM)
                //}
                //else
                //{
                //    playse(SE_SHOP)
                //}

                msgbox("{STR_VAR_3}")
                
                //if(var(VAR_0x8000) == QUEST_REWARD_CUSTOM_TEXT)
                //{
                //    waitfanfare
                //}
                //else
                //{
                //    waitse
                //}

                nextquestreward
            }

            msgbox(format("¡Y eso es todo por ahora!"))

            // Check if our bag got full
            checkitemspace(ITEM_REVIVE)
            if(var(VAR_RESULT) == NO)
            {
                msgbox(format("Parece que tienes la mochila llena.\pRevisa tu PC, porque algunas recompensas pueden aparecer allí."))
            }

            msgbox(format("¡Suerte en tu próxima Aventura, campeón!"))
        }
        elif(var(VAR_ROGUE_INTRO_STATE) <= 5)
        {
            msgbox(format("TRETO: ¡Hola, {PLAYER}!\p¡Habla con la enfermera de allí y podrás empezar a explorar!"))
        }
        else
        {
            msgbox(format("TRETO: ¡Hola, {PLAYER}!\p¡Ven a hablar conmigo cuando completes Misiones para que te dé las recompensas!"))
        }
    }

    release
}

movement Rogue_Adventure_ScottIntroMovement0
{
    face_down
    emote_exclamation_mark
    delay_16

    walk_left * 2
    walk_down * 2
}

script Rogue_Adventure_StatsSign
{
    buffernumberstring(STR_VAR_1, VAR_ROGUE_FURTHEST_DIFFICULTY)
    msgbox(format("Mayor progreso:\n{STR_VAR_1} MEDALLAS obtenidas...\pUna nota del desarrollo...\p¡Las estadísticas de partidas llegarán en una futura actualización!"), MSGBOX_SIGN)
}

script Rogue_Adventure_StartStandard
{
    call(Rogue_ResetAdventureFlags)

    lock
    faceplayer

    // Yes No Info
    msgbox(format("¿Quieres irte de aventura?"), MSGBOX_YESNO)

    if(var(VAR_RESULT) == YES)
    {
        call(Rogue_ResetAdventureFlags)
        call(Rogue_StartAdventureCommon)
    }
    else
    {
        msgbox(format("Si cambias de idea, vuelve a hablar conmigo."), MSGBOX_DEFAULT)
    }

    release
}

script Rogue_Adventure_StartGauntlet
{
    call(Rogue_ResetAdventureFlags)

    lock
    faceplayer

    message(format("¿Quieres ir a una aventura DESAFÍO?"))
    waitmessage

    multichoice(20, 6, MULTI_YESNOINFO, NO)

    switch(var(VAR_RESULT))
    {
        case 0: // Yes
            call(Rogue_ResetAdventureFlags)
            setflag(FLAG_ROGUE_GAUNTLET_MODE)
            call(Rogue_StartAdventureCommon)

        case 1: // No
            msgbox(format("Si cambias de idea, vuelve a hablar conmigo."), MSGBOX_DEFAULT)

        case 2: // Info
            msgbox(format("En las aventuras DESAFÍO tendrás unas pocas rutas para capturar Pokémon y recoger objetos.\pDespués lucharás contra todos los JEFES seguidos, sin poder conseguir más Pokémon ni objetos.\pEs un modo arriesgado pensado para combates más rápidos y difíciles, aunque casi todas las Misiones están desactivadas."), MSGBOX_DEFAULT)

        case MULTI_B_PRESSED:
            msgbox(format("Si cambias de idea, vuelve a hablar conmigo."), MSGBOX_DEFAULT)
    }

    release
}

script Rogue_Adventure_StartRainbow
{
    call(Rogue_ResetAdventureFlags)

    lock
    faceplayer

    message(format("¿Quieres ir a una aventura ARCOÍRIS?"))
    waitmessage

    multichoice(20, 6, MULTI_YESNOINFO, NO)

    switch(var(VAR_RESULT))
    {
        case 0: // Yes
            call(Rogue_ResetAdventureFlags)
            call(Rogue_StartAdventureCommon)

        case 1: // No
            msgbox(format("Si cambias de idea, vuelve a hablar conmigo."), MSGBOX_DEFAULT)

        case 2: // Info
            msgbox(format("Las aventuras ARCOÍRIS son muy parecidas a las normales.\pLa principal diferencia es que en los combates contra Jefes puede aparecer cualquier tipo.\p¡Por ejemplo, Plubio podría ser el primer LÍDER de GIMNASIO, o PETRA podría acabar siendo la CAMPEONA!\pIncluso encontrarás Jefes con tipos que no suelen verse en las aventuras normales.\pEn este modo se activan entrenadores de todas las regiones.\nEs decir, se ignorarán tus ajustes del Lab. Config."), MSGBOX_DEFAULT)

        case MULTI_B_PRESSED:
            msgbox(format("Si cambias de idea, vuelve a hablar conmigo."), MSGBOX_DEFAULT)
    }

    release
}

script Rogue_ResetAdventureFlags
{
    //clearflag(FLAG_ROGUE_DOUBLE_BATTLES)
    clearflag(FLAG_ROGUE_GAUNTLET_MODE)
}

script Rogue_StartAdventureCommon
{
    //special(Rogue_AnyNewQuestsPending)

    if(var(VAR_RESULT) == TRUE)
    {
        msgbox(format("Antes de que te vayas: Treto te estaba buscando.\pDijo algo de que tenía una Misión nueva lista para desbloquear.\p¿Quieres continuar de todos modos?"), MSGBOX_YESNO)
        if(var(VAR_RESULT) == NO)
        {
            return
        }
    }

    getpartysize

    if(flag(FLAG_ROGUE_GAUNTLET_MODE))
    {
        // You can carry 6 mons into gauntlet mode
        setvar(VAR_RESULT, YES)
    }
    //elif(flag(FLAG_ROGUE_DOUBLE_BATTLES))
    //{
    //    if(var(VAR_RESULT) > 2)
    //    {
    //        msgbox(format("Parece que llevas demasiados Pokémon.\pEn este modo solo puedes llevar 2 Pokémon.\nDeja algunos en el PC antes de que pueda dejarte ir de aventura."), MSGBOX_DEFAULT)
    //        setvar(VAR_RESULT, NO)
    //    }
    //    else
    //    {
    //        setvar(VAR_RESULT, YES)
    //    }
    //}
    else
    {
        if(var(VAR_RESULT) > 1)
        {
            msgbox(format("Parece que llevas demasiados Pokémon.\pEn este modo solo puedes llevar 1 Pokémon.\nDeja algunos en el PC antes de que pueda dejarte partir."), MSGBOX_DEFAULT)
            setvar(VAR_RESULT, NO)
        }
        else
        {
            setvar(VAR_RESULT, YES)
        }
    }

    if(var(VAR_RESULT) == YES)
    {
        setvar(VAR_ROGUE_SKIP_TO_DIFFICULTY, 0)
        specialvar(VAR_RESULT, GetLeadMonLevel)

        if(flag(FLAG_SET_SEED_ENABLED) == FALSE && flag(FLAG_ROGUE_GAUNTLET_MODE) == FALSE && var(VAR_ROGUE_DESIRED_CAMPAIGN) == ROGUE_CAMPAIGN_NONE)
        {
            if(var(VAR_RESULT) > 85)
            {
                setvar(VAR_ROGUE_SKIP_TO_DIFFICULTY, 8)
            }
            elif(var(VAR_RESULT) > 75)
            {
                setvar(VAR_ROGUE_SKIP_TO_DIFFICULTY, 7)
            }
            elif(var(VAR_RESULT) > 65)
            {
                setvar(VAR_ROGUE_SKIP_TO_DIFFICULTY, 6)
            }
            elif(var(VAR_RESULT) > 55)
            {
                setvar(VAR_ROGUE_SKIP_TO_DIFFICULTY, 5)
            }
            elif(var(VAR_RESULT) > 45)
            {
                setvar(VAR_ROGUE_SKIP_TO_DIFFICULTY, 4)
            }
            elif(var(VAR_RESULT) > 35)
            {
                setvar(VAR_ROGUE_SKIP_TO_DIFFICULTY, 3)
            }
            elif(var(VAR_RESULT) > 25)
            {
                setvar(VAR_ROGUE_SKIP_TO_DIFFICULTY, 2)
            }
            elif(var(VAR_RESULT) > 15)
            {
                setvar(VAR_ROGUE_SKIP_TO_DIFFICULTY, 1)
            }
        }

        // Skip ahead based on lvl
        if(var(VAR_ROGUE_SKIP_TO_DIFFICULTY) != 0)
        {
            msgbox(format("¡Tu COMPAÑERO tiene nivel suficiente para adelantarte!"), MSGBOX_DEFAULT)

            buffernumberstring(STR_VAR_1, VAR_ROGUE_SKIP_TO_DIFFICULTY)
            
            message(format("¿Quieres adelantarte y empezar justo después de la MEDALLA {STR_VAR_1}?"))
            waitmessage
            
            multichoice(20, 8, MULTI_FULL_OR_SKIP, NO)

            switch(var(VAR_RESULT))
            {
                case 0: // Full Run
                    setvar(VAR_ROGUE_SKIP_TO_DIFFICULTY, 0)
                    setvar(VAR_RESULT, YES)

                case 1: // Skip Ahead (Already set to correct value)
                    setvar(VAR_RESULT, YES)

                case MULTI_B_PRESSED:
                    setvar(VAR_RESULT, NO)
            }
        }

        call(Common_EventScript_SaveGame)
        if(var(VAR_RESULT) == YES)
        {
            msgbox(format("¡Buena suerte, {PLAYER}!"), MSGBOX_DEFAULT)

            if(var(VAR_ROGUE_INTRO_STATE) == 5)
            {
                // First adventure
                setvar(VAR_ROGUE_INTRO_STATE, 6)
            }
            else
            {
                // Normal adventure
                setvar(VAR_ROGUE_INTRO_STATE, 7)
            }

            setflag(FLAG_ROGUE_LEFT_ON_RUN)
            setrespawn(HEAL_LOCATION_ROGUE_HUB)
            warp(MAP_ROGUE_HUB_TRANSITION, 0)
            waitstate
        }
        else
        {
            msgbox(format("De acuerdo. Ven a hablar conmigo cuando estés list{MASC}o{FEM}a{ENDG}."), MSGBOX_DEFAULT)
        }
    }
}

script Rogue_ReturnAdventureCommon
{
    lockall
    turnobject(OBJ_EVENT_ID_PLAYER, DIR_NORTH)

    msgbox(format("¡Bienvenid{MASC}o{FEM}a{ENDG} de vuelta, {PLAYER}!"), MSGBOX_DEFAULT)

    // Just returned from firstadventure
    if(var(VAR_ROGUE_INTRO_STATE) == 6)
    {
        msgbox(format("Cada vez que vuelves de una aventura\nganas recompensas según lo bien que lo hayas hecho."), MSGBOX_DEFAULT)

        buffernumberstring(STR_VAR_1, VAR_ROGUE_CURRENT_ROOM_IDX)
        //buffernumberstring(STR_VAR_2, VAR_ROGUE_DIFFICULTY)

        msgbox(format("Veamos...\pHas completado{PAUSE 15}.{PAUSE 15}.{PAUSE 15}.\n{STR_VAR_1} rutas...{PAUSE 15}"), MSGBOX_DEFAULT)
        
        //turnobject(NPC_INTRO_SCOTT, DIR_EAST)
        msgbox(format("Así que, mmm...\nTus recompensas son{PAUSE 15}.{PAUSE 15}.{PAUSE 15}."), MSGBOX_DEFAULT)
        //turnobject(NPC_INTRO_SCOTT, DIR_SOUTH)
    }

    special(Rogue_RunRewardMoney)
    copyvar(VAR_0x8000, VAR_RESULT)

    special(Rogue_RunRewardLvls)
    copyvar(VAR_0x8001, VAR_RESULT)

    if(var(VAR_0x8000) != 0 || var(VAR_0x8001) != 0)
    {
        msgbox(format("Tus recompensas esta vez son..."))

        if(var(VAR_0x8000) != 0)
        {
            buffernumberstring(STR_VAR_1, VAR_0x8000)

            message(format("Has recibido ¥{STR_VAR_1}"))
            playfanfare(MUS_OBTAIN_ITEM)
            waitmessage
            waitfanfare
        }

        if(var(VAR_0x8001) != 0)
        {
            if(var(VAR_0x8001) == 1)
            {
                message(format("El equipo ha subido 1 NV."))
            }
            else
            {
                buffernumberstring(STR_VAR_1, VAR_0x8001)
                message(format("El equipo ha subido {STR_VAR_1} NV."))
            }

            playfanfare(FANFARE_LEVEL_UP)
            waitmessage
            waitfanfare
            
            if(!flag(FLAG_ROGUE_LVL_TUTORIAL))
            {
                msgbox(format("¡Ah!\n¿Es la primera vez que tu equipo sube de nivel en la BASE?\pEstos NV no funcionan exactamente igual que durante las Aventuras.\pEn la BASE, los POKéMON no aprenden movimientos ni evolucionan por sí solos.\pTendrás que buscar a personas especializadas que te ayuden cuando tu Pokémon alcance el nivel adecuado.\pLos niveles que ganes en la BASE se reiniciarán temporalmente al partir de Aventura.\pEl nivel de la BASE se restaurará cuando vuelvas."))
                setflag(FLAG_ROGUE_LVL_TUTORIAL)
            }
        }
    }
    else
    {
        msgbox(format("Parece que esta Aventura no tiene recompensas."))
    }

    clearflag(FLAG_ROGUE_LEFT_ON_RUN)
    setvar(VAR_ROGUE_INTRO_STATE, 7)


    if(flag(FLAG_SET_SEED_ENABLED))
    {
        msgbox(format("¿Quieres mantener la misma SEMILLA para tu próxima Aventura?"), MSGBOX_YESNO)
        if(var(VAR_RESULT) == YES)
        {
            msgbox(format("De acuerdo.\nRecordaré la misma SEMILLA."), MSGBOX_DEFAULT)
        }
        else
        {
            msgbox(format("De acuerdo.\nSe quitará la SEMILLA en la próxima Aventura."), MSGBOX_DEFAULT)
            clearflag(FLAG_SET_SEED_ENABLED)
        }
    }
    
    msgbox(format("¿Quieres GUARDAR tu progreso?"), MSGBOX_YESNO)
    if(var(VAR_RESULT) == YES)
    {
        call(Common_EventScript_SaveGame)
    }
    msgbox(format("Ven a hablar conmigo cuando estés list{MASC}o{FEM}a{ENDG} para tu próxima aventura."), MSGBOX_DEFAULT)
    releaseall
}