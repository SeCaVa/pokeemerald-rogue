const VAR_BERRY_BUFF_AMOUNT = VAR_0x8005

const BERRY_BUFF_FRIEND = 0
const BERRY_BUFF_HP = 1
const BERRY_BUFF_ATK = 2
const BERRY_BUFF_DEF = 3
const BERRY_BUFF_SPD = 4
const BERRY_BUFF_SPATK = 5
const BERRY_BUFF_SPDEF = 6
const BERRY_BUFF_WEAKEN = 7

mapscripts Rogue_Hub_Bakery_MapScripts {}



script RogueHub_Bakery_SpeakChef_ApplyTreat
{
    special(Rogue_ApplyBerryTreat)

    if(var(VAR_RESULT) == YES)
    {
        playse(SE_SHOP)
        waitse

        updatemoneybox

        msgbox(format("¡Marchando!"))

        fadescreen(FADE_TO_BLACK)
        playfanfare(MUS_HEAL)
        waitfanfare
        fadescreen(FADE_FROM_BLACK)

        special(BufferMonNickname)
        special(Rogue_CheckBerryTreat)
        switch(var(VAR_RESULT))
        {
            case BERRY_BUFF_FRIEND:
                msgbox(format("{STR_VAR_1} te tiene más cariño."))

            case BERRY_BUFF_HP:
                msgbox(format("Los PS de {STR_VAR_1} han mejorado."))

            case BERRY_BUFF_ATK:
                msgbox(format("El Ataque de {STR_VAR_1} ha mejorado."))

            case BERRY_BUFF_DEF:
                msgbox(format("La Defensa de {STR_VAR_1} ha mejorado."))

            case BERRY_BUFF_SPATK:
                msgbox(format("El At. Esp. de {STR_VAR_1} ha mejorado."))

            case BERRY_BUFF_SPDEF:
                msgbox(format("La Def. Esp. de {STR_VAR_1} ha mejorado."))

            case BERRY_BUFF_SPD:
                msgbox(format("La Velocidad de {STR_VAR_1} ha mejorado."))

            case BERRY_BUFF_WEAKEN:
                msgbox(format("{STR_VAR_1} se ha debilitado un poco."))
        }

        msgbox(format("¡Espero que {STR_VAR_1} y tú lo hayáis disfrutado!\p¡Hasta la próxima!"))
        setvar(VAR_RESULT, YES)
    }
    else
    {
        special(BufferMonNickname)
        msgbox(format("Vaya.\p{STR_VAR_1} parece demasiado lleno para comerse esto."))
    }
}

script RogueHub_Bakery_SpeakChefSlice
{
    lock
    faceplayer

    setvar(VAR_0x8004, 0)
    special(BufferMonNickname)

    msgbox(format("¡Bienvenid{MASC}o{FEM}a{ENDG} a la Panadería!\nMi especialidad son las Magdalenas, que mejoran un poco las características de tus Pokémon.\p¿Quieres que hornee una Magdalena para compartirla con {STR_VAR_1}?"), MSGBOX_YESNO)

    if(var(VAR_RESULT) == YES)
    {
        msgbox(format("¿Qué tipo de baya uso?"))

        fadescreen(FADE_TO_BLACK)
        special(Bag_ChooseBerry)
        waitstate

        if(var(VAR_ITEM_ID) == 0)
        {
            setvar(VAR_RESULT, NO)
        }
        else
        {
            showmoneybox(0, 0)

            msgbox(format("Para eso necesitaré 3 bayas.\pY costará ¥500."))

            checkitem(VAR_ITEM_ID, 3)
            if(var(VAR_RESULT) == NO)
            {
                msgbox(format("Vaya.\nParece que no tienes suficientes bayas."))
            }
            else
            {
                checkmoney(500)
                if(var(VAR_RESULT) == NO)
                {
                    msgbox(format("Vaya.\nParece que no tienes suficiente dinero."))
                }
            }

            if(var(VAR_RESULT) == YES)
            {
                msgbox(format("¿Te parece bien que me las quede para empezar a hornear?"), MSGBOX_YESNO)
            }

            if(var(VAR_RESULT) == YES)
            {
                setvar(VAR_BERRY_BUFF_AMOUNT, 1)
                call(RogueHub_Bakery_SpeakChef_ApplyTreat)
                if(var(VAR_RESULT) == YES)
                {
                    removemoney(500)
                    removeitem(VAR_ITEM_ID, 3)
                }
            }

            closemessage
            hidemoneybox
        }
    }
    
    if(var(VAR_RESULT) == NO)
    {
        msgbox(format("Si cambias de idea, puedes volver cuando quieras."))
    }

    release
}

script RogueHub_Bakery_SpeakChefFull
{
    lock
    faceplayer

    setvar(VAR_0x8004, 0)
    special(BufferMonNickname)

    msgbox(format("¡Bienvenid{MASC}o{FEM}a{ENDG} a la Panadería!\nMi especialidad son las Tartas, que mejoran las características de tus Pokémon.\p¿Quieres que hornee una Tarta para compartirla con {STR_VAR_1}?"), MSGBOX_YESNO)

    if(var(VAR_RESULT) == YES)
    {
        msgbox(format("¿Qué tipo de baya uso?"))

        fadescreen(FADE_TO_BLACK)
        special(Bag_ChooseBerry)
        waitstate

        if(var(VAR_ITEM_ID) == 0)
        {
            setvar(VAR_RESULT, NO)
        }
        else
        {
            showmoneybox(0, 0)

            msgbox(format("Para eso necesitaré 15 bayas.\pY costará ¥2500."))

            checkitem(VAR_ITEM_ID, 15)
            if(var(VAR_RESULT) == NO)
            {
                msgbox(format("Vaya.\nParece que no tienes suficientes bayas."))
            }
            else
            {
                checkmoney(2500)
                if(var(VAR_RESULT) == NO)
                {
                    msgbox(format("Vaya.\nParece que no tienes suficiente dinero."))
                }
            }

            if(var(VAR_RESULT) == YES)
            {
                msgbox(format("¿Te parece bien que me las quede para empezar a hornear?"), MSGBOX_YESNO)
            }

            if(var(VAR_RESULT) == YES)
            {
                setvar(VAR_BERRY_BUFF_AMOUNT, 5)
                call(RogueHub_Bakery_SpeakChef_ApplyTreat)
                if(var(VAR_RESULT) == YES)
                {
                    removemoney(2500)
                    removeitem(VAR_ITEM_ID, 15)
                }
            }

            closemessage
            hidemoneybox
        }
    }
    
    if(var(VAR_RESULT) == NO)
    {
        msgbox(format("Si cambias de idea, puedes volver cuando quieras."))
    }

    release
}

script RogueHub_Bakery_SpeakBerryCheck
{
    lock
    faceplayer

    msgbox(format("¿Sabías que, una vez horneadas, cada baya mejora una característica distinta de los Pokémon?"))
    msgbox(format("¿Quieres que te diga qué característica mejora una baya?"), MSGBOX_YESNO)

    if(var(VAR_RESULT) == YES)
    {
        fadescreen(FADE_TO_BLACK)
        special(Bag_ChooseBerry)
        waitstate

        if(var(VAR_ITEM_ID) != 0)
        {
            special(Rogue_CheckBerryTreat)
            bufferitemname(STR_VAR_1, VAR_ITEM_ID)
            switch(var(VAR_RESULT))
            {
                case BERRY_BUFF_FRIEND:
                    msgbox(format("{STR_VAR_1} aumenta el cariño de un Pokémon."))

                case BERRY_BUFF_HP:
                    msgbox(format("{STR_VAR_1} mejora los PS de un Pokémon."))

                case BERRY_BUFF_ATK:
                    msgbox(format("{STR_VAR_1} mejora el Ataque de un Pokémon."))

                case BERRY_BUFF_DEF:
                    msgbox(format("{STR_VAR_1} mejora la Defensa de un Pokémon."))

                case BERRY_BUFF_SPATK:
                    msgbox(format("{STR_VAR_1} mejora el At. Esp. de un Pokémon."))

                case BERRY_BUFF_SPDEF:
                    msgbox(format("{STR_VAR_1} mejora la Def. Esp. de un Pokémon."))

                case BERRY_BUFF_SPD:
                    msgbox(format("{STR_VAR_1} mejora la Velocidad de un Pokémon."))

                case BERRY_BUFF_WEAKEN:
                    msgbox(format("{STR_VAR_1} debilita un poco a un Pokémon."))
            }
        }
    }

    release
}

script RogueHub_Bakery_SpeakIVEVInspector
{
    lock
    faceplayer

    msgbox(format("¿Sabías que puedes ver los IV y EV de un Pokémon pulsando A en la pantalla de datos del Pokémon?\p¡La tecnología moderna es una maravilla!, ¿eh?"))

    release
}

