const VAR_STATUS_PARAM = VAR_0x8000

const VAR_LOCAL_MON_SLOT = VAR_0x800A // keep in sync with RogueMP_WaitTradeSlotResponse
const VAR_REMOTE_MON_SLOT = VAR_0x800B // keep in sync with RogueMP_WaitTradeSlotResponse

script RogueMP_Common_ExtractYesNoAnswer
{
    if(var(VAR_RESULT) == YES)
    {
        if(var(VAR_STATUS_PARAM) != 1)
        {
            setvar(VAR_RESULT, NO)
        }
    }
    return
}

script RogueMP_Common_GrabRemoteMon
{
    copyvar(VAR_0x8004, VAR_REMOTE_MON_SLOT)
    special(Rogue_MultiplayerRequestMon)

    message(format("Esperando al otro jugador…\n… … Botón B: Cancelar"))
    special(Rogue_WaitForRemoteResponse)
    waitstate
    closemessage
}

script Rogue_InteractMultiplayerPlayer
{
    lock

    message(format("Esperando al otro jugador…\n… … Botón B: Cancelar"))
    multiplayerpushstatusawait(MP_PLAYER_STATUS_TALK_TO_PLAYER, TRUE)
    waitstate

    if(var(VAR_RESULT) == YES)
    {
        msgbox(format("{RIVAL}: ¡Hola, soy {RIVAL}!"))
        
        msgbox(format("¿Quieres intercambiar Pokémon?"), MSGBOX_YESNO)
        if(var(VAR_RESULT) == YES)
        {
            message(format("Esperando al otro jugador…\n… … Botón B: Cancelar"))
            multiplayerpushstatusawait(MP_PLAYER_STATUS_BEGIN_TRADE, TRUE)
            waitstate
            
            if(var(VAR_RESULT) == YES)
            {
                msgbox(format("¿Qué Pokémon quieres intercambiar?"))
                special(ChoosePartyMon)
                waitstate

                copyvar(VAR_LOCAL_MON_SLOT, VAR_0x8004)
            
                message(format("Esperando al otro jugador…\n… … Botón B: Cancelar"))
                callnative(RogueMP_WaitTradeSlotResponse)
                waitstate

                if(var(VAR_LOCAL_MON_SLOT) == PARTY_NOTHING_CHOSEN || var(VAR_REMOTE_MON_SLOT) == PARTY_NOTHING_CHOSEN)
                {
                    setvar(VAR_RESULT, NO)
                }
                else
                {
                    call(RogueMP_Common_GrabRemoteMon)

                    special(Rogue_PrepareForTrade)
                    special(DoInGameTradeScene)
                    waitstate

                    setvar(VAR_RESULT, YES)
                }
            }
        }
    }
    
    if(var(VAR_RESULT) == NO)
    {
        msgbox(format("Quizá en otro momento."))
    }

    multiplayerpushstatus(MP_PLAYER_STATUS_NONE)
    release
}

script Rogue_BeginRemoteInteractMultiplayerPlayer
{
    lock

    message(format("{RIVAL}: ¡Hola, hablemos!\n… … Botón B: Cancelar"))
    special(Rogue_WaitForNextPlayerStatusCancellable)
    waitstate

    if(var(VAR_RESULT) == YES)
    {
        // TODO - Support alternative interactions
        msgbox(format("¡Intercambiemos Pokémon!\n¿Qué Pokémon quieres intercambiar?"))
        special(ChoosePartyMon)
        waitstate

        copyvar(VAR_LOCAL_MON_SLOT, VAR_0x8004)

        message(format("Esperando al otro jugador…\n… … Botón B: Cancelar"))
        callnative(RogueMP_WaitTradeSlotResponse)
        waitstate

        if(var(VAR_LOCAL_MON_SLOT) == PARTY_NOTHING_CHOSEN || var(VAR_REMOTE_MON_SLOT) == PARTY_NOTHING_CHOSEN)
        {
            setvar(VAR_RESULT, NO)
        }
        else
        {
            call(RogueMP_Common_GrabRemoteMon)

            special(Rogue_PrepareForTrade)
            special(DoInGameTradeScene)
            waitstate

            setvar(VAR_RESULT, YES)
        }
    }

    if(var(VAR_RESULT) == NO)
    {
        msgbox(format("{RIVAL}: ¡Hasta luego!"))
    }

    multiplayerpushstatus(MP_PLAYER_STATUS_NONE)
    release
}

script Rogue_InteractMultiplayerFollowMon
{
    lock

    special(Rogue_GetFollowMonSpecies)
    playmoncry(VAR_0x800A, CRY_MODE_NORMAL)

    release
}

script RogueMP_OnHostReloadInRun
{
    lock
    call(RogueMP_PerformReconnect)
    release
}

script RogueMP_OnClientReloadInRun
{
    lock
    call(RogueMP_PerformReconnect)
    release
}

script RogueMP_OnClientReloadInHub
{
    lock
    warp(MAP_ROGUE_INTERIOR_POKE_CONNECT, 4)
    release
}

script RogueMP_PerformReconnect
{
    msgbox(format("¿Quieres continuar esta Aventura en Multijugador?"), MSGBOX_YESNO)

    if(var(VAR_RESULT) == FALSE)
    {
        msgbox(format("¿Seguro que quieres continuar esta Aventura en solitario?"), MSGBOX_YESNO)
        if(var(VAR_RESULT) == TRUE)
        {
            setvar(VAR_RESULT, FALSE)
        }
        else
        {
            setvar(VAR_RESULT, TRUE)
        }
    }

    if(var(VAR_RESULT) == YES)
    {
        call(Rogue_Common_WaitForRogueAssistant)

        while(var(VAR_RESULT) == TRUE)
        {
            message(format("Decidid quién de vosotros será el Anfitrión del Grupo.\pLos demás jugadores deben elegir Unirse al Grupo."))
            waitmessage

            multichoice(16, 6, MULTI_LINK_HOST_JOIN, FALSE)

            switch(var(VAR_RESULT))
            {
                case 0: // Join
                    message(format("Configúralo ahora en Rogue Assistant\n… … Botón B: Cancelar"))
                    waitmessage

                    special(Rogue_JoinMultiplayer)
                    waitstate

                    if(var(VAR_RESULT) == TRUE)
                    {
                        msgbox(format("¡Todo listo!\n¡Diviértete en tu Aventura!"))
                    }

                case 1: // Host
                    message(format("Configúralo ahora en Rogue Assistant\n… … Botón B: Cancelar"))
                    waitmessage

                    special(Rogue_HostMultiplayer)
                    waitstate

                    if(var(VAR_RESULT) == TRUE)
                    {
                        msgbox(format("¡Todo listo!\n¡Ya puede unirse un amigo a esta Aventura!"))
                    }

                case 2: // Exit
                    setvar(VAR_RESULT, FALSE)
            }
            
            if(var(VAR_RESULT) == FALSE)
            {
                msgbox(format("¿Seguro que quieres continuar esta Aventura en solitario?"), MSGBOX_YESNO)
                if(var(VAR_RESULT) == TRUE)
                {
                    setvar(VAR_RESULT, FALSE) // stop loop
                }
                else
                {
                    setvar(VAR_RESULT, TRUE) // continue loop
                }
            }
            else
            {
                setvar(VAR_RESULT, FALSE) // stop loop
            }
        }
    }
}