const VAR_ITEM_INDEX = VAR_0x8000
const VAR_ITEM_ID_VAL = VAR_0x8001
const VAR_ITEM_AMOUNT = VAR_0x8002
const VAR_SHOP_DIFFICULTY = VAR_0x8000
const VAR_SHOP_RANDOM_IDX = VAR_TEMP_F

// Re-used scripts
//

script Rogue_GiveItem_Internal
{
    special(Rogue_DetermineItemPickupCount)
    finditem(VAR_ITEM_ID_VAL, VAR_ITEM_AMOUNT)
}

script Rogue_Common_DisplayPopups
{
    waitse
    waitfanfare
    closemessage
    special(Rogue_DisplayPopupsFromScript)
    waitstate
    return
}

script Rogue_Common_DisplaySkippablePopups
{
    waitse
    waitfanfare
    closemessage
    special(Rogue_DisplayPopupsFromScriptSkippable)
    waitstate
    return
}

script Rogue_Common_DisplayNewBadgePopup
{
    delay(10) // pause to let SE catch up
    call(Rogue_Common_DisplaySkippablePopups)
    
    delay(10) // pause to let SE catch up
    special(Popup_NewBadgeGet)
    call(Rogue_Common_DisplayPopups)
    return
}

script Rogue_Common_WaitForRogueAssistant
{
    special(Rogue_IsRogueAssistantConnected)
    if(var(VAR_RESULT) == NO)
    {
        callnative(ScriptMenu_ShowRogueAssistantNotice)

        message(format("Conecta Rogue Assistant… …\n{B_BUTTON} Cancelar"))
        waitmessage

        callnative(Rogue_WaitForRogueAssistant)
        waitstate
        
        callnative(ScriptMenu_HideRogueAssistantNotice)

        call(Rogue_Common_DisplayPopups)
    }

    return
}

script Rogue_QuickSaveRun
{
    lockall

    msgbox(format("{COLOR RED}¡ATENCIÓN!\n{COLOR DARK_GRAY}Los Guardados Rápidos solo se pueden cargar una vez.\pLa próxima vez que se cargue el juego, este Guardado Rápido se borrará."))

    call(Common_EventScript_SaveGame)

    if(var(VAR_RESULT) == YES)
    {
        fadescreen(FADE_TO_BLACK)
        delay(60)
        special(DoSoftReset)
    }

    releaseall
}

script Rogue_QuickSaveLoad
{
    // We can accidentally call this on successful run return
    lockall

    if(var(VAR_0x8004) == TRUE)
    {
        msgbox(format("Se ha recargado la Aventura.\pBorrando el guardado temporal…"))

        call(Common_EventScript_ForceSaveGame)
    }
    else
    {
        msgbox(format("Esta partida ya se ha recargado.\pAbandonando la Aventura…"))
        call(Rogue_ReturnToHub)
    }

    releaseall
}

script Rogue_QuickSaveVersionWarning
{
    lockall

    setvar(VAR_RESULT, YES)
    while(var(VAR_RESULT) == YES)
    {
        msgbox(format("{COLOR RED}¡ATENCIÓN!\n{COLOR DARK_GRAY}¡Lugar de guardado no válido!\pAl actualizar a un parche nuevo, asegúrate de guardar en {POKEMON_HUB}, fuera de una Aventura.\pVuelve al parche anterior y guarda de nuevo en un lugar válido."))
    }

    releaseall
}

script Rogue_QuickSaveVersionUpdateMessage
{
    bufferstring(STR_VAR_1, gText_RogueVersion)
    bufferstring(STR_VAR_2, gText_RogueVersionPrefix)
    bufferstring(STR_VAR_3, gText_RogueVersionSuffix)

    if(flag(FLAG_ROGUE_PRE_RELEASE_COMPAT_WARNING))
    {
        msgbox(format("¡ATENCIÓN!\pEsta partida procede de una versión de prueba del parche.\pNo se recomienda seguir usándola, ya que podrías quedarte sin acceso a contenido nuevo.\pRestaura una copia de seguridad si es posible."))
    }

    msgbox(format("¡Bienvenido a...\nEmerald Rogue {STR_VAR_2}!\p{STR_VAR_1} {STR_VAR_3}\pRecuerda descargarlo siempre de las fuentes oficiales:\pPokeCommunity, Hackdex (publicado por Pokabbie) o Discord\pPara guías, informar de errores y novedades, únete al Discord oficial (en inglés):\phttps://rogue.discord.pokabbie.com"), MSGBOX_DEFAULT)
    msgbox(format("¡Espero que disfrutes de Emerald Rogue!"), MSGBOX_DEFAULT)
}

script Rogue_Debug_SetWeather
{
    lock

    begindynamicmultichoice(24)
    appenddynamicmultichoice("Ninguno", WEATHER_NONE)
    appenddynamicmultichoice("Soleado", WEATHER_SUNNY)
    appenddynamicmultichoice("Sequía", WEATHER_DROUGHT)
    appenddynamicmultichoice("Lluvia", WEATHER_RAIN)
    appenddynamicmultichoice("Tormenta", WEATHER_RAIN_THUNDERSTORM)
    appenddynamicmultichoice("Diluvio", WEATHER_DOWNPOUR)
    appenddynamicmultichoice("Nieve", WEATHER_SNOW)
    appenddynamicmultichoice("Tormenta arena", WEATHER_SANDSTORM)
    appenddynamicmultichoice("Niebla psíquica", WEATHER_PSYCHIC_FOG)
    appenddynamicmultichoice("Niebla", WEATHER_MISTY_FOG)
    appenddynamicmultichoice("Hojas", WEATHER_LEAVES)

    appenddynamicmultichoice("Nubes y sol", WEATHER_SUNNY_CLOUDS)
    appenddynamicmultichoice("Ceniza volcán.", WEATHER_VOLCANIC_ASH)
    appenddynamicmultichoice("Bajo el agua", WEATHER_UNDERWATER)
    appenddynamicmultichoice("Burbujas", WEATHER_UNDERWATER_BUBBLES)
    appenddynamicmultichoice("Sombra", WEATHER_SHADE)

    message(format("¿Qué tiempo?"))
    waitmessage
    enddynamicmultichoice(1, 0, 6, TRUE)

    if(var(VAR_RESULT) != MULTI_B_PRESSED)
    {
        setweather(VAR_RESULT)
        doweather
        setweather(VAR_RESULT)
        if(var(VAR_ROGUE_DESIRED_WEATHER) != WEATHER_NONE)
        {
            setweather(VAR_RESULT)
            doweather
        }
    }

    release
}

script Rogue_Debug_ChangeOutfit
{
    call(Rogue_Interior_Home_ChangeClothes)
}

script Rogue_Debug_RandomTradeTeam
{
    lock
    setvar(VAR_0x8004, 255)
    fadescreen(FADE_TO_BLACK)
    call(Rogue_ScriptHideFollower)
    playfanfare(MUS_MOVE_DELETED)
    special(Rogue_RandomisePartyMon)
    waitfanfare
    fadescreen(FADE_FROM_BLACK)
    call(Rogue_ScriptShowFollower)
    release
}


script Rogue_NewGameVersionUpdate
{
    lockall

    call(Rogue_QuickSaveVersionUpdateMessage)

    releaseall
}

script Rogue_QuickSaveVersionUpdate
{
    lock

    fadescreen(FADE_TO_BLACK)
    call(Rogue_QuickSaveVersionUpdateMessage)
    warp(MAP_ROGUE_AREA_TOWN_SQUARE, 10)

    release
}

script Rogue_ForceNicknameMon
{
    lock
    setvar(VAR_0x8004, 0)
    call(Common_EventScript_NameReceivedPartyMon)
    release
}

script Rogue_AskNicknameMon
{
    lock

    bufferspeciesname(STR_VAR_1, VAR_STARTER_SWAP_SPECIES)
    msgbox(format("¿Quieres ponerle un mote a {STR_VAR_1}?"), MSGBOX_YESNO)

    if(var(VAR_RESULT) == YES)
    {
        setvar(VAR_0x8004, 0)
        call(Common_EventScript_NameReceivedPartyMon)
    }

    release
}

script Rogue_RetireFromRun
{
    lockall
    msgbox(format("¿Seguro que quieres abandonar la Aventura y volver a {POKEMON_HUB}?"), MSGBOX_YESNO)

    if(var(VAR_RESULT) == YES)
    {
        call(Rogue_ReturnToHub)
    }

    releaseall
}

script Rogue_ReturnToHub
{
    warprespawn
    waitstate
    return
}

script Rogue_InteractWithQuestBoard
{
    lockall

    if(var(VAR_ROGUE_INTRO_STATE) <= ROGUE_INTRO_STATE_COLLECT_QUEST_LOG)
    {
        msgbox(format("¡Es un tablón lleno de todo tipo de encargos!"))
    }
    else
    {
        specialvar(VAR_RESULT, GetPlayerFacingDirection)
        if(var(VAR_RESULT) == DIR_NORTH)
        {
            call(Rogue_InteractWithQuestBoardInternal)
        }
        else
        {
            msgbox(format("¡Es el Tablón de Misiones!\pLástima que desde este lado no se lean los anuncios…"))
        }
    }

    releaseall
}

script Rogue_InteractWithQuestBoardInternal
{
    special(Rogue_HasPendingQuestRewards)

    if(var(VAR_RESULT) == 1)
    {
        msgbox(format("¡Hay recompensas de Misiones por recoger!"))

        //fadeoutbgm(1)
        //delay(1)

        setvar(VAR_0x8004, 0)
        setvar(VAR_RESULT, 1)

        while(var(VAR_RESULT) == 1)
        {
            special(Rogue_QuestCollectNextReward)

            switch(var(VAR_RESULT))
            {
                //case 0:
                //    msgbox(format("finished."))

                case 1:
                    setvar(VAR_0x8004, 1) // flag that we've collected some results

                case 2:
                    msgbox(format("No se pueden recoger las recompensas restantes."))
            }
        }

        call(Rogue_Common_DisplaySkippablePopups)

        //fadeinbgm(1)
        //delay(1)

        waitfanfare
        waitse

        special(Rogue_HasAnyNewQuests)
        if(var(VAR_RESULT) == 1)
        {
            msgbox(format("¡Se han publicado nuevas Misiones!"))
            special(Rogue_ShowNewQuests)
            waitstate
        }
        elif (var(VAR_0x8004) == 1)
        {
            msgbox(format("¡Has recogido todas las recompensas!"))
        }
        else
        {
            msgbox(format("No hay Misiones nuevas ni recompensas por recoger."))
        }
    }
    else
    {
        msgbox(format("No hay Misiones nuevas ni recompensas por recoger."))
    }
}

script Rogue_InteractWithPC
{
    if(flag(FLAG_SYS_POKEMON_GET))
    {
        specialvar(VAR_RESULT, GetPlayerFacingDirection)
        if(var(VAR_RESULT) == DIR_NORTH)
        {
            goto(EventScript_PC)
        }
        else
        {
            lock
            msgbox(format("¡Es un PC!\pLástima que desde este lado no se vea la pantalla…"))
            release
        }
    }
    else
    {
        lock
        msgbox(format("¡Es un PC!\pMejor no tocarlo por ahora…"))
        release
    }
}

script Rogue_EventScript_ItemUseHealingFlask
{
    lock

    if(flag(FLAG_ROGUE_RUN_ACTIVE))
    {
        copyvar(VAR_0x8004, VAR_ROGUE_FLASK_HEALS_MAX)
        subvar(VAR_0x8004, VAR_ROGUE_FLASK_HEALS_USED)

        buffernumberstring(STR_VAR_1, VAR_0x8004)

        if(var(VAR_ROGUE_FLASK_HEALS_USED) < VAR_ROGUE_FLASK_HEALS_MAX)
        {
            msgbox("Al frasco le quedan {STR_VAR_1} usos.\n¿Quieres curar a tu equipo?", MSGBOX_YESNO)

            if(var(VAR_RESULT) == YES)
            {
                //playse(SE_SHOP)
                //special(HealPlayerParty)
                addvar(VAR_ROGUE_FLASK_HEALS_USED, 1)
                call(Common_EventScript_OutOfCenterPartyHeal)
                
                copyvar(VAR_0x8004, VAR_ROGUE_FLASK_HEALS_MAX)
                subvar(VAR_0x8004, VAR_ROGUE_FLASK_HEALS_USED)

                buffernumberstring(STR_VAR_1, VAR_0x8004)
                msgbox("Al frasco le quedan {STR_VAR_1} usos.", MSGBOX_DEFAULT)
            }
        }
        else
        {
            msgbox("Al frasco le quedan {STR_VAR_1} usos.", MSGBOX_DEFAULT)
        }
    }
    else
    {
        buffernumberstring(STR_VAR_1, VAR_ROGUE_FLASK_HEALS_MAX)
        msgbox("Usos totales del frasco: {STR_VAR_1}.", MSGBOX_DEFAULT)
    }

    release
}

script Rogue_EventScript_ScatterPokeblockItem
{
    bufferitemname(STR_VAR_1, VAR_ITEM_ID)
    copyvar(VAR_ROGUE_ACTIVE_POKEBLOCK, VAR_ITEM_ID)

    special(Rogue_IsNearHoneyTree)

    if(var(VAR_RESULT) == YES)
    {
        special(Rogue_TryScatterPokeblockNearHoneyTree)

        if(var(VAR_RESULT) == 2)
        {
                msgbox(format("Ya se había esparcido {STR_VAR_1} en el Árbol de Miel…"))
        }
        elif(var(VAR_RESULT) == 1)
        {
            //while(var(VAR_RESULT) == YES)
            //{
                removeitem(VAR_ITEM_ID)
                playse(SE_REPEL)
                waitse

                msgbox(format("Se ha esparcido {STR_VAR_1} en el Árbol de Miel…"))

                //checkitem(VAR_ROGUE_ACTIVE_POKEBLOCK)
                //if(var(VAR_RESULT) == YES)
                //{
                //    msgbox(format("¿Quieres esparcir otra?"), MSGBOX_YESNO)
                //    if(var(VAR_RESULT) == YES)
                //    {
                //        removeitem(VAR_ROGUE_ACTIVE_POKEBLOCK)
                //        special(Rogue_TryScatterPokeblockNearHoneyTree)
                //    }
                //}
            //}
        }
        else
        {
            msgbox(format("No se puede esparcir {STR_VAR_1} en el Árbol de Miel…"))
        }
    }
    else
    {
        removeitem(VAR_ITEM_ID)

        playse(SE_REPEL)
        special(Rogue_ScatterPokeblockItem)
        waitse

        if(var(VAR_RESULT) == YES)
        {
            msgbox(format("Se ha esparcido {STR_VAR_1}…\p¡A los Pokémon parece que les gusta!"))
        }
        else
        {
            msgbox(format("Se ha esparcido {STR_VAR_1}…\pA los Pokémon no parece interesarles…"))
        }
    }
}

script Rogue_EventScript_UsePokeblockItem
{
    lock
    call(Rogue_EventScript_ScatterPokeblockItem)
    release
}

script Rogue_EventScript_UseDayCarePhoneItem
{
    lock

    if(!flag(FLAG_ROGUE_RUN_ACTIVE))
    {
        // Can call unlimited times in hub
        setvar(VAR_ROGUE_DAYCARE_PHONE_REMAINING_CHARGES, 1)
    }

    if(var(VAR_ROGUE_DAYCARE_PHONE_REMAINING_CHARGES) > 0)
    {
        playse(SE_POKENAV_CALL)
        message(format("{PAUSE 20}… {PAUSE 20}… {PAUSE 20}… {PAUSE 20}"))
        waitse
        waitmessage
        closemessage

        callnative(Rogue_OnDayCareChargeUsed)
        call(Rogue_Common_DisplaySkippablePopups)
        

        if(!flag(FLAG_ROGUE_RUN_ACTIVE))
        {
            msgbox(format("¿{PLAYER}? ¿Eres tú?\p¡Qué buena cobertura hay en {POKEMON_HUB}!\pQuieres cambiar a uno de tus Pokémon, ¿verdad?"))
            setvar(VAR_RESULT, TRUE)
        }
        else
        {
            msgbox(format("¿{PLAYER}? ¿Eres tú?\pQuieres cambiar a uno de tus Pokémon, ¿verdad?"))

            specialvar(VAR_RESULT, Rogue_IsCatchingContestActive)
            if(var(VAR_RESULT) == TRUE)
            {
                msgbox(format("¿Cómo dices?\p¿Estás en un concurso de captura y quieres guardar un Pokémon que acabas de atrapar sin haber terminado el concurso?\p¡Eso no me parece muy honrado!\p¡No puedo ayudarte a hacer trampas!\nLlámame cuando termines el concurso y te cambiaré el Pokémon encantada."))
                setvar(VAR_RESULT, FALSE)
            }
            else
            {
                setvar(VAR_RESULT, TRUE)
            }
        }

        if(var(VAR_RESULT) == TRUE)
        {
            message(format("¿Qué hueco de {PKMN} te interesa?"))
            waitmessage

            multichoice(1, 1, MULTI_ROGUE_DAYCARE, NO)

            switch(var(VAR_RESULT))
            {
                case MULTI_B_PRESSED:
                    setvar(VAR_RESULT, NO)

                default:
                    copyvar(VAR_0x8005, VAR_RESULT)
                    call(Rogue_EventScript_UseDayCarePhoneItem_TrySwapMon)
            }
        }

        playse(SE_POKENAV_HANG_UP)
        waitse
    }
    else
    {
        msgbox(format("El Pokégear no tiene batería.\pSe recargará cuando cures a tu equipo con una Enfermera."))
    }

    release
}

script Rogue_EventScript_UseDayCarePhoneItem_TrySwapMon
{
    special(Rogue_IsDaycareSlotEmpty)
    if(var(VAR_RESULT) == YES)
    {
        specialvar(VAR_0x8008, CalculatePlayerPartyCount)

        if(var(VAR_0x8008) == 1)
        {
            msgbox(format("Me temo que ahora mismo no puedes dejar más Pokémon en la Guardería.\p¡Si lo hicieras, te quedarías sin Pokémon en el equipo!"), MSGBOX_DEFAULT)
        }
        else
        {
            msgbox(format("¿Qué Pokémon quieres dejarnos?"), MSGBOX_DEFAULT)
            fadescreen(FADE_TO_BLACK)
            special(ChooseSendDaycareMon)
            waitstate

            if(var(VAR_0x8004) != PARTY_NOTHING_CHOSEN)
            {
                if(var(VAR_0x8004) == 0)
                {
                    call(Rogue_ScriptHideFollower)
                }

                subvar(VAR_ROGUE_DAYCARE_PHONE_REMAINING_CHARGES, 1)
                setvar(VAR_0x8006, 0)
                special(Rogue_SwapDaycareMon)

                if(var(VAR_0x8004) == 0)
                {
                    call(Rogue_ScriptShowFollower)
                }
                msgbox(format("¡Lo cuidaremos muy bien!\pHasta ahora."), MSGBOX_DEFAULT)

                fadescreen(FADE_TO_BLACK)
                playse(SE_WARP_OUT)
                waitse

                closemessage
                fadescreen(FADE_FROM_BLACK)
            }
        }
    }
    else
    {
        specialvar(VAR_TEMP_0, CalculatePlayerPartyCount)
        specialvar(VAR_TEMP_1, Rogue_CalcMaxPartySize)
        
        if(var(VAR_TEMP_0) >= VAR_TEMP_1)
        {
            msgbox(format("¿Quieres recoger a tu Pokémon?\p¡Parece que tu equipo está completo!\pTendrás que dejarme a un miembro de tu equipo para poder recoger a otro Pokémon."))
            fadescreen(FADE_TO_BLACK)
            special(ChooseSendDaycareMon)
            waitstate

            if(var(VAR_0x8004) != PARTY_NOTHING_CHOSEN)
            {
                if(var(VAR_0x8004) == 0)
                {
                    call(Rogue_ScriptHideFollower)
                }

                subvar(VAR_ROGUE_DAYCARE_PHONE_REMAINING_CHARGES, 1)
                setvar(VAR_0x8006, 0)
                special(Rogue_SwapDaycareMon)

                if(var(VAR_0x8004) == 0)
                {
                    call(Rogue_ScriptShowFollower)
                }
                msgbox(format("¡Lo cuidaremos muy bien!\pHasta ahora."), MSGBOX_DEFAULT)

                fadescreen(FADE_TO_BLACK)
                playse(SE_WARP_OUT)
                waitse

                closemessage
                fadescreen(FADE_FROM_BLACK)
            }
        }
        else
        {
            msgbox(format("¿Quieres recoger a tu Pokémon?"), MSGBOX_YESNO)

            if(var(VAR_RESULT) == YES)
            {
                subvar(VAR_ROGUE_DAYCARE_PHONE_REMAINING_CHARGES, 1)
                setvar(VAR_0x8004, 5)
                setvar(VAR_0x8006, 0)
                special(Rogue_SwapDaycareMon)
                msgbox(format("Hasta ahora."), MSGBOX_DEFAULT)

                fadescreen(FADE_TO_BLACK)
                playse(SE_WARP_OUT)
                waitse

                closemessage
                fadescreen(FADE_FROM_BLACK)
            }
        }
    }
}

