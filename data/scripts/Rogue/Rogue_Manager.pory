script Rogue_Tutor_EggMoveLearn
{
    lock
    faceplayer
    msgbox(format("Tutor de movimientos huevo obsoleto"), MSGBOX_DEFAULT)
    release
}

script Rogue_Tutor_TutorMoveLearn
{
    special(TeachMoveSetContextTutorMove)
    lock
    faceplayer
    msgbox(format("¡JIAH!\p¡Soy un Tutor de Movimientos!\p¡Puedo enseñar a los Pokémon movimientos brutales!\pBueno, ¿qué quieres que enseñe?"), MSGBOX_DEFAULT)

    setvar(VAR_0x8004, 0)
    special(TeachMoveFromContext)
    waitstate

    release
}

script Rogue_Tutor_MoveDelete
{
    lock
    faceplayer
    msgbox(format("Eh...\nAh, sí, soy el Quitamovimientos.\pPuedo hacer que los Pokémon olviden movimientos, ¿quieres?"), MSGBOX_YESNO)

    if(var(VAR_RESULT) == NO)
    {
        goto(Rogue_Tutor_MoveDeleteCancel)
    }

    special(ChoosePartyMon)
    waitstate
    if(var(VAR_0x8004) == PARTY_NOTHING_CHOSEN)
    {
        goto(Rogue_Tutor_MoveDeleteCancel)
    }

    special(IsSelectedMonEgg)
    if(var(VAR_RESULT) == TRUE)
    {
        goto(Rogue_Tutor_MoveDeleteEgg)
    }

    special(GetNumMovesSelectedMonHas)
    if(var(VAR_RESULT) <= 1)
    {
        goto(Rogue_Tutor_MoveDeleteNoMoves)
    }

    fadescreen(FADE_TO_BLACK)
    special(MoveDeleterChooseMoveToForget)
    fadescreen(FADE_FROM_BLACK)

    if(var(VAR_0x8005) == MAX_MON_MOVES)
    {
        goto(Rogue_Tutor_MoveDeleteCancel)
    }

    special(MoveDeleterForgetMove)
    playfanfare(MUS_MOVE_DELETED)
    waitfanfare

    release
}

script Rogue_SpeakDaycareLady
{
    lock
    faceplayer
    msgbox(format("¡Hola, cielo!\nSoy la señora de la Guardería.\pSi quieres, puedo cuidarte algún Pokémon."), MSGBOX_DEFAULT)

    message(format("¿Qué hueco de {PKMN} te interesa?"))
    waitmessage

    multichoice(1, 1, MULTI_ROGUE_DAYCARE, NO)

    switch(var(VAR_RESULT))
    {
        case MULTI_B_PRESSED:
            setvar(VAR_RESULT, NO)

        default:
            copyvar(VAR_0x8005, VAR_RESULT)
            call(Rogue_SpeakDaycareLady_TrySwapMon)
    }

    release
}

script Rogue_SpeakDaycareLady_TrySwapMon
{
    special(Rogue_IsDaycareSlotEmpty)
    if(var(VAR_RESULT) == YES)
    {
        setvar(VAR_RESULT, NO)
        specialvar(VAR_0x8008, CalculatePlayerPartyCount)

        if(var(VAR_0x8008) == 1)
        {
            msgbox(format("Me temo que ahora mismo no puedes dejarme más Pokémon.\p¡Si lo hicieras, te quedarías sin Pokémon en el equipo!"), MSGBOX_DEFAULT)
        }
        else
        {
            msgbox(format("¿Qué Pokémon quieres dejarme?"), MSGBOX_DEFAULT)
            fadescreen(FADE_TO_BLACK)
            special(ChooseSendDaycareMon)
            waitstate

            if(var(VAR_0x8004) != PARTY_NOTHING_CHOSEN)
            {
                if(var(VAR_0x8004) == 0)
                {
                    call(Rogue_ScriptHideFollower)
                }

                setvar(VAR_0x8006, 1)
                special(Rogue_SwapDaycareMon)

                if(var(VAR_0x8004) == 0)
                {
                    call(Rogue_ScriptShowFollower)
                }
                msgbox(format("¡Lo cuidaré muy bien!\p¡Cuídate!"), MSGBOX_DEFAULT)
                setvar(VAR_RESULT, YES)
            }
        }
    }
    else
    {
        setvar(VAR_RESULT, NO)

        specialvar(VAR_0x8008, CalculatePlayerPartyCount)
        specialvar(VAR_0x8009, Rogue_CalcMaxPartySize)
        
        if(var(VAR_0x8008) >= VAR_0x8009)
        {
            msgbox(format("¿Quieres recoger a tu Pokémon?\p¡Parece que tu equipo está completo!\pTendrás que dejarme a un miembro de tu equipo para poder recoger a otro Pokémon."))
            fadescreen(FADE_TO_BLACK)
            special(ChooseSendDaycareMon)
            waitstate

            if(var(VAR_0x8004) != PARTY_NOTHING_CHOSEN)
            {
                if(var(VAR_0x8004) == 0)
                {
                    call(Rogue_ScriptHideFollower)
                }

                setvar(VAR_0x8006, 1)
                special(Rogue_SwapDaycareMon)

                if(var(VAR_0x8004) == 0)
                {
                    call(Rogue_ScriptShowFollower)
                }
                msgbox(format("¡Lo cuidaré muy bien!\p¡Cuídate!"), MSGBOX_DEFAULT)
                setvar(VAR_RESULT, YES)
            }
        }
        else
        {
            msgbox(format("¿Quieres recoger a tu Pokémon?"), MSGBOX_YESNO)

            if(var(VAR_RESULT) == YES)
            {
                setvar(VAR_0x8004, 5)
                setvar(VAR_0x8006, 1)
                special(Rogue_SwapDaycareMon)
                msgbox(format("¡Aquí lo tienes!\p¡Cuídate!"), MSGBOX_DEFAULT)
            }
        }
    }
}

